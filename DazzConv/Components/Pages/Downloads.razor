                // НОВОЕ: Файлы ImageMagick
                foreach (var file in Directory.GetFiles(tempPath, "magick-*", SearchOption.TopDirectoryOnly))
                {
                    try { totalSize += new FileInfo(file).Length; } catch { }
                }
            }

            // DazzConv_Preview
            var previewFolder = Path.Combine(Path.GetTempPath(), "DazzConv_Preview");
            if (Directory.Exists(previewFolder))
            {
                foreach (var file in Directory.GetFiles(previewFolder))
                {
                    try { totalSize += new FileInfo(file).Length; } catch { }
