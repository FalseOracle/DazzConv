        {
            StateHasChanged();
        }
        catch { }
    }

    // ===== ИСПРАВЛЕННАЯ ОТМЕНА — моментальная =====
    private async Task CancelDownload()
    {
        if (!IsDownloading || IsCancelling) return;

        try
        {
            IsCancelling = true;
            StateHasChanged();

            // 1. Отправляем сигнал отмены в CancellationToken
            Cts?.Cancel();

            // 2. Принудительно убиваем процесс yt-dlp
            Downloader.CancelDownload();

            await ShowToast("⚠️ Отмена загрузки...", ToastType.Warning);

            // Даём процессу 2 секунды на завершение
            await Task.Delay(2000);

            // 3. Если всё ещё "висит" — принудительно сбрасываем состояние
            if (IsDownloading)
            {
                IsDownloading = false;
                IsCancelling = false;
                Cts?.Dispose();
                Cts = null;
                StateHasChanged();
                await ShowToast("⚠️ Загрузка принудительно остановлена", ToastType.Warning);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError("Ошибка отмены загрузки", ex);
            IsDownloading = false;
            IsCancelling = false;
            StateHasChanged();
        }
    }

