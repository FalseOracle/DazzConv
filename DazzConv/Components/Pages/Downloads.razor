                foreach (var ext in tempExtensions)
                {
                    foreach (var file in Directory.GetFiles(tempPath, "*" + ext, SearchOption.TopDirectoryOnly))
                    {
                        try { totalSize += new FileInfo(file).Length; } catch { }
