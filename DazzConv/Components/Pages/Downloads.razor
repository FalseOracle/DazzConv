    private string TruncateUrl(string url, int maxLength)
    {
        if (string.IsNullOrEmpty(url)) return "";
        if (url.Length <= maxLength) return url;
        return url.Substring(0, maxLength - 3) + "...";
    }

    private bool IsUrlBlocked(string url, out string reason)
    {
        reason = "";
        if (string.IsNullOrWhiteSpace(url)) return false;

        try
        {
            var uri = new Uri(url.StartsWith("http") ? url : "https://" + url);
            var host = uri.Host.ToLowerInvariant();

            if (host.StartsWith("www."))
                host = host.Substring(4);

            foreach (var blocked in BlockedSites)
            {
                var blockedDomain = blocked.Key.ToLowerInvariant();

                if (host == blockedDomain || host.EndsWith("." + blockedDomain))
                {
                    reason = blocked.Value;
                    Logger.LogWarning($"Downloads: заблокирован домен {host} - {reason}");
                    return true;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning($"Downloads: ошибка парсинга URL '{url}': {ex.Message}");
        }

        return false;
    }

    private void OpenFile(string filePath)
    {
        Logger.LogInfo($"========== НАЧАЛО OpenFile ==========");
        Logger.LogInfo($"Получен путь: [{filePath}]");

        if (string.IsNullOrEmpty(filePath))
        {
            _ = ShowToast("⚠️ Путь к файлу пустой", ToastType.Warning);
            return;
        }

        bool fileExists = File.Exists(filePath);
        Logger.LogInfo($"File.Exists = {fileExists}");

        if (!fileExists)
        {
            Logger.LogWarning($"Файл НЕ существует: {filePath}");
            var dir = Path.GetDirectoryName(filePath);
            if (!string.IsNullOrEmpty(dir) && Directory.Exists(dir))
            {
                try
                {
                    System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                    {
                        FileName = dir,
                        UseShellExecute = true
                    });
                    _ = ShowToast("⚠️ Файл не найден, открыта папка", ToastType.Warning);
                }
                catch (Exception ex)
                {
                    _ = ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
                }
            }
            else
            {
                _ = ShowToast("⚠️ Файл и папка не найдены", ToastType.Warning);
            }
            return;
        }

        try
        {
            var normalizedPath = Path.GetFullPath(filePath).Replace('/', '\\');
            var arguments = "/select,\"" + normalizedPath + "\"";

            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = arguments,
                UseShellExecute = true
            };

            System.Diagnostics.Process.Start(psi);
            Logger.LogInfo($"Команда выполнена");
        }
        catch (Exception ex)
        {
            Logger.LogError($"Ошибка открытия папки: {ex.Message}");
            _ = ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
    }

    // ───────── кэш ─────────
    // Раньше список папок/масок дублировался в ClearCache и UpdateCacheSizeAsync (~150 строк),
    // а системный %TEMP% чистился по *.part/*.temp — это могло удалять чужие файлы.
    private static readonly string[] DownloadTempPatterns = { "*.part", "*.ytdl", "*.part.tmp", "*.temp", "*.fvideo*", "*.faudio*" };

    private static string[] SafeGetFiles(string folder, string pattern)
    {
        try { return Directory.Exists(folder) ? Directory.GetFiles(folder, pattern, SearchOption.TopDirectoryOnly) : Array.Empty<string>(); }
        catch { return Array.Empty<string>(); }
    }

    private List<string> CollectCacheFiles()
    {
        var files = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var temp = Path.GetTempPath();

        if (!string.IsNullOrEmpty(DownloadPath))
            foreach (var pattern in DownloadTempPatterns)
                foreach (var f in SafeGetFiles(DownloadPath, pattern)) files.Add(f);

        var hourAgo = DateTime.Now.AddHours(-1);
        foreach (var f in SafeGetFiles(temp, "magick-*"))
        {
            try { if (File.GetLastWriteTime(f) < hourAgo) files.Add(f); } catch { }
        }

        foreach (var sub in new[] { "DazzConv_Preview", "DazzConv_Batch" })
            foreach (var f in SafeGetFiles(Path.Combine(temp, sub), "*")) files.Add(f);

        return files.ToList();
    }

    private async Task ClearCache()
    {
        if (IsDownloading)
        {
            await ShowToast("⚠️ Дождитесь окончания загрузки — иначе удалятся её временные файлы", ToastType.Warning);
            return;
        }

        try
        {
            var (count, size) = await Task.Run(() =>
            {
                int c = 0; long sz = 0;
                foreach (var file in CollectCacheFiles())
                {
                    try
                    {
                        var fi = new FileInfo(file);
                        var len = fi.Length;
                        fi.Delete();
                        sz += len; c++;
                    }
                    catch { }
                }
                return (c, sz);
            });

            await UpdateCacheSizeAsync();

            if (count > 0)
            {
                Logger.LogInfo($"Кэш: удалено {count} файлов, освобождено {FormatFileSize(size)}");
                await ShowToast($"✅ Удалено {count} временных файлов\nОсвобождено: {FormatFileSize(size)}", ToastType.Success);
            }
            else
            {
                await ShowToast("ℹ️ Временных файлов не найдено", ToastType.Info);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError("Кэш: ошибка очистки", ex);
            await ShowToast($"❌ Ошибка очистки кэша: {ex.Message}", ToastType.Error);
        }
    }

    private async Task UpdateCacheSizeAsync()
    {
        try
        {
            // Файловые операции — вне UI-потока
            var total = await Task.Run(() => CollectCacheFiles().Sum(f =>
            {
                try { return new FileInfo(f).Length; } catch { return 0L; }
            }));
            CacheSize = FormatFileSize(total);
        }
        catch
        {
            CacheSize = "0 Б";
        }
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }

    private async Task OnProxyAddressChanged() => await SaveProxySettingsAsync();

    private async Task LoadProxySettingsAsync()
    {
        var settingsPath = GetProxySettingsPath();
        ProxySettings? settings = null;

        try
        {
            if (File.Exists(settingsPath))
            {
                var json = await File.ReadAllTextAsync(settingsPath);
                settings = System.Text.Json.JsonSerializer.Deserialize<ProxySettings>(json);
                Logger.LogInfo($"[Proxy] Загружено из файла: UseProxy={settings?.UseProxy}, Address={settings?.ProxyAddress}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogInfo($"[Proxy] Ошибка чтения файла: {ex.Message}");
        }

        if (settings == null)
        {
            try
            {
                var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "dazzconv_proxy_settings");
                if (!string.IsNullOrEmpty(json))
                {
                    settings = System.Text.Json.JsonSerializer.Deserialize<ProxySettings>(json);
                    Logger.LogInfo($"[Proxy] Загружено из localStorage: UseProxy={settings?.UseProxy}, Address={settings?.ProxyAddress}");
                }
            }
            catch (Exception ex)
            {
                Logger.LogInfo($"[Proxy] Ошибка чтения localStorage: {ex.Message}");
            }
        }

        if (settings != null)
        {
            UseProxy = settings.UseProxy;
            ProxyAddress = settings.ProxyAddress ?? "127.0.0.1:1080";
        }
    }


    private class ProxySettings
    {
        public bool UseProxy { get; set; }
        public string? ProxyAddress { get; set; }
    }

    private string GetProxySettingsPath()
    {
        var appDataPath = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData),
            "DazzConv");
        if (!Directory.Exists(appDataPath))
            Directory.CreateDirectory(appDataPath);
        return Path.Combine(appDataPath, "proxy_settings.json");
    }

    private async Task SaveProxySettingsAsync()
    {
        var settings = new ProxySettings { UseProxy = UseProxy, ProxyAddress = ProxyAddress };
        var json = System.Text.Json.JsonSerializer.Serialize(settings);

        // 1. Сохраняем в файл (надёжно)
        try
        {
            var settingsPath = GetProxySettingsPath();
            await File.WriteAllTextAsync(settingsPath, json);
            Logger.LogInfo($"[Proxy] Сохранено в файл: {settingsPath}");
        }
        catch (Exception ex)
        {
            Logger.LogInfo($"[Proxy] Ошибка записи в файл: {ex.Message}");
        }

        // 2. Дублируем в localStorage (для совместимости)
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "dazzconv_proxy_settings", json);
            Logger.LogInfo("[Proxy] Сохранено в localStorage");
        }
        catch (Exception ex)
        {
            Logger.LogInfo($"[Proxy] Ошибка записи в localStorage: {ex.Message}");
        }

        // 3. Сразу применяем прокси к загрузчику
        ApplyProxy();
    }


    private async Task TestProxyConnection()
    {
        if (string.IsNullOrWhiteSpace(ProxyAddress))
        {
            await ShowToast("⚠️ Введите адрес прокси", ToastType.Warning);
            return;
        }

        try
