            IsTestingProxy = false;
            StateHasChanged();
        }
    }

    private string FormatProxyUrl(string address)
    {
        if (string.IsNullOrWhiteSpace(address)) return "";

        address = address.Trim();

        if (address.StartsWith("http://") ||
            address.StartsWith("https://") ||
            address.StartsWith("socks5://") ||
            address.StartsWith("socks4://") ||
            address.StartsWith("socks5h://"))
        {
            return address;
        }

        var parts = address.Split(':');

        if (parts.Length == 2)
        {
            var host = parts[0];
            var port = parts[1];

            if (port == "1080" || port == "9050" || port == "9150")
            {
                return $"socks5://{host}:{port}";
            }
            else if (port == "8080" || port == "3128" || port == "8888" || port == "80")
            {
                return $"http://{host}:{port}";
            }
            else if (port == "443")
            {
                return $"https://{host}:{port}";
            }
            else
            {
                return $"socks5://{host}:{port}";
            }
        }

        if (address.Contains(".") || address == "localhost")
        {
            return $"socks5://{address}:1080";
        }

        return $"socks5://{address}:1080";
    }

