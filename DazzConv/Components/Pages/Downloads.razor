<!-- ✅ ИСТОРИЯ ЗАГРУЗОК -->
@{ var historyItems = GetSortedHistory(); }
<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">📋 История загрузок (@historyItems.Count)</h5>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-warning" @onclick="ClearCache" title="Удалить временные файлы yt-dlp">
                <i class="bi bi-trash3"></i> Очистить кэш (@CacheSize)
            </button>
            <button class="btn btn-sm btn-outline-danger" @onclick="ClearHistory">
                <i class="bi bi-trash"></i> Очистить историю
            </button>
        </div>
    </div>
    <div class="card-body">
        @if (historyItems.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th style="width: 35%;">Название</th>
                            <th style="width: 20%;">Статус</th>
                            <th style="width: 12%;">Прогресс</th>
                            <th style="width: 8%;">Размер</th>
                            <th style="width: 25%;" class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in historyItems)
                        {
                            <tr>
                                <td>
                                    <div class="file-name-cell">
                                        <strong title="@item.Title">@item.Title</strong>
                                        <small class="text-muted" title="@item.Url">
                                            @TruncateUrl(item.Url, 50)
                                        </small>
                                    </div>
                                </td>
                                <td>
                                    <div class="status-cell" title="@item.Status">
                                        @if (item.Progress >= 100 && string.IsNullOrEmpty(item.FilePath))
                                        {
                                            <span class="badge bg-warning text-dark" title="Файл не найден">
                                                ⚠️ Не найден
                                            </span>
                                        }
                                        else if (item.Progress >= 100)
                                        {
                                            <span class="badge bg-success">✓ Готово</span>
                                        }
                                        else if (item.Progress > 0)
                                        {
                                            <span class="badge bg-warning text-dark">⏳ В процессе</span>
                                        }
                                        else if (item.Status.Contains("❌") || item.Status.Contains("ERROR"))
                                        {
                                            <span class="badge bg-danger" title="@item.Status">
                                                ❌ Ошибка
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@TruncateText(item.Status, 30)</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (item.Progress > 0 && item.Progress < 100)
                                    {
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                                 role="progressbar"
                                                 style="width: @item.Progress%">
                                                @item.Progress%
                                            </div>
                                        </div>
                                    }
                                    else if (item.Progress >= 100)
                                    {
                                        <span class="text-success">✓ 100%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@FormatFileSize(item.FileSize)</td>
                                <td class="actions-cell">
                                    <div class="btn-group" role="group">
                                        @if (!string.IsNullOrEmpty(item.FilePath))
                                        {
                                            var pathExists = FileExistsCached(item.FilePath);
                                            <button class="btn btn-sm @(pathExists ? "btn-outline-success" : "btn-outline-warning")"
                                                    @onclick="() => OpenFile(item.FilePath)"
                                                    title="@(pathExists ? "Открыть папку с выделенным файлом" : "Открыть папку (файл не найден)")">
                                                <i class="bi bi-folder2-open"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => OpenFile(DownloadPath)"
                                                    title="Открыть папку загрузок">
                                                <i class="bi bi-folder2-open"></i>
                                            </button>
                                        }

                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => OpenRenameModal(item)"
                                                disabled="@(!FileExistsCached(item.FilePath))"
                                                title="Переименовать файл">
                                            <i class="bi bi-pencil"></i>
                                        </button>

                                        <button class="btn btn-sm btn-outline-info"
                                                @onclick="() => ShowConsoleLog(item)"
                                                title="Открыть консоль (лог yt-dlp)">
                                            <i class="bi bi-terminal"></i>
                                        </button>

                                        <button class="btn btn-sm btn-outline-info"
                                                @onclick="() => ShowStatusDetails(item)"
                                                title="Показать детали">
                                            <i class="bi bi-info-circle"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => RemoveFromHistory(item)"
                                                title="Удалить из истории">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted text-center py-4">История пуста</p>
        }
    </div>
</div>

@code {
    private YtDlpToolsService Tools => YtDlpToolsService.Instance;

    private string UrlInput = "";
    private string DownloadPath = "";
    private string DownloadType = "video";
    private string VideoQuality = "best";
    private string SelectedFormatId = "";
    private string AudioFormat = "mp3";
    private int AudioBitrate = 320;
    private string DownloadProgressText = "";
    private bool IsPlaylist = false;
    private bool IsDownloading = false;
    private bool IsCancelling = false;
    private string VideoContainer = "mkv";
    private bool IsLoadingFormats = false;
    private List<VideoFormat> AvailableFormats = new();
    private DownloadItem? CurrentDownload;
    private CancellationTokenSource? Cts;
    private string CacheSize = "0 Б";
    private string _blockedSiteWarning = "";
    private bool _showDetailsModal = false;
    private DownloadItem? _selectedItem = null;
    private bool _showConsoleModal = false;
    private DownloadItem? _consoleLogItem = null;

    private string CustomFileName = "";
    private bool _disposed;
    private static readonly Regex ProgressRegex = new(@"\[download\]\s+(\d+(?:\.\d+)?)%", RegexOptions.Compiled);

    public void Dispose() => _disposed = true;

    // ───────── кэш File.Exists: раньше вызывался для каждой строки истории на каждый рендер ─────────
    private readonly Dictionary<string, (bool Exists, DateTime At)> _existsCache = new();

    private bool FileExistsCached(string? path)
    {
        if (string.IsNullOrEmpty(path)) return false;
        var now = DateTime.UtcNow;
        if (_existsCache.TryGetValue(path, out var e) && (now - e.At).TotalSeconds < 10)
            return e.Exists;
        var exists = File.Exists(path);
        _existsCache[path] = (exists, now);
        return exists;
    }

    // ───────── история загрузок ─────────
    // История хранится в YtDlpService (download_history.json). Раньше новые загрузки в неё не попадали,
    // потому что сервис добавлял запись только когда страница НЕ передавала свой объект — исправлено в сервисе.
    private List<DownloadItem> GetSortedHistory() =>
        Downloader.DownloadHistory.OrderByDescending(i => i.AddedTime).ToList();

    /// <summary>Обновляет путь/название записи после переименования файла.</summary>
    private void ApplyPathChange(string oldPath, string newPath, string newTitle)
    {
        foreach (var item in Downloader.DownloadHistory.Where(i =>
                     string.Equals(i.FilePath, oldPath, StringComparison.OrdinalIgnoreCase)))
        {
            item.FilePath = newPath;
            item.Title = newTitle;
        }
        _existsCache.Clear();
        Downloader.SaveHistory();
    }

    private YtDlpToolsStatus? _toolsStatus;

    private async Task RefreshToolsStatusAsync()
    {
        try
        {
            _toolsStatus = await Tools.GetStatusAsync(checkLatest: false);
            if (_toolsStatus.PotInstalled && !_toolsStatus.PotRunning)
            {
                await Tools.EnsurePotServerAsync();
                _toolsStatus = await Tools.GetStatusAsync(checkLatest: false);
            }
        }
        catch (Exception ex) { Logger.LogWarning($"Downloads: статус загрузчика: {ex.Message}"); }
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }

    private void ApplyProxy()
    {
        if (UseProxy && !string.IsNullOrWhiteSpace(ProxyAddress))
            Downloader.SetProxy(FormatProxyUrl(ProxyAddress));
        else
            Downloader.SetProxy(null);
    }

    // ───────── очистка URL ─────────
    private static string CleanUrl(string input, bool keepPlaylist)
    {
        var url = input.Trim();
        try
        {
            if (url.Contains("tiktok.com", StringComparison.OrdinalIgnoreCase))
            {
                var q = url.IndexOf('?');
                return q > 0 ? url[..q] : url;   // всё после ? — трекинг
            }

            if (url.Contains("youtu.be", StringComparison.OrdinalIgnoreCase))
            {
                var q = url.IndexOf('?');
                if (q <= 0) return url;
                var t = System.Web.HttpUtility.ParseQueryString(new Uri(url).Query)["t"];
                return string.IsNullOrEmpty(t) ? url[..q] : $"{url[..q]}?t={t}";
            }

            if (url.Contains("youtube.com", StringComparison.OrdinalIgnoreCase))
            {
                var uri = new Uri(url);
                var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
                var videoId = query["v"];
                if (string.IsNullOrEmpty(videoId)) return url;

                var parts = new List<string> { $"v={videoId}" };
                var listId = query["list"];
                if (keepPlaylist && !string.IsNullOrEmpty(listId)) parts.Add($"list={listId}");
                var ts = query["t"];
                if (!string.IsNullOrEmpty(ts)) parts.Add($"t={ts}");
                return $"{uri.Scheme}://{uri.Host}{uri.AbsolutePath}?{string.Join("&", parts)}";
            }
        }
        catch { /* парсинг не удался — оставляем как есть */ }
        return url;
    }

    // ───────── переименование ─────────
    private bool _showRenameModal;
    private DownloadItem? _renameItem;
    private string _renameValue = "";
    private string _renameError = "";

    private static readonly string[] ReservedNames =
        { "CON", "PRN", "AUX", "NUL", "COM1", "COM2", "COM3", "COM4", "COM5", "COM6", "COM7", "COM8", "COM9",
          "LPT1", "LPT2", "LPT3", "LPT4", "LPT5", "LPT6", "LPT7", "LPT8", "LPT9" };

    private static string SanitizeFileName(string name)
    {
        var invalid = Path.GetInvalidFileNameChars();
        var sb = new StringBuilder(name.Length);
        foreach (var c in name.Trim())
            sb.Append(Array.IndexOf(invalid, c) >= 0 ? '_' : c);

        var result = sb.ToString().Trim().TrimEnd('.', ' ');
        if (result.Length > 180) result = result[..180].TrimEnd();
        if (ReservedNames.Contains(result, StringComparer.OrdinalIgnoreCase)) result = "_" + result;
        return result;
    }

    /// <summary>Переименовывает файл, сохраняя расширение. Возвращает новый полный путь.</summary>
    private static string RenameFileOnDisk(string oldPath, string newBaseName)
    {
        var dir = Path.GetDirectoryName(oldPath) ?? throw new IOException("Не удалось определить папку файла");
        var ext = Path.GetExtension(oldPath);

        var safe = SanitizeFileName(newBaseName);
        if (ext.Length > 0 && safe.EndsWith(ext, StringComparison.OrdinalIgnoreCase))
            safe = safe[..^ext.Length].TrimEnd();   // пользователь сам ввёл расширение
        if (safe.Length == 0) throw new ArgumentException("Имя файла не может быть пустым");

        var newPath = Path.Combine(dir, safe + ext);

        if (string.Equals(newPath, oldPath, StringComparison.Ordinal)) return oldPath;

        if (string.Equals(newPath, oldPath, StringComparison.OrdinalIgnoreCase))
        {
            // смена только регистра: на NTFS прямой Move не сработает
            var tmp = Path.Combine(dir, Guid.NewGuid().ToString("N") + ext);
            File.Move(oldPath, tmp);
            File.Move(tmp, newPath);
            return newPath;
        }

        if (File.Exists(newPath))
            throw new IOException($"Файл «{safe + ext}» уже существует в этой папке");

        File.Move(oldPath, newPath);
        return newPath;
    }

    private void OpenRenameModal(DownloadItem item)
    {
        if (string.IsNullOrEmpty(item.FilePath)) return;
        _renameItem = item;
        _renameValue = Path.GetFileNameWithoutExtension(item.FilePath);
        _renameError = "";
        _showRenameModal = true;
    }

    private void CloseRenameModal()
    {
        _showRenameModal = false;
        _renameItem = null;
        _renameError = "";
    }

    private async Task OnRenameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmRename();
        else if (e.Key == "Escape") CloseRenameModal();
    }

    private async Task ConfirmRename()
    {
        if (_renameItem == null || string.IsNullOrEmpty(_renameItem.FilePath)) return;

        try
        {
            if (!File.Exists(_renameItem.FilePath))
                throw new FileNotFoundException("Файл не найден — возможно, он был перемещён или удалён");

            var newPath = await Task.Run(() => RenameFileOnDisk(_renameItem.FilePath, _renameValue));

            ApplyPathChange(_renameItem.FilePath, newPath, Path.GetFileNameWithoutExtension(newPath));
            _renameItem.FilePath = newPath;
            _renameItem.Title = Path.GetFileNameWithoutExtension(newPath);

            Logger.LogInfo($"Downloads: файл переименован → {newPath}");
            CloseRenameModal();
            await ShowToast($"✅ Переименовано: {Path.GetFileName(newPath)}", ToastType.Success);
        }
        catch (Exception ex)
        {
            _renameError = ex is IOException || ex is ArgumentException || ex is FileNotFoundException
                ? ex.Message
                : $"Ошибка: {ex.Message}";
        }
    }

    private void ShowConsoleLog(DownloadItem item)
    {
        _consoleLogItem = item;
        _showConsoleModal = true;
        StateHasChanged();
    }

    private void CloseConsoleModal()
    {
        _showConsoleModal = false;
        _consoleLogItem = null;
        StateHasChanged();
    }

    private void ShowStatusDetails(DownloadItem item)
    {
        _selectedItem = item;
        _showDetailsModal = true;
        StateHasChanged();
    }

    private void CloseDetailsModal()
    {
        _showDetailsModal = false;
        _selectedItem = null;
        StateHasChanged();
    }

    private async Task CopyToClipboard(string text)
    {
        if (string.IsNullOrEmpty(text)) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await ShowToast("📋 Скопировано в буфер обмена", ToastType.Success);
        }
        catch (Exception ex)
        {
            Logger.LogWarning($"Ошибка копирования: {ex.Message}");
            await ShowToast("❌ Не удалось скопировать", ToastType.Error);
        }
    }

    private static readonly Dictionary<string, string> BlockedSites = new(StringComparer.OrdinalIgnoreCase)
    {
        { "spotify.com", "Spotify использует DRM-защиту и не может быть скачан" },
