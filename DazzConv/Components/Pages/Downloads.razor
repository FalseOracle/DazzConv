@if (_toolsStatus != null && (!_toolsStatus.PotInstalled || _toolsStatus.YtDlpOld))
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center gap-3">
        <div>
            <strong>YouTube может скачиваться в 360p.</strong>
            @if (_toolsStatus.YtDlpOld) { <text> yt-dlp устарел.</text> }
            @if (!_toolsStatus.PotInstalled) { <text> Не установлен поставщик PO-токенов.</text> }
        </div>
        <a class="btn btn-sm btn-warning flex-shrink-0" href="/settings">Открыть настройки</a>
    </div>
}

<!-- Настройки -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">⚙️ Настройки</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-8">
                <div class="mb-3">
                    <label class="form-label">Папка загрузки:</label>
                    <div class="input-group">
                        <input type="text" class="form-control" @bind="DownloadPath" readonly />
                        <button class="btn btn-outline-secondary" @onclick="ChooseFolder">
                            <i class="bi bi-folder2-open"></i> Выбрать
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label class="form-label">Тип контента:</label>
                    <select class="form-select" value="@DownloadType" @onchange="OnTypeChanged">
                        <option value="video">Видео</option>
                        <option value="audio">Только аудио</option>
                        <option value="custom">Выбрать формат</option>
                    </select>
                </div>
            </div>
        </div>

        @if (DownloadType == "audio")
        {
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Аудио формат:</label>
                        <select class="form-select" @bind="AudioFormat" @bind:after="SaveStateAsync">
                            <option value="mp3">MP3 (совместимый)</option>
                            <option value="best">Оригинал (без перекодирования — честное качество)</option>
                            <option value="flac">FLAC (без потерь)</option>
                            <option value="aac">AAC (лучше MP3)</option>
                            <option value="ogg">OGG Vorbis</option>
                            <option value="opus">OPUS (современный)</option>
                            <option value="wav">WAV (без сжатия)</option>
                            <option value="m4a">M4A</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Битрейт: @AudioBitrate kbps</label>
                        <select class="form-select" @bind="AudioBitrate" @bind:after="SaveStateAsync">
                            <option value="64">64 kbps (низкое)</option>
                            <option value="128">128 kbps (среднее)</option>
                            <option value="192">192 kbps (хорошее)</option>
                            <option value="256">256 kbps (высокое)</option>
                            <option value="320">320 kbps (лучшее)</option>
                        </select>
                        @if (AudioFormat == "flac" || AudioFormat == "wav")
                        {
                            <div class="form-text">
                                Для FLAC/WAV битрейт не применяется. <strong>Важно:</strong> если сайт отдаёт звук со сжатием
                                (SoundCloud, YouTube, VK — обычно MP3/AAC/OPUS), FLAC/WAV качества не добавят: это «ненастоящий» lossless.
                                После загрузки в деталях будет написано, что реально отдал сайт.
                            </div>
                        }
                        else if (AudioFormat == "best")
                        {
                            <div class="form-text">Сохраняется исходный поток сайта как есть (без потери качества на перекодировке). Формат файла выберет сайт.</div>
                        }
                        else if (AudioFormat == "opus")
                        {
                            <div class="form-text">OPUS: 64-128 kbps достаточно для отличного качества</div>
                        }
                    </div>
                </div>
            </div>
        }
        else if (DownloadType == "video")
        {
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Качество видео:</label>
                        <select class="form-select" @bind="VideoQuality" @bind:after="SaveStateAsync">
                            <option value="best">Лучшее</option>
                            <option value="2160">4K (2160p)</option>
                            <option value="1440">2K (1440p)</option>
                            <option value="1080">1080p (Full HD)</option>
                            <option value="720">720p (HD)</option>
                            <option value="480">480p (SD)</option>
                            <option value="360">360p</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Видео формат (контейнер):</label>
                        <select class="form-select" @bind="VideoContainer" @bind:after="SaveStateAsync">
                            <option value="mkv">MKV (универсальный)</option>
                            <option value="mp4">MP4 (совместимый)</option>
                            <option value="webm">WebM (современный)</option>
                            <option value="avi">AVI (старый)</option>
                        </select>
                        <div class="form-text">MKV поддерживает все кодеки, MP4 более совместим</div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Настройки прокси -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">🌐 Настройки прокси</h5>
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-md-2">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="UseProxy" @bind:after="SaveProxySettingsAsync" id="proxyCheck" />
                    <label class="form-check-label" for="proxyCheck">Использовать прокси</label>
                </div>
            </div>
            <div class="col-md-5">
                <input type="text"
                       class="form-control @(UseProxy ? "" : "disabled")"
                       @bind="ProxyAddress"
                       @bind:after="OnProxyAddressChanged"
                       placeholder="127.0.0.1:1080"
                       disabled="@(!UseProxy)" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-outline-primary w-100"
                        @onclick="TestProxyConnection"
                        disabled="@(!UseProxy || IsTestingProxy)">
                    @if (IsTestingProxy)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <text>Проверка...</text>
                    }
                    else
                    {
                        <i class="bi bi-wifi"></i>
                        <text> Проверить подключение</text>
                    }
                </button>
            </div>
            <div class="col-md-2">
                @if (ProxyTestResult.HasValue)
                {
                    <div class="alert @(ProxyTestResult.Value ? "alert-success" : "alert-danger") mb-0 py-2 text-center">
                        <i class="bi bi-@(ProxyTestResult.Value ? "check-circle" : "x-circle")"></i>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- URL -->
<div class="card mb-4">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">Ссылка (URL):</label>
            <input type="text" class="form-control" @bind="UrlInput"
                   placeholder="https://youtube.com/watch?v=... или https://tiktok.com/..." />
            <div class="form-text">Поддерживаются ссылки на видео, плейлисты, каналы, альбомы</div>
            @if (!string.IsNullOrEmpty(_blockedSiteWarning))
            {
                <div class="alert alert-danger mt-2 mb-0 py-2">
                    <i class="bi bi-shield-x me-2"></i>
                    <strong>@_blockedSiteWarning</strong>
                </div>
            }
        </div>

        <div class="mb-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="IsPlaylist" @bind:after="SaveStateAsync" />
                <label class="form-check-label">Это плейлист/альбом (скачать всё)</label>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Своё имя файла (необязательно):</label>
            <input type="text" class="form-control" @bind="CustomFileName" @bind:event="oninput"
                   disabled="@(IsPlaylist || IsDownloading)"
                   placeholder="Пусто — имя возьмётся из видео" />
            <div class="form-text">
                Расширение добавится автоматически. Недопустимые символы заменятся на «_».
                Для плейлистов не применяется — там можно переименовать каждый файл в истории.
            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-lg" @onclick="StartDownload" disabled="@(IsDownloading || IsCancelling)">
                @if (IsCancelling)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <text>Отмена...</text>
                }
                else
                {
                    <i class="bi bi-download me-2"></i>
                    <text>@(IsDownloading ? "Загрузка..." : "Скачать")</text>
                }
            </button>
            <button class="btn btn-danger btn-lg" @onclick="CancelDownload" disabled="@(!IsDownloading || IsCancelling)">
                <i class="bi bi-x-circle"></i> Отмена
            </button>
        </div>

        @if (IsDownloading && CurrentDownload != null)
        {
            <div class="alert alert-info mt-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong>🔄 Загрузка:</strong>
                    <span>@CurrentDownload.Status</span>
                </div>
                <div class="progress" style="height: 25px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar"
                         style="width: @CurrentDownload.Progress%">
                        @CurrentDownload.Progress%
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(DownloadProgressText))
                {
                    <small class="text-muted mt-2 d-block">@DownloadProgressText</small>
                }
            </div>
        }
    </div>
</div>

<!-- Доступные форматы -->
@if (AvailableFormats.Any())
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">📋 Доступные форматы</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Разрешение</th>
                            <th>Расширение</th>
                            <th>Видео кодек</th>
                            <th>Аудио кодек</th>
                            <th>Размер</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var format in AvailableFormats.OrderByDescending(f => f.Filesize ?? 0))
                        {
                            <tr style="cursor: pointer" @onclick="() => SelectFormat(format.FormatId)">
                                <td>@format.FormatId</td>
                                <td>@format.Resolution</td>
                                <td>@format.Extension</td>
                                <td>@format.Vcodec</td>
                                <td>@format.Acodec</td>
                                <td>@FormatFileSize(format.Filesize ?? 0)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Текущая загрузка -->
@if (CurrentDownload != null && !IsDownloading)
{
    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">🔄 Последняя загрузка</h5>
        </div>
        <div class="card-body">
            <h6>@CurrentDownload.Title</h6>
            <p class="text-muted">@CurrentDownload.Status</p>
            <div class="progress" style="height: 30px;">
                <div class="progress-bar progress-bar-striped @(CurrentDownload.Progress >= 100 ? "" : "progress-bar-animated")"
                     role="progressbar"
                     style="width: @CurrentDownload.Progress%">
                    @CurrentDownload.Progress%
                </div>
            </div>
        </div>
    </div>
}

<!-- 🆕 МОДАЛЬНОЕ ОКНО ДЕТАЛЕЙ ЗАГРУЗКИ -->
@if (_showDetailsModal && _selectedItem != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content details-modal">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-info-circle me-2"></i>Детали загрузки
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDetailsModal"></button>
                </div>
                <div class="modal-body">
                    <div class="details-title mb-3">
                        <h6 class="fw-bold mb-1">@_selectedItem.Title</h6>
                        <small class="text-muted">ID: @(_selectedItem.GetHashCode().ToString("X8"))</small>
                    </div>

                    <div class="details-table">
                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-link-45deg text-primary"></i> Ссылка
                            </div>
                            <div class="detail-value">
                                <a href="@_selectedItem.Url" target="_blank" class="text-break">
                                    @_selectedItem.Url
                                </a>
                                <button class="btn btn-sm btn-link p-0 ms-2"
                                        @onclick="() => CopyToClipboard(_selectedItem.Url)"
                                        title="Скопировать">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-flag text-success"></i> Статус
                            </div>
                            <div class="detail-value">
                                @if (_selectedItem.Progress >= 100)
                                {
                                    <span class="badge bg-success">✅ Завершено</span>
                                }
                                else if (_selectedItem.Progress > 0)
                                {
                                    <span class="badge bg-warning text-dark">⏳ @_selectedItem.Progress%</span>
                                }
