    private async Task StartDownload()
    {
        if (string.IsNullOrWhiteSpace(UrlInput))
        {
            await ShowToast("⚠️ Введите ссылку", ToastType.Warning);
            return;
        }

        var cleanUrl = CleanUrl(UrlInput, IsPlaylist);

        // ЗАЩИТА: проверяем что YouTube URL содержит ID видео
        if (cleanUrl.Contains("youtube.com/watch", StringComparison.OrdinalIgnoreCase))
        {
            if (!cleanUrl.Contains("v=", StringComparison.OrdinalIgnoreCase))
            {
                await ShowToast("❌ Неправильная ссылка YouTube! Не найден ID видео (v=...).\n\nПравильный формат:\nhttps://www.youtube.com/watch?v=VIDEO_ID", ToastType.Error);
                return;
            }
        }

        if (IsUrlBlocked(cleanUrl, out var blockReason))
        {
            _blockedSiteWarning = blockReason;
            await ShowToast($"🚫 {blockReason}", ToastType.Error);
            StateHasChanged();
            return;
        }

        _blockedSiteWarning = "";

        ApplyProxy();

        // для YouTube поднимаем локальный сервер PO-токенов (если он установлен)
        if (cleanUrl.Contains("youtu", StringComparison.OrdinalIgnoreCase))
        {
            try { await Tools.EnsurePotServerAsync(); }
            catch (Exception ex) { Logger.LogWarning($"Downloads: сервер PO-токенов не запущен: {ex.Message}"); }
        }

        try
        {
            IsDownloading = true;
            IsCancelling = false;
            Cts = new CancellationTokenSource();
            _ = SaveStateAsync();
            DownloadProgressText = "Инициализация...";

            string? format;
            bool isAudioOnly = false;

            if (DownloadType == "audio")
            {
                format = null;
                isAudioOnly = true;
            }
            else if (DownloadType == "custom")
            {
                format = SelectedFormatId;
            }
            else
            {
                if (VideoQuality == "best")
                {
                    format = null;
                }
                else
                {
                    format = $"bestvideo[height<={VideoQuality}]+bestaudio/best[height<={VideoQuality}]";
                }
            }

            // Раньше: double.TryParse без InvariantCulture → при русской локали "12.5" не парсилось
            // и прогресс не двигался; плюс StateHasChanged на КАЖДУЮ строку yt-dlp.
            var lastRender = DateTime.MinValue;
            var progress = new Progress<string>(line =>
            {
                DownloadProgressText = line;

                var item = CurrentDownload;
                if (item != null)
                {
                    var match = ProgressRegex.Match(line);
                    if (match.Success &&
                        double.TryParse(match.Groups[1].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var percent))
                    {
                        item.Progress = (int)percent;
                        item.Status = $"Загрузка: {percent:F1}%";
                    }
                }

                var now = DateTime.UtcNow;
                if (!_disposed && (now - lastRender).TotalMilliseconds >= 250)
                {
                    lastRender = now;
                    _ = InvokeAsync(StateHasChanged);
                }
            });

            if (IsPlaylist)
            {
                CurrentDownload = new DownloadItem
                {
                    Url = cleanUrl,
                    Title = "📚 Скачивание плейлиста...",
                    Status = "Инициализация...",
                    Progress = 0
                };
                StateHasChanged();

                var items = await Downloader.DownloadPlaylistAsync(
                    cleanUrl,
                    format,
                    isAudioOnly,
                    token: Cts.Token,
                    audioFormat: AudioFormat,
                    audioBitrate: AudioBitrate,
                    videoContainer: VideoContainer,
                    progress: progress,
                    liveItem: CurrentDownload);

                // итог берём из статуса, который выставил сервис (раньше всегда показывалось «Альбом завершён»)
                var albumStatus = CurrentDownload?.Status ?? "";
                if (albumStatus.StartsWith("❌"))
                    await ShowToast(albumStatus, ToastType.Error);
                else if (albumStatus.StartsWith("⚠️"))
                    await ShowToast(albumStatus, ToastType.Warning);
                else if (items.Count == 0)
                    await ShowToast("⚠️ Ничего не скачано", ToastType.Warning);
                else
                    await ShowToast($"✅ Альбом скачан: {items.Count} шт. (в подпапке «{CurrentDownload?.Title?.Replace("📚 ", "")}»)", ToastType.Success);
            }
            else
            {
                // Создаём объект ДО вызова DownloadAsync
                CurrentDownload = new DownloadItem
                {
                    Url = cleanUrl,
                    Title = "Получение информации...",
                    Status = "Инициализация...",
                    Progress = 0
                };
                StateHasChanged();

                // Передаём existingItem — сервис будет обновлять ТОТ ЖЕ объект
                CurrentDownload = await Downloader.DownloadAsync(
                    cleanUrl,
                    format,
                    isAudioOnly,
                    null,
                    progress,
                    Cts.Token,
                    AudioFormat,
                    AudioBitrate,
                    VideoContainer,
                    false,
                    CurrentDownload);  // ← ПЕРЕДАЁМ existingItem!

                if (CurrentDownload != null)
                {
                    if (!string.IsNullOrEmpty(CurrentDownload.FilePath) && File.Exists(CurrentDownload.FilePath))
                    {
                        try
                        {
                            var fileInfo = new FileInfo(CurrentDownload.FilePath);
                            CurrentDownload.FileSize = fileInfo.Length;
                            Logger.LogInfo($"Downloads: размер файла обновлён: {CurrentDownload.FileSize} байт");
                        }
                        catch { }
                    }

                    if (string.IsNullOrEmpty(CurrentDownload.FilePath) && !string.IsNullOrEmpty(DownloadPath) && Directory.Exists(DownloadPath))
                    {
                        try
                        {
                            var latestFile = Directory.GetFiles(DownloadPath)
                                .Select(f => new FileInfo(f))
                                .Where(f => f.Length > 0 && f.LastWriteTime > DateTime.Now.AddMinutes(-5))
                                .OrderByDescending(f => f.LastWriteTime)
                                .FirstOrDefault();

                            if (latestFile != null)
                            {
                                CurrentDownload.FilePath = latestFile.FullName;
                                CurrentDownload.FileSize = latestFile.Length;
                                Logger.LogInfo($"Downloads: найден последний файл: {latestFile.FullName}");
                            }
                        }
                        catch { }
                    }

                    if (!string.IsNullOrWhiteSpace(CustomFileName))
                    {
                        if (!string.IsNullOrEmpty(CurrentDownload.FilePath) && File.Exists(CurrentDownload.FilePath))
                        {
                            try
                            {
                                var oldPath = CurrentDownload.FilePath;
                                var newPath = RenameFileOnDisk(oldPath, CustomFileName);
                                CurrentDownload.FilePath = newPath;
                                CurrentDownload.Title = Path.GetFileNameWithoutExtension(newPath);
                                ApplyPathChange(oldPath, newPath, CurrentDownload.Title);
                                CustomFileName = "";
                            }
                            catch (Exception ex)
                            {
                                Logger.LogWarning($"Downloads: не удалось переименовать: {ex.Message}");
                                await ShowToast($"⚠️ Файл скачан, но имя не применено: {ex.Message}", ToastType.Warning);
                            }
                        }
                        else
                        {
                            await ShowToast("⚠️ Не удалось применить своё имя: путь к файлу не определён", ToastType.Warning);
                        }
                    }

                    if (!string.IsNullOrEmpty(CurrentDownload.FilePath))
                    {
                        var fileName = Path.GetFileName(CurrentDownload.FilePath);
                        await ShowToast($"✅ Загружено: {fileName}", ToastType.Success);
                    }
                    else
                    {
                        await ShowToast("⚠️ Загрузка завершена, но файл не найден. Проверьте папку загрузок.", ToastType.Warning);
                    }
                }

            }

            await UpdateCacheSizeAsync();
        }
        catch (OperationCanceledException)
        {
            await ShowToast("⚠️ Загрузка отменена", ToastType.Warning);
        }
        catch (Exception ex)
        {
            await ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
        finally
        {
            IsDownloading = false;
            IsCancelling = false;
            // CurrentDownload больше не обнуляется: раньше карточка «Последняя загрузка» никогда не показывалась
            Cts?.Dispose();
            Cts = null;
            StateHasChanged();
        }
    }

    private async Task CancelDownload()
    {
        if (!IsDownloading || IsCancelling) return;

        try
        {
            IsCancelling = true;
            StateHasChanged();

            Cts?.Cancel();
            Downloader.CancelDownload();

            await ShowToast("⚠️ Отмена загрузки...", ToastType.Warning);

            await Task.Delay(2000);

            if (IsDownloading)
            {
                IsDownloading = false;
                IsCancelling = false;
                Cts?.Dispose();
                Cts = null;
                StateHasChanged();
                await ShowToast("⚠️ Загрузка принудительно остановлена", ToastType.Warning);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError("Ошибка отмены загрузки", ex);
            IsDownloading = false;
            IsCancelling = false;
            StateHasChanged();
        }
    }

    private void ClearHistory()
    {
        Downloader.ClearHistory();
        StateHasChanged();
    }

    private void RemoveFromHistory(DownloadItem item)
    {
        Downloader.RemoveFromHistory(item);
        StateHasChanged();
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes == 0) return "0 Б";
        const long kb = 1024, mb = kb * 1024, gb = mb * 1024;
        if (bytes >= gb) return $"{(bytes / (double)gb):F2} ГБ";
        if (bytes >= mb) return $"{(bytes / (double)mb):F2} МБ";
        if (bytes >= kb) return $"{(bytes / (double)kb):F2} КБ";
        return $"{bytes} Б";
    }

    private async Task ShowToast(string message, ToastType type = ToastType.Info)
    {
        try { await JSRuntime.InvokeVoidAsync("showToast", message, type.ToString().ToLower()); }
        catch { await JSRuntime.InvokeVoidAsync("alert", message); }
    }

    private enum ToastType { Success, Error, Warning, Info }

    // ───────── сохранение настроек загрузки (файл в AppData, как и прокси; localStorage — запасной вариант) ─────────
    private static string GetDownloadSettingsPath()
    {
        var dir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData), "DazzConv");
        Directory.CreateDirectory(dir);
        return Path.Combine(dir, "download_settings.json");
    }

    private async Task SaveStateAsync()
    {
        var state = new DownloadState
        {
            UrlInput = UrlInput,
            DownloadType = DownloadType,
            VideoQuality = VideoQuality,
            AudioFormat = AudioFormat,
            AudioBitrate = AudioBitrate,
            VideoContainer = VideoContainer,
            IsPlaylist = IsPlaylist,
            SelectedFormatId = SelectedFormatId,
            DownloadPath = DownloadPath
        };
        var json = JsonSerializer.Serialize(state);

        try { await File.WriteAllTextAsync(GetDownloadSettingsPath(), json); }
        catch (Exception ex) { Logger.LogWarning($"Downloads: не удалось сохранить настройки: {ex.Message}"); }

        try { await JSRuntime.InvokeVoidAsync("localStorage.setItem", "dazzconv_download_state", json); }
        catch { }
    }

    private async Task LoadStateAsync()
    {
        DownloadState? state = null;

        try
        {
            var path = GetDownloadSettingsPath();
            if (File.Exists(path))
                state = JsonSerializer.Deserialize<DownloadState>(await File.ReadAllTextAsync(path));
        }
        catch (Exception ex) { Logger.LogWarning($"Downloads: ошибка чтения настроек: {ex.Message}"); }

        if (state == null)
        {
            try
            {
                var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "dazzconv_download_state");
                if (!string.IsNullOrEmpty(json)) state = JsonSerializer.Deserialize<DownloadState>(json);
            }
            catch { }
        }

        if (state == null) return;

        UrlInput = state.UrlInput ?? "";
        DownloadType = state.DownloadType is "video" or "audio" or "custom" ? state.DownloadType : "video";
        VideoQuality = state.VideoQuality ?? "best";
        AudioFormat = state.AudioFormat ?? "mp3";
        if (state.AudioBitrate > 0) AudioBitrate = state.AudioBitrate;
        VideoContainer = state.VideoContainer ?? "mkv";
        IsPlaylist = state.IsPlaylist;
        SelectedFormatId = state.SelectedFormatId ?? "";

        // «Выбрать формат» без загруженного списка форматов выбрать нечем — возвращаемся к видео
        if (DownloadType == "custom" && string.IsNullOrEmpty(SelectedFormatId)) DownloadType = "video";

        if (!string.IsNullOrWhiteSpace(state.DownloadPath) && Directory.Exists(state.DownloadPath))
        {
            DownloadPath = state.DownloadPath;
            Downloader.SetDownloadPath(state.DownloadPath);
        }
    }

    private class DownloadState
    {
        public string? UrlInput { get; set; }
        public string? DownloadType { get; set; }
        public string? VideoQuality { get; set; }
        public string? AudioFormat { get; set; }
        public int AudioBitrate { get; set; }
        public string? VideoContainer { get; set; }
        public bool IsPlaylist { get; set; }
        public string? SelectedFormatId { get; set; }
        public string? DownloadPath { get; set; }
    }
}
