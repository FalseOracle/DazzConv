@page "/downloads"
@using System.IO
@using System.Linq
@using System.Text.Json
@using ConverToDazz.Core.Services
@using DazzConv.Services
@using Microsoft.Maui.Storage
@inject YtDlpService Downloader
@inject IJSRuntime JSRuntime
@inject LoggerService Logger
@inject HotkeyService Hotkeys

<h3>📥 Скачать видео и аудио</h3>

<div class="alert alert-info">
    <strong>Универсальный загрузчик</strong><br />
    Поддерживает: YouTube, TikTok, Twitter/X, Reddit, Twitch, VK, OK.ru, Rutube, Dailymotion, Vimeo, Rumble, Bilibili, Patreon и 1800+ других сайтов
</div>

<style>

    /* ===== 🌙 ТЁМНАЯ ТЕМА: Модальное окно деталей ===== */
    body.dark-theme .details-modal {
        background: #1e1e2e;
        color: #e0e0e0;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
    }

        body.dark-theme .details-modal .modal-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        }

        body.dark-theme .details-modal .modal-footer {
            background: #181825;
            border-top: 1px solid #2a2a3e;
        }

        body.dark-theme .details-modal .details-title h6 {
            color: #ffffff;
        }

        body.dark-theme .details-modal .details-title small {
            color: #888;
        }

    /* Таблица деталей */
    body.dark-theme .details-table {
        border-color: #3a3a5a;
        background: #252538;
    }

    body.dark-theme .detail-row {
        border-bottom-color: #2a2a3e;
    }

        body.dark-theme .detail-row:last-child {
            border-bottom: none;
        }

    body.dark-theme .detail-label {
        color: #aaa;
    }

        body.dark-theme .detail-label i {
            opacity: 0.9;
        }

    body.dark-theme .detail-value {
        color: #e0e0e0;
    }

        body.dark-theme .detail-value a {
            color: #7aa2f7;
        }

            body.dark-theme .detail-value a:hover {
                color: #9bb8ff;
            }

        /* Кнопки копирования */
        body.dark-theme .detail-value .btn-link {
            color: #7aa2f7;
        }

        body.dark-theme .detail-value .btn-outline-secondary {
            color: #aaa;
            border-color: #3a3a5a;
        }

            body.dark-theme .detail-value .btn-outline-secondary:hover {
                background: #2a2a3e;
                color: #fff;
            }

    /* Футер */
    body.dark-theme .modal-footer .btn-secondary {
        background: #3a3a5a;
        border-color: #3a3a5a;
        color: #fff;
    }

        body.dark-theme .modal-footer .btn-secondary:hover {
            background: #4a4a6a;
        }

    body.dark-theme .modal-footer .btn-outline-primary {
        color: #7aa2f7;
        border-color: #7aa2f7;
    }

        body.dark-theme .modal-footer .btn-outline-primary:hover {
            background: rgba(122, 162, 247, 0.1);
        }

    body.dark-theme .modal-footer .btn-outline-secondary {
        color: #aaa;
        border-color: #3a3a5a;
    }

        body.dark-theme .modal-footer .btn-outline-secondary:hover {
            background: #2a2a3e;
            color: #fff;
        }

    /* Alert'ы внутри модалки */
    body.dark-theme .details-modal .alert-warning {
        background-color: #3d2f00 !important;
        border-color: #6b5400 !important;
        color: #ffd866 !important;
    }

        body.dark-theme .details-modal .alert-warning strong {
            color: #ffd866 !important;
        }

    body.dark-theme .details-modal .alert-danger {
        background-color: #2d1b1b !important;
        border-color: #5c2828 !important;
        color: #ff6b6b !important;
    }

        body.dark-theme .details-modal .alert-danger h6 {
            color: #ff8787 !important;
        }

        body.dark-theme .details-modal .alert-danger small {
            color: #ffaaaa !important;
        }

    /* Modal backdrop в тёмной теме */
    body.dark-theme .modal-backdrop {
        background-color: rgba(0, 0, 0, 0.75);
    }

    /* Scrollbar в модалке */
    body.dark-theme .details-modal ::-webkit-scrollbar {
        width: 8px;
    }

    body.dark-theme .details-modal ::-webkit-scrollbar-track {
        background: #1e1e2e;
    }

    body.dark-theme .details-modal ::-webkit-scrollbar-thumb {
        background: #3a3a5a;
        border-radius: 4px;
    }

        body.dark-theme .details-modal ::-webkit-scrollbar-thumb:hover {
            background: #4a4a6a;
        }

    /* 🆕 Стили модального окна деталей */
    .details-modal {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
    }

        .details-modal .modal-header {
            border-bottom: none;
            padding: 1.25rem 1.5rem;
        }

        .details-modal .modal-body {
            padding: 1.5rem;
        }

        .details-modal .details-title h6 {
            word-break: break-word;
        }

    .details-table {
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        overflow: hidden;
    }

    body.dark-theme .details-table {
        border-color: #3a3a5a;
    }

    .detail-row {
        display: flex;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #f0f0f0;
        gap: 1rem;
        align-items: flex-start;
    }

    body.dark-theme .detail-row {
        border-bottom-color: #2a2a3e;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        flex: 0 0 140px;
        font-weight: 600;
        color: #666;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-theme .detail-label {
        color: #aaa;
    }

    .detail-value {
        flex: 1;
        word-break: break-word;
        min-width: 0;
    }

        .detail-value a {
            word-break: break-all;
            font-size: 0.9rem;
        }

    /* Анимация появления */
    .modal.fade.show {
        animation: modalFadeIn 0.2s ease-out;
    }

    @@keyframes modalFadeIn {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .status-cell {
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

        .status-cell .badge {
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            display: inline-block;
        }

    .actions-cell {
        white-space: nowrap;
        min-width: 100px;
        text-align: right;
    }

        .actions-cell .btn-group {
            display: inline-flex;
        }

    .row.g-3 .form-control,
    .row.g-3 .btn {
        height: calc(2.5rem + 2px);
    }

    .table td {
        vertical-align: middle;
    }

    .btn-group .btn {
        margin: 0 2px;
    }

    .progress-bar-animated {
        animation: progress-bar-stripes 1s linear infinite;
    }

    @@keyframes progress-bar-stripes {
        0% {
            background-position-x: 1rem;
        }
    }

    .file-name-cell {
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

        .file-name-cell strong {
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .cache-info {
        font-size: 0.9rem;
        color: #6c757d;
    }

    .blocked-sites-list {
        font-size: 0.85rem;
        color: #6c757d;
        margin-top: 0.5rem;
    }

    body.dark-theme .alert-danger {
        background-color: #842029 !important;
        border-color: #b02a37 !important;
        color: #ffffff !important;
    }

        body.dark-theme .alert-danger strong {
            color: #ffffff !important;
        }

        body.dark-theme .alert-danger .bi {
            color: #ffffff !important;
        }

    /* Также исправляем другие alert'ы в тёмной теме */
    body.dark-theme .alert-info {
        background-color: #055160 !important;
        border-color: #087990 !important;
        color: #ffffff !important;
    }

    body.dark-theme .alert-success {
        background-color: #0f5132 !important;
        border-color: #198754 !important;
        color: #ffffff !important;
    }

    body.dark-theme .alert-warning {
        background-color: #664d03 !important;
        border-color: #ffca2c !important;
        color: #ffffff !important;
    }

    body.dark-theme .alert-secondary {
        background-color: #495057 !important;
        border-color: #6c757d !important;
        color: #ffffff !important;
    }

</style>

<!-- Настройки -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">⚙️ Настройки</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-8">
                <div class="mb-3">
                    <label class="form-label">Папка загрузки:</label>
                    <div class="input-group">
                        <input type="text" class="form-control" @bind="DownloadPath" readonly />
                        <button class="btn btn-outline-secondary" @onclick="ChooseFolder">
                            <i class="bi bi-folder2-open"></i> Выбрать
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label class="form-label">Тип контента:</label>
                    <select class="form-select" value="@DownloadType" @onchange="OnTypeChanged">
                        <option value="video">Видео</option>
                        <option value="audio">Только аудио</option>
                        <option value="custom">Выбрать формат</option>
                    </select>
                </div>
            </div>
        </div>

        @if (DownloadType == "audio")
        {
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Аудио формат:</label>
                        <select class="form-select" @bind="AudioFormat">
                            <option value="mp3">MP3 (совместимый)</option>
                            <option value="flac">FLAC (без потерь)</option>
                            <option value="aac">AAC (лучше MP3)</option>
                            <option value="ogg">OGG Vorbis</option>
                            <option value="opus">OPUS (современный)</option>
                            <option value="wav">WAV (без сжатия)</option>
                            <option value="m4a">M4A</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Битрейт: @AudioBitrate kbps</label>
                        <select class="form-select" @bind="AudioBitrate">
                            <option value="64">64 kbps (низкое)</option>
                            <option value="128">128 kbps (среднее)</option>
                            <option value="192">192 kbps (хорошее)</option>
                            <option value="256">256 kbps (высокое)</option>
                            <option value="320">320 kbps (лучшее)</option>
                        </select>
                        @if (AudioFormat == "flac" || AudioFormat == "wav")
                        {
                            <div class="form-text">Для FLAC/WAV битрейт не применяется (без потерь)</div>
                        }
                        else if (AudioFormat == "opus")
                        {
                            <div class="form-text">OPUS: 64-128 kbps достаточно для отличного качества</div>
                        }
                    </div>
                </div>
            </div>
        }
        else if (DownloadType == "video")
        {
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Качество видео:</label>
                        <select class="form-select" @bind="VideoQuality">
                            <option value="best">Лучшее</option>
                            <option value="2160">4K (2160p)</option>
                            <option value="1440">2K (1440p)</option>
                            <option value="1080">1080p (Full HD)</option>
                            <option value="720">720p (HD)</option>
                            <option value="480">480p (SD)</option>
                            <option value="360">360p</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Видео формат (контейнер):</label>
                        <select class="form-select" @bind="VideoContainer">
                            <option value="mkv">MKV (универсальный)</option>
                            <option value="mp4">MP4 (совместимый)</option>
                            <option value="webm">WebM (современный)</option>
                            <option value="avi">AVI (старый)</option>
                        </select>
                        <div class="form-text">MKV поддерживает все кодеки, MP4 более совместим</div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Настройки прокси -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">🌐 Настройки прокси</h5>
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-md-2">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="UseProxy" @bind:after="SaveProxySettingsAsync" id="proxyCheck" />
                    <label class="form-check-label" for="proxyCheck">Использовать прокси</label>
                </div>
            </div>
            <div class="col-md-5">
                <input type="text"
                       class="form-control @(UseProxy ? "" : "disabled")"
                       @bind="ProxyAddress"
                       @bind:after="OnProxyAddressChanged"
                       placeholder="127.0.0.1:1080"
                       disabled="@(!UseProxy)" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-outline-primary w-100"
                        @onclick="TestProxyConnection"
                        disabled="@(!UseProxy || IsTestingProxy)">
                    @if (IsTestingProxy)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <text>Проверка...</text>
                    }
                    else
                    {
                        <i class="bi bi-wifi"></i>
                        <text> Проверить подключение</text>
                    }
                </button>
            </div>
            <div class="col-md-2">
                @if (ProxyTestResult.HasValue)
                {
                    <div class="alert @(ProxyTestResult.Value ? "alert-success" : "alert-danger") mb-0 py-2 text-center">
                        <i class="bi bi-@(ProxyTestResult.Value ? "check-circle" : "x-circle")"></i>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- URL -->
<div class="card mb-4">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">Ссылка (URL):</label>
            <input type="text" class="form-control" @bind="UrlInput"
                   placeholder="https://youtube.com/watch?v=... или https://tiktok.com/..." />
            <div class="form-text">Поддерживаются ссылки на видео, плейлисты, каналы, альбомы</div>
            @if (!string.IsNullOrEmpty(_blockedSiteWarning))
            {
                <div class="alert alert-danger mt-2 mb-0 py-2">
                    <i class="bi bi-shield-x me-2"></i>
                    <strong>@_blockedSiteWarning</strong>
                </div>
            }
        </div>

        <div class="mb-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="IsPlaylist" />
                <label class="form-check-label">Это плейлист/альбом (скачать всё)</label>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-lg" @onclick="StartDownload" disabled="@(IsDownloading || IsCancelling)">
                @if (IsCancelling)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <text>Отмена...</text>
                }
                else
                {
                    <i class="bi bi-download me-2"></i>
                    <text>@(IsDownloading ? "Загрузка..." : "Скачать")</text>
                }
            </button>
            <button class="btn btn-danger btn-lg" @onclick="CancelDownload" disabled="@(!IsDownloading || IsCancelling)">
                <i class="bi bi-x-circle"></i> Отмена
            </button>
        </div>

        @if (IsDownloading && CurrentDownload != null)
        {
            <div class="alert alert-info mt-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong>🔄 Загрузка:</strong>
                    <span>@CurrentDownload.Status</span>
                </div>
                <div class="progress" style="height: 25px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar"
                         style="width: @CurrentDownload.Progress%">
                        @CurrentDownload.Progress%
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(DownloadProgressText))
                {
                    <small class="text-muted mt-2 d-block">@DownloadProgressText</small>
                }
            </div>
        }
    </div>
</div>

<!-- Доступные форматы -->
@if (AvailableFormats.Any())
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">📋 Доступные форматы</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Разрешение</th>
                            <th>Расширение</th>
                            <th>Видео кодек</th>
                            <th>Аудио кодек</th>
                            <th>Размер</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var format in AvailableFormats.OrderByDescending(f => f.Filesize ?? 0))
                        {
                            <tr style="cursor: pointer" @onclick="() => SelectFormat(format.FormatId)">
                                <td>@format.FormatId</td>
                                <td>@format.Resolution</td>
                                <td>@format.Extension</td>
                                <td>@format.Vcodec</td>
                                <td>@format.Acodec</td>
                                <td>@FormatFileSize(format.Filesize ?? 0)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Текущая загрузка -->
@if (CurrentDownload != null && !IsDownloading)
{
    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">🔄 Последняя загрузка</h5>
        </div>
        <div class="card-body">
            <h6>@CurrentDownload.Title</h6>
            <p class="text-muted">@CurrentDownload.Status</p>
            <div class="progress" style="height: 30px;">
                <div class="progress-bar progress-bar-striped @(CurrentDownload.Progress >= 100 ? "" : "progress-bar-animated")"
                     role="progressbar"
                     style="width: @CurrentDownload.Progress%">
                    @CurrentDownload.Progress%
                </div>
            </div>
        </div>
    </div>
}
<!-- 🆕 МОДАЛЬНОЕ ОКНО ДЕТАЛЕЙ ЗАГРУЗКИ -->
@if (_showDetailsModal && _selectedItem != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content details-modal">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-info-circle me-2"></i>Детали загрузки
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDetailsModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Заголовок -->
                    <div class="details-title mb-3">
                        <h6 class="fw-bold mb-1">@_selectedItem.Title</h6>
                        <small class="text-muted">ID: @(_selectedItem.GetHashCode().ToString("X8"))</small>
                    </div>

                    <!-- Таблица деталей -->
                    <div class="details-table">
                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-link-45deg text-primary"></i> Ссылка
                            </div>
                            <div class="detail-value">
                                <a href="@_selectedItem.Url" target="_blank" class="text-break">
                                    @_selectedItem.Url
                                </a>
                                <button class="btn btn-sm btn-link p-0 ms-2"
                                        @onclick="() => CopyToClipboard(_selectedItem.Url)"
                                        title="Скопировать">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-flag text-success"></i> Статус
                            </div>
                            <div class="detail-value">
                                @if (_selectedItem.Progress >= 100)
                                {
                                    <span class="badge bg-success">✅ Завершено</span>
                                }
                                else if (_selectedItem.Progress > 0)
                                {
                                    <span class="badge bg-warning text-dark">⏳ @_selectedItem.Progress%</span>
                                }
                                else if (_selectedItem.Status.Contains("❌"))
                                {
                                    <span class="badge bg-danger">❌ Ошибка</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@_selectedItem.Status</span>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-calendar text-info"></i> Добавлено
                            </div>
                            <div class="detail-value">
                                @_selectedItem.AddedTime.ToString("dd.MM.yyyy HH:mm:ss")
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_selectedItem.FilePath))
                        {
                            <div class="detail-row">
                                <div class="detail-label">
                                    <i class="bi bi-folder text-warning"></i> Путь
                                </div>
                                <div class="detail-value">
                                    <div class="d-flex align-items-start gap-2">
                                        <span class="text-break flex-grow-1" title="@_selectedItem.FilePath">
                                            @_selectedItem.FilePath
                                        </span>
                                        <button class="btn btn-sm btn-outline-secondary flex-shrink-0"
                                                @onclick="() => CopyToClipboard(_selectedItem.FilePath)"
                                                title="Скопировать путь">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">
                                    <i class="bi bi-hdd text-secondary"></i> Размер
                                </div>
                                <div class="detail-value">
                                    @FormatFileSize(_selectedItem.FileSize)
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(_selectedItem.Format))
                            {
                                <div class="detail-row">
                                    <div class="detail-label">
                                        <i class="bi bi-file-earmark text-info"></i> Формат
                                    </div>
                                    <div class="detail-value">
                                        <span class="badge bg-info text-dark">@_selectedItem.Format</span>
                                    </div>
                                </div>
                            }

                            <div class="detail-row">
                                <div class="detail-label">
