    private async Task OnProxyAddressChanged() => await SaveProxySettingsAsync();

    private async Task LoadProxySettingsAsync()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "dazzconv_proxy_settings");
            if (!string.IsNullOrEmpty(json))
            {
                var settings = System.Text.Json.JsonSerializer.Deserialize<ProxySettings>(json);
                if (settings != null)
                {
                    UseProxy = settings.UseProxy;
                    ProxyAddress = settings.ProxyAddress ?? "127.0.0.1:1080";
                }
            }
        }
        catch { }
    }

    private class ProxySettings
    {
        public bool UseProxy { get; set; }
        public string? ProxyAddress { get; set; }
    }

    private async Task SaveProxySettingsAsync()
    {
        try
        {
            var settings = new { UseProxy, ProxyAddress };
            var json = System.Text.Json.JsonSerializer.Serialize(settings);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "dazzconv_proxy_settings", json);
        }
        catch { }
    }

    private async Task TestProxyConnection()
    {
        if (string.IsNullOrWhiteSpace(ProxyAddress))
        {
            await ShowToast("⚠️ Введите адрес прокси", ToastType.Warning);
            return;
        }

        try
        {
            IsTestingProxy = true;
            ProxyTestResult = null;
            StateHasChanged();

            var proxyUrl = FormatProxyUrl(ProxyAddress);
            Downloader.SetProxy(proxyUrl);

            var testUrl = "https://www.youtube.com/watch?v=dQw4w9WgXcQ";
            var success = await Downloader.TestConnectionAsync(testUrl, CancellationToken.None);

            ProxyTestResult = success;
        }
        catch (Exception ex)
        {
            ProxyTestResult = false;
            await ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
        finally
        {
            IsTestingProxy = false;
            StateHasChanged();
        }
    }

    private string FormatProxyUrl(string address)
    {
        if (string.IsNullOrWhiteSpace(address)) return "";

        address = address.Trim();

        // Если уже указан протокол — возвращаем как есть
        if (address.StartsWith("http://") ||
            address.StartsWith("https://") ||
            address.StartsWith("socks5://") ||
            address.StartsWith("socks4://") ||
            address.StartsWith("socks5h://"))
        {
            return address;
        }

        // Разделяем на хост и порт
        var parts = address.Split(':');

        if (parts.Length == 2)
        {
            var host = parts[0];
            var port = parts[1];

            // Определяем тип прокси по порту
            if (port == "1080" || port == "9050" || port == "9150")
            {
                // SOCKS5
                return $"socks5://{host}:{port}";
            }
            else if (port == "8080" || port == "3128" || port == "8888" || port == "80")
            {
                // HTTP
                return $"http://{host}:{port}";
            }
            else if (port == "443")
            {
                // HTTPS
                return $"https://{host}:{port}";
            }
            else
            {
                // По умолчанию — SOCKS5
                return $"socks5://{host}:{port}";
            }
        }

        // Если нет порта — добавляем стандартный
        // Проверяем, похоже ли на домен/IP
        if (address.Contains(".") || address == "localhost")
        {
            return $"socks5://{address}:1080";
        }

        return $"socks5://{address}:1080";
    }

    private void OnTypeChanged(ChangeEventArgs e)
    {
        DownloadType = e.Value?.ToString() ?? "video";
        AvailableFormats.Clear();
        _ = SaveStateAsync();
        StateHasChanged();
    }

    private void SelectFormat(string formatId)
    {
        SelectedFormatId = formatId;
        DownloadType = "custom";
        StateHasChanged();
    }

    private async Task LoadFormats()
    {
        if (string.IsNullOrWhiteSpace(UrlInput))
        {
            await ShowToast("⚠️ Введите ссылку", ToastType.Warning);
            return;
        }

        // Проверка запрещённых сайтов
        if (IsUrlBlocked(UrlInput, out var blockReason))
        {
            await ShowToast($"🚫 {blockReason}", ToastType.Error);
            return;
        }

        try
        {
            IsLoadingFormats = true;
            DownloadProgressText = "🔍 Получение информации о видео...";
            StateHasChanged();

            AvailableFormats = await Downloader.GetAvailableFormatsAsync(UrlInput);

            if (!AvailableFormats.Any())
                await ShowToast("⚠️ Не удалось получить список форматов", ToastType.Warning);
            else
                await ShowToast($"✅ Найдено {AvailableFormats.Count} форматов", ToastType.Success);
        }
        catch (Exception ex)
        {
            await ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
        finally
        {
            IsLoadingFormats = false;
            DownloadProgressText = "";
            StateHasChanged();
        }
    }

    // ===== ИСПРАВЛЕННЫЙ ВЫБОР ПАПКИ через Win32FolderPicker =====
    private async Task ChooseFolder()
    {
        try
        {
#if WINDOWS
            var folder = await Win32FolderPicker.PickFolderAsync("Выберите папку для загрузок");

            if (!string.IsNullOrEmpty(folder) && Directory.Exists(folder))
            {
                DownloadPath = folder;
                Downloader.SetDownloadPath(folder);
                await UpdateCacheSizeAsync();
                await ShowToast($"✅ Папка загрузки: {folder}", ToastType.Success);
            }
#else
            var options = new PickOptions { PickerTitle = "Выберите любой файл, чтобы указать папку" };
            var result = await FilePicker.Default.PickAsync(options);

            if (result != null)
            {
                var folder = Path.GetDirectoryName(result.FullPath);
                if (!string.IsNullOrEmpty(folder))
                {
                    DownloadPath = folder;
                    Downloader.SetDownloadPath(folder);
                    await UpdateCacheSizeAsync();
                }
            }
#endif
        }
        catch (Exception ex)
        {
            await ShowToast($"Ошибка: {ex.Message}", ToastType.Error);
        }
    }

    private async Task StartDownload()
    {
        if (string.IsNullOrWhiteSpace(UrlInput))
        {
            await ShowToast("⚠️ Введите ссылку", ToastType.Warning);
            return;
        }

        // Проверка запрещённых сайтов
        if (IsUrlBlocked(UrlInput, out var blockReason))
        {
            _blockedSiteWarning = blockReason;
            await ShowToast($"🚫 {blockReason}", ToastType.Error);
            StateHasChanged();
            return;
        }

        _blockedSiteWarning = "";

        if (UseProxy && !string.IsNullOrWhiteSpace(ProxyAddress))
            Downloader.SetProxy(FormatProxyUrl(ProxyAddress));
        else
            Downloader.SetProxy(null);

        try
        {
            IsDownloading = true;
            IsCancelling = false;
            Cts = new CancellationTokenSource();
            DownloadProgressText = "Инициализация...";

            string format;
            bool isAudioOnly = false;

            if (DownloadType == "audio")
            {
                format = "bestaudio";
                isAudioOnly = true;
            }
            else if (DownloadType == "custom")
            {
                format = SelectedFormatId;
            }
            else
            {
                format = VideoQuality == "best"
                    ? "best"
                    : $"bestvideo[height<={VideoQuality}]+bestaudio/best[height<={VideoQuality}]";
            }

            var progress = new Progress<string>(line =>
            {
                DownloadProgressText = line;
                InvokeAsync(StateHasChanged);
            });

            if (IsPlaylist)
            {
                var items = await Downloader.DownloadPlaylistAsync(
                    UrlInput, format, isAudioOnly, token: Cts.Token);
                await ShowToast($"✅ Загружено {items.Count} элементов", ToastType.Success);
            }
            else
            {
                CurrentDownload = await Downloader.DownloadAsync(
                    UrlInput, format, isAudioOnly, null, progress, Cts.Token, AudioFormat, AudioBitrate);

                if (CurrentDownload != null)
                {
                    // НОВОЕ: Перечитываем размер файла с диска (на случай если yt-dlp не сообщил)
                    if (!string.IsNullOrEmpty(CurrentDownload.FilePath) && File.Exists(CurrentDownload.FilePath))
                    {
                        try
                        {
                            var fileInfo = new FileInfo(CurrentDownload.FilePath);
                            CurrentDownload.FileSize = fileInfo.Length;
                            Logger.LogInfo($"Downloads: размер файла обновлён: {CurrentDownload.FileSize} байт");
                        }
                        catch { }
                    }

                    // НОВОЕ: Если путь пустой, но файл появился в папке — ищем его
                    if (string.IsNullOrEmpty(CurrentDownload.FilePath) && !string.IsNullOrEmpty(DownloadPath) && Directory.Exists(DownloadPath))
                    {
                        try
                        {
                            // Берём самый свежий файл в папке загрузок
                            var latestFile = Directory.GetFiles(DownloadPath)
                                .Select(f => new FileInfo(f))
                                .Where(f => f.Length > 0 && f.LastWriteTime > DateTime.Now.AddMinutes(-5))
                                .OrderByDescending(f => f.LastWriteTime)
                                .FirstOrDefault();

                            if (latestFile != null)
                            {
                                CurrentDownload.FilePath = latestFile.FullName;
                                CurrentDownload.FileSize = latestFile.Length;
                                Logger.LogInfo($"Downloads: найден последний файл: {latestFile.FullName}");
                            }
                        }
                        catch { }
                    }

                    if (!string.IsNullOrEmpty(CurrentDownload.FilePath))
                    {
                        var fileName = Path.GetFileName(CurrentDownload.FilePath);
                        await ShowToast($"✅ Загружено: {fileName}", ToastType.Success);
                    }
                    else
                    {
                        await ShowToast("⚠️ Загрузка завершена, но файл не найден. Проверьте папку загрузок.", ToastType.Warning);
                    }
                }

                SaveDownloadHistory();
                await UpdateCacheSizeAsync();
            }

            await UpdateCacheSizeAsync();
        }
        catch (OperationCanceledException)
        {
            await ShowToast("⚠️ Загрузка отменена", ToastType.Warning);
        }
        catch (Exception ex)
        {
            await ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
        finally
        {
            IsDownloading = false;
            IsCancelling = false;
            CurrentDownload = null;
            Cts?.Dispose();
            Cts = null;
            StateHasChanged();
        }
    }

