@page "/settings"
@using ConverToDazz.Core.Services
@using DazzConv.Services
@inject UpdateService UpdateService
@inject LoggerService Logger
@inject FFmpegPathService FFmpegService

<PageTitle>Настройки — DazzConv</PageTitle>

<div class="settings-container">
    <!-- Заголовок -->
    <div class="settings-header mb-4">
        <div class="d-flex align-items-center">
            <div class="icon-wrapper me-3">
                <i class="bi bi-gear-fill"></i>
            </div>
            <div>
                <h2 class="mb-1">Настройки</h2>
                <p class="mb-0 text-muted">Управление обновлениями и информация о приложении</p>
            </div>
        </div>
    </div>

    <!-- Карточка обновлений -->
    <div class="card modern-card mb-4 fade-in">
        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <h5 class="mb-0">
                <i class="bi bi-arrow-clockwise me-2 text-primary"></i>Обновления
            </h5>
        </div>
        <div class="card-body px-4 pb-4">
            <!-- Версии -->
            <div class="version-info mb-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="info-box">
                            <div class="info-label">
                                <i class="bi bi-box me-2"></i>Текущая версия
                            </div>
                            <div class="info-value">
                                <span class="badge bg-primary-subtle text-primary fs-6">
                                    @UpdateService.CurrentVersion
                                </span>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_latestVersion))
                    {
                        <div class="col-md-6">
                            <div class="info-box success">
                                <div class="info-label">
                                    <i class="bi bi-stars me-2"></i>Последняя версия
                                </div>
                                <div class="info-value">
                                    <span class="badge bg-success-subtle text-success fs-6">
                                        @_latestVersion
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Статус проверки -->
            @if (_isChecking)
            {
                <div class="action-area text-center py-4">
                    <div class="spinner-wrapper mb-3">
                        <div class="spinner-border spinner-primary" role="status">
                            <span class="visually-hidden">Проверка...</span>
                        </div>
                    </div>
                    <p class="text-muted mb-0">Проверяем наличие обновлений...</p>
                </div>
            }
            else if (_updateAvailable && _pendingUpdate != null)
            {
                <div class="update-available-box mb-3">
                    <div class="d-flex align-items-center">
                        <div class="update-icon me-3">
                            <i class="bi bi-gift-fill"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-1">🎉 Доступно обновление!</h6>
                            <p class="mb-0 text-muted small">
                                Новая версия <strong>@_latestVersion</strong> готова к установке.
                                Приложение обновится автоматически и перезапустится.
                            </p>
                        </div>
                    </div>
                </div>
                <button class="btn btn-install-update w-100" @onclick="InstallUpdate">
                    <i class="bi bi-download me-2"></i>
                    Установить обновление
                    <i class="bi bi-arrow-right ms-2"></i>
                </button>
            }
            else if (_wasChecked && !_updateAvailable)
            {
                <div class="update-current-box mb-3">
                    <div class="d-flex align-items-center">
                        <div class="check-icon me-3">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-1">У вас последняя версия</h6>
                            <p class="mb-0 text-muted small">
                                Вы используете самую актуальную версию DazzConv.
                            </p>
                        </div>
                    </div>
                </div>
                <button class="btn btn-outline-primary w-100" @onclick="CheckForUpdates">
                    <i class="bi bi-arrow-clockwise me-2"></i>Проверить ещё раз
                </button>
            }
            else
            {
                <button class="btn btn-check-update w-100" @onclick="CheckForUpdates">
                    <i class="bi bi-search me-2"></i>
                    Проверить наличие обновлений
                </button>
            }

            @* Сообщение об ошибке *@
            @if (!string.IsNullOrEmpty(_statusMessage) && _isError)
            {
                <div class="alert alert-danger mt-3 mb-0 fade-in">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @_statusMessage
                </div>
            }
        </div>
    </div>

    <!-- Карточка о программе -->
    <div class="card modern-card mb-4 fade-in delay-1">
        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <h5 class="mb-0">
                <i class="bi bi-info-circle me-2 text-info"></i>О программе
            </h5>
        </div>
        <div class="card-body px-4 pb-4">
            <div class="about-section mb-3">
                <div class="d-flex align-items-center mb-3">
                    <div class="app-logo me-3">
                        <span class="logo-text">D</span>
                    </div>
                    <div>
                        <h5 class="mb-0 app-name">DazzConv</h5>
                        <small class="text-muted">Универсальный конвертер медиа файлов</small>
                    </div>
                </div>

                <div class="features-list">
                    <div class="feature-item">
                        <div class="feature-icon audio">
                            <i class="bi bi-music-note-beamed"></i>
                        </div>
                        <div>
                            <div class="feature-name">Аудио конвертер</div>
                            <small class="text-muted">MP3, WAV, FLAC, OGG, AAC, OPUS</small>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon image">
                            <i class="bi bi-image"></i>
                        </div>
                        <div>
                            <div class="feature-name">Конвертер изображений</div>
                            <small class="text-muted">JPG, PNG, WebP, AVIF, BMP, TIFF</small>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon video">
                            <i class="bi bi-camera-video"></i>
                        </div>
                        <div>
                            <div class="feature-name">Видео конвертер</div>
                            <small class="text-muted">MP4, MKV, AVI, MOV • H.264/H.265/VP9</small>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon batch">
                            <i class="bi bi-layers"></i>
                        </div>
                        <div>
                            <div class="feature-name">Пакетная конвертация</div>
                            <small class="text-muted">Тысячи файлов одновременно</small>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon download">
                            <i class="bi bi-cloud-download"></i>
                        </div>
                        <div>
                            <div class="feature-name">Загрузчик видео</div>
                            <small class="text-muted">1800+ сайтов: YouTube, TikTok, Reddit...</small>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-3" />

            <div class="d-flex justify-content-between align-items-center">
                <a href="https://github.com/FalseOracle/DazzConv" target="_blank" class="github-link">
                    <i class="bi bi-github me-2"></i>GitHub проекта
                </a>
                <small class="text-muted">© 2026 FalseOracle</small>
            </div>
        </div>
    </div>

    <!-- Инструменты и обновления: yt-dlp, ffmpeg, deno, PO-провайдер + прокси -->
    <div class="card modern-card mb-4 fade-in">
        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <h5 class="mb-0">
                <i class="bi bi-tools me-2 text-primary"></i>Инструменты и обновления
            </h5>
        </div>
        <div class="card-body px-4 pb-4">
            @if (_overview != null)
            {
                <div class="table-responsive mb-3">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr><th>Компонент</th><th>Установлено</th><th>Доступно</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in _overview)
                            {
                                <tr>
                                    <td>@t.Name</td>
                                    <td><span class="text-muted small">@(t.Installed ?? "не установлен")</span></td>
                                    <td><span class="text-muted small">@(t.Latest ?? "—")</span></td>
                                    <td>
                                        @if (t.UpdateAvailable)
                                        {
                                            <span class="badge bg-warning text-dark">есть обновление</span>
                                        }
                                        else if (t.Latest != null)
                                        {
                                            <span class="badge bg-success">актуально</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="d-flex flex-wrap gap-2 mb-3">
                <button class="btn btn-outline-primary" @onclick="CheckAllToolsAsync" disabled="@_overviewBusy">
                    <i class="bi bi-search me-1"></i>Проверить обновления
                </button>
                <button class="btn btn-primary" @onclick="UpdateAllToolsAsync" disabled="@_overviewBusy">
                    <i class="bi bi-cloud-arrow-down me-1"></i>Обновить всё
                </button>
            </div>

            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="autoFfmpegSwitch"
                       checked="@Tools.AutoUpdateFfmpegEnabled"
                       @onchange="e => Tools.AutoUpdateFfmpegEnabled = (bool)(e.Value ?? false)" />
                <label class="form-check-label" for="autoFfmpegSwitch">
                    Автоматически обновлять ffmpeg, deno и поставщика токенов (ffmpeg — раз в 30 дней, файл около 160 МБ)
                </label>
            </div>

            @if (_overviewBusy && _toolsProgress > 0)
            {
                <div class="progress mb-3" style="height: 8px;"><div class="progress-bar" style="width: @_toolsProgress%"></div></div>
            }
            @if (!string.IsNullOrEmpty(_overviewMessage))
            {
                <div class="alert @(_overviewError ? "alert-danger" : "alert-info") py-2">@_overviewMessage</div>
            }
            @if (_updateReport != null)
            {
                <ul class="list-unstyled small mb-3">
                    @foreach (var line in _updateReport)
                    {
                        <li>@line</li>
                    }
                </ul>
            }

            <hr />
            <h6 class="mb-2"><i class="bi bi-shield-lock me-2"></i>Прокси для обновлений</h6>
            <div class="form-text mb-2">
                Через него приложение обращается к GitHub (обновления программы, yt-dlp, ffmpeg и др.). Настройка сохраняется между запусками.
                Для загрузки видео используется отдельный прокси на странице «Загрузки».
            </div>
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" id="updProxySwitch" @bind="_proxyEnabled" />
                <label class="form-check-label" for="updProxySwitch">Использовать прокси</label>
            </div>
            <div class="input-group mb-2">
                <input type="text" class="form-control" @bind="_proxyAddress" disabled="@(!_proxyEnabled)"
                       placeholder="127.0.0.1:1080 или socks5://127.0.0.1:1080" />
                <button class="btn btn-outline-secondary" @onclick="SaveUpdateProxyAsync">Сохранить</button>
                <button class="btn btn-outline-secondary" @onclick="TestUpdateProxyAsync" disabled="@_overviewBusy">Проверить</button>
            </div>
            <button class="btn btn-sm btn-link p-0 mb-2" @onclick="CopyDownloadsProxyAsync">Взять адрес из настроек загрузок</button>
            @if (!string.IsNullOrEmpty(_proxyMessage))
            {
                <div class="alert @(_proxyOk ? "alert-success" : "alert-warning") py-2 mb-0">@_proxyMessage</div>
            }
        </div>
    </div>

    <!-- Проверка форматов: реальная пробная конвертация каждого формата -->
    <div class="card modern-card mb-4 fade-in">
        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <h5 class="mb-0"><i class="bi bi-patch-check me-2 text-primary"></i>Проверка форматов</h5>
        </div>
        <div class="card-body px-4 pb-4">
            <p class="text-muted small">
                Приложение делает крошечный тестовый файл в каждом формате видео и аудио. Если формат не работает с вашей сборкой ffmpeg,
                он помечается в списках как недоступный — вы не потратите время на конвертацию, которая закончится ошибкой.
                Стоит запустить после обновления ffmpeg.
            </p>
            <button class="btn btn-primary mb-3" @onclick="RunFormatTestAsync" disabled="@_formatTestBusy">
                <i class="bi bi-play-circle me-1"></i>Проверить форматы
            </button>
            @if (!string.IsNullOrEmpty(_formatTestStatus))
            {
                <div class="alert @(_formatTestError ? "alert-warning" : "alert-info") py-2">@_formatTestStatus</div>
            }
            @if (_formatResults != null && _formatResults.Count > 0)
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var r in _formatResults.OrderBy(x => x.Kind).ThenBy(x => x.Ext))
                    {
                        <span class="badge @(r.Ok ? "bg-success" : "bg-danger")" title="@r.Message">
                            @(r.Kind == "video" ? "🎬" : "🎵") .@r.Ext @(r.Ok ? "✓" : "✗")
                        </span>
                    }
                </div>
                @if (_formatResults.Any(r => !r.Ok))
                {
                    <ul class="small text-muted mt-3 mb-0">
                        @foreach (var r in _formatResults.Where(x => !x.Ok))
                        {
                            <li><strong>.@r.Ext</strong>: @r.Message</li>
                        }
                    </ul>
                }
            }
        </div>
    </div>

    <!-- Загрузчик: yt-dlp и PO-токены -->
    <div class="card modern-card mb-4 fade-in">
        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <h5 class="mb-0">
                <i class="bi bi-cloud-download me-2 text-primary"></i>Загрузчик (yt-dlp)
            </h5>
        </div>
        <div class="card-body px-4 pb-4">
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <div class="info-box">
                        <div class="info-label"><i class="bi bi-box me-2"></i>Версия yt-dlp</div>
                        <div class="info-value">
                            <span class="badge bg-primary-subtle text-primary fs-6">@(_tools?.YtDlpVersion ?? "не найден")</span>
                            @if (_tools?.YtDlpOld == true)
                            {
                                <span class="badge bg-warning text-dark ms-2">старше 90 дней</span>
                            }
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_tools?.LatestVersion))
                {
                    <div class="col-md-6">
                        <div class="info-box success">
                            <div class="info-label"><i class="bi bi-stars me-2"></i>Последняя версия</div>
                            <div class="info-value">
                                <span class="badge bg-success-subtle text-success fs-6">@_tools!.LatestVersion</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="autoToolsSwitch"
                       checked="@Tools.AutoUpdateEnabled"
                       @onchange="e => Tools.AutoUpdateEnabled = (bool)(e.Value ?? false)" />
                <label class="form-check-label" for="autoToolsSwitch">
                    Автоматически обновлять yt-dlp при запуске (раз в сутки)
                </label>
            </div>

            <button class="btn btn-check-update w-100 mb-3" @onclick="UpdateYtDlpAsync" disabled="@_toolsBusy">
                <i class="bi bi-arrow-repeat me-2"></i>Проверить и обновить yt-dlp
            </button>

            <div class="info-box mb-3">
                <div class="info-label"><i class="bi bi-key me-2"></i>Поставщик PO-токенов (YouTube в хорошем качестве)</div>
                <div class="info-value">
                    @if (_tools?.PotInstalled == true)
                    {
                        <span class="badge bg-success">установлен</span>
                        <span class="badge @(_tools.PotRunning ? "bg-success" : "bg-secondary") ms-2">@(_tools.PotRunning ? "запущен" : "не запущен")</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">не установлен</span>
                    }
                </div>
            </div>

            <button class="btn btn-outline-primary w-100" @onclick="InstallPotAsync" disabled="@_toolsBusy">
                <i class="bi bi-download me-2"></i>@(_tools?.PotInstalled == true ? "Переустановить / обновить поставщика" : "Скачать и установить поставщика")
            </button>

            @if (_toolsBusy && _toolsProgress > 0)
            {
                <div class="progress mt-3" style="height: 8px;">
                    <div class="progress-bar" style="width: @_toolsProgress%"></div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_toolsMessage))
            {
                <div class="alert @(_toolsError ? "alert-danger" : "alert-info") mt-3 mb-0 py-2">@_toolsMessage</div>
            }

            <p class="small text-muted mt-3 mb-0">
                Без PO-токена YouTube отдаёт только 360p (формат 18). Файлы скачиваются с GitHub (yt-dlp — с проверкой SHA-256)
                в <code>@Tools.ToolsDir</code>; поставщик запускается автоматически вместе с загрузкой и закрывается вместе с приложением.
            </p>
        </div>
    </div>

    <!-- Автообновления -->
    <div class="card modern-card fade-in delay-2">
        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <h5 class="mb-0">
                <i class="bi bi-shield-check me-2 text-success"></i>Автообновления
            </h5>
        </div>
        <div class="card-body px-4 pb-4">
            <div class="autoupdate-info">
                <div class="d-flex align-items-start">
                    <i class="bi bi-info-circle-fill text-info me-3 mt-1"></i>
                    <div>
                        <p class="mb-2"><strong>Как это работает:</strong></p>
                        <ul class="mb-0 small text-muted">
                            <li>При запуске приложение автоматически проверяет наличие новых версий</li>
                            <li>Если доступно обновление — появится уведомление с предложением установить</li>
                            <li>Обновление применяется автоматически, приложение перезапускается</li>
                            <li>Ваши настройки и история загрузок сохраняются</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .settings-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .settings-header {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
        border-radius: 16px;
        padding: 2rem;
        border-left: 5px solid #667eea;
    }

        .settings-header .icon-wrapper {
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2rem;
        }

    body.dark-theme .settings-header h2 {
        color: #fff;
    }

    /* Modern cards */
    .modern-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        background: white;
        overflow: visible;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    body.dark-theme .modern-card {
        background: #1e1e2e;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    }

    .modern-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.12);
    }

    body.dark-theme .modern-card:hover {
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.5);
    }

    /* Animations */
    .fade-in {
        animation: fadeInUp 0.5s ease-out;
    }

    .delay-1 {
        animation-delay: 0.1s;
        animation-fill-mode: both;
    }

    .delay-2 {
        animation-delay: 0.2s;
        animation-fill-mode: both;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Version info */
    .info-box {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
        border-radius: 12px;
        padding: 1rem 1.25rem;
        border: 1px solid rgba(102, 126, 234, 0.2);
    }

        .info-box.success {
            background: linear-gradient(135deg, rgba(25, 135, 84, 0.08) 0%, rgba(40, 167, 69, 0.08) 100%);
            border-color: rgba(25, 135, 84, 0.2);
        }

    body.dark-theme .info-box {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%);
        border-color: rgba(102, 126, 234, 0.3);
    }

        body.dark-theme .info-box.success {
            background: linear-gradient(135deg, rgba(25, 135, 84, 0.15) 0%, rgba(40, 167, 69, 0.15) 100%);
            border-color: rgba(25, 135, 84, 0.3);
        }

    .info-label {
        font-size: 0.85rem;
        color: #666;
        margin-bottom: 0.5rem;
    }

    body.dark-theme .info-label {
        color: #aaa;
    }

    .info-value {
        font-weight: 600;
    }

    /* Spinner */
    .spinner-wrapper {
        display: flex;
        justify-content: center;
    }

    .spinner-primary {
        color: #667eea;
        width: 3rem;
        height: 3rem;
    }

    /* Update boxes */
    .update-available-box,
    .update-current-box {
        background: linear-gradient(135deg, rgba(25, 135, 84, 0.08) 0%, rgba(40, 167, 69, 0.08) 100%);
        border: 1px solid rgba(25, 135, 84, 0.2);
        border-radius: 12px;
        padding: 1.25rem;
    }

    .update-current-box {
        background: linear-gradient(135deg, rgba(13, 110, 253, 0.08) 0%, rgba(102, 126, 234, 0.08) 100%);
        border-color: rgba(13, 110, 253, 0.2);
    }

    body.dark-theme .update-available-box {
        background: linear-gradient(135deg, rgba(25, 135, 84, 0.15) 0%, rgba(40, 167, 69, 0.15) 100%);
        border-color: rgba(25, 135, 84, 0.3);
    }

    body.dark-theme .update-current-box {
