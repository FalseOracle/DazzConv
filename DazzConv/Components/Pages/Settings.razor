@code {
    private YtDlpToolsService Tools => YtDlpToolsService.Instance;

    private bool _isChecking = false;
    private bool _updateAvailable = false;
    private bool _wasChecked = false;
    private bool _isError = false;
    private string? _latestVersion;
    private string? _statusMessage;
    private Velopack.UpdateInfo? _pendingUpdate;

    // ───────── yt-dlp и PO-токены ─────────
    private YtDlpToolsStatus? _tools;
    private bool _toolsBusy;
    private bool _toolsError;
    private int _toolsProgress;
    private string? _toolsMessage;

    // ───── обзор инструментов и прокси обновлений ─────
    private List<YtDlpToolsService.ToolInfo>? _overview;
    private bool _overviewBusy;
    private bool _overviewError;
    private string? _overviewMessage;
    private List<string>? _updateReport;

    private bool _proxyEnabled;
    private string _proxyAddress = "127.0.0.1:1080";
    private string? _proxyMessage;
    private bool _proxyOk;

    protected override async Task OnInitializedAsync()
    {
        var ps = Tools.ProxySettings;
        _proxyEnabled = ps.Enabled;
        _proxyAddress = ps.Address;

        await RefreshToolsAsync(checkLatest: false);
        try { _overview = await Tools.GetOverviewAsync(checkLatest: false); } catch { }
    }

    // ───── проверка форматов ─────
    private List<FormatTestResult>? _formatResults = FfmpegCapabilities.LoadLastResults();
    private bool _formatTestBusy;
    private bool _formatTestError;
    private string? _formatTestStatus;

    private async Task RunFormatTestAsync()
    {
        _formatTestBusy = true; _formatTestError = false; _formatTestStatus = "Запускаю проверку..."; StateHasChanged();
        try
        {
            var progress = new Progress<string>(m => { _formatTestStatus = m; _ = InvokeAsync(StateHasChanged); });
            _formatResults = await FfmpegCapabilities.SelfTestAsync(FFmpegService.GetFFmpegPath(), progress);
            var bad = _formatResults.Count(r => !r.Ok);
            _formatTestError = bad > 0;
            _formatTestStatus = bad == 0
                ? $"Все {_formatResults.Count} форматов работают."
                : $"Не работают: {bad} из {_formatResults.Count}. Они помечены в списках как недоступные.";
        }
        catch (Exception ex)
        {
            _formatTestError = true;
            _formatTestStatus = $"Проверка не удалась: {ex.Message}";
        }
        finally { _formatTestBusy = false; StateHasChanged(); }
    }

    private async Task CheckAllToolsAsync()
    {
        _overviewBusy = true; _overviewError = false; _overviewMessage = "Проверяю обновления..."; _updateReport = null;
        StateHasChanged();
        try
        {
            _overview = await Tools.GetOverviewAsync(checkLatest: true);
            _overviewMessage = _overview.Any(t => t.UpdateAvailable) ? "Найдены обновления — нажмите «Обновить всё»." : "Все компоненты актуальны.";
        }
        catch (Exception ex) { _overviewError = true; _overviewMessage = $"Ошибка проверки: {ex.Message}"; }
        finally { _overviewBusy = false; StateHasChanged(); }
    }

    private async Task UpdateAllToolsAsync()
    {
        _overviewBusy = true; _overviewError = false; _overviewMessage = "Обновляю..."; _updateReport = null; _toolsProgress = 0;
        StateHasChanged();
        try
        {
            var status = new Progress<string>(m => { _overviewMessage = m; _ = InvokeAsync(StateHasChanged); });
            var progress = new Progress<int>(p => { _toolsProgress = p; _ = InvokeAsync(StateHasChanged); });
            _updateReport = await Tools.UpdateAllAsync(status, progress);
            _overviewError = _updateReport.Any(l => l.StartsWith("❌"));
            _overviewMessage = _overviewError ? "Часть компонентов обновить не удалось (см. ниже)." : "Готово.";
            _overview = await Tools.GetOverviewAsync(checkLatest: true);
            await RefreshToolsAsync(checkLatest: false);
        }
        catch (Exception ex) { _overviewError = true; _overviewMessage = $"Ошибка обновления: {ex.Message}"; }
        finally { _overviewBusy = false; _toolsProgress = 0; StateHasChanged(); }
    }

    private void SaveUpdateProxyAsync()
    {
        Tools.SetProxySettings(_proxyEnabled, _proxyAddress);
        UpdateService.ResetManager();
        _proxyOk = true;
        _proxyMessage = _proxyEnabled
            ? "Прокси сохранён и применён к проверке обновлений. Для самой программы он полностью заработает после перезапуска."
            : "Прокси для обновлений выключен.";
    }

    private async Task TestUpdateProxyAsync()
    {
        SaveUpdateProxyAsync();
        _overviewBusy = true; _proxyMessage = "Проверяю доступ к GitHub..."; StateHasChanged();
        var (ok, message) = await Tools.TestProxyAsync();
        _proxyOk = ok; _proxyMessage = message;
        _overviewBusy = false;
    }

    // те же настройки, что на странице «Загрузки» (файл proxy_settings.json)
    private Task CopyDownloadsProxyAsync()
    {
        try
        {
            var path = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData), "DazzConv", "proxy_settings.json");
            if (File.Exists(path))
            {
                using var doc = System.Text.Json.JsonDocument.Parse(File.ReadAllText(path));
                if (doc.RootElement.TryGetProperty("ProxyAddress", out var addr) && addr.GetString() is { Length: > 0 } a)
                {
                    _proxyAddress = a;
                    _proxyEnabled = doc.RootElement.TryGetProperty("UseProxy", out var u) && u.GetBoolean();
                    _proxyOk = true; _proxyMessage = "Адрес взят из настроек загрузок. Нажмите «Сохранить».";
                    return Task.CompletedTask;
                }
            }
            _proxyOk = false; _proxyMessage = "В настройках загрузок прокси пока не задан.";
        }
        catch (Exception ex) { _proxyOk = false; _proxyMessage = $"Не удалось прочитать настройки загрузок: {ex.Message}"; }
        return Task.CompletedTask;
    }

    private async Task RefreshToolsAsync(bool checkLatest)
    {
        try { _tools = await Tools.GetStatusAsync(checkLatest); }
        catch (Exception ex) { Logger.LogWarning($"Настройки: статус загрузчика: {ex.Message}"); }
    }

    private async Task RunToolsTaskAsync(Func<Task> action, string successMessage)
    {
        _toolsBusy = true; _toolsError = false; _toolsProgress = 0; _toolsMessage = null;
        StateHasChanged();
        try
        {
            await action();
            _toolsMessage = successMessage;
        }
        catch (Exception ex)
        {
            _toolsError = true;
            _toolsMessage = $"Ошибка: {ex.Message}";
            Logger.LogError("Настройки: ошибка обновления загрузчика", ex);
        }
        finally
        {
            _toolsBusy = false;
            await RefreshToolsAsync(checkLatest: false);
            StateHasChanged();
        }
    }

    private Task UpdateYtDlpAsync() => RunToolsTaskAsync(async () =>
    {
        var progress = new Progress<int>(p => { _toolsProgress = p; _toolsMessage = $"Загрузка yt-dlp: {p}%"; _ = InvokeAsync(StateHasChanged); });
        var version = await Tools.UpdateYtDlpAsync(progress);
        await RefreshToolsAsync(checkLatest: true);
        _toolsMessage = $"yt-dlp: {version}";
    }, "yt-dlp актуален.");

    private Task InstallPotAsync() => RunToolsTaskAsync(async () =>
    {
        var status = new Progress<string>(m => { _toolsMessage = m; _ = InvokeAsync(StateHasChanged); });
        var progress = new Progress<int>(pct => { _toolsProgress = pct; _ = InvokeAsync(StateHasChanged); });
        await Tools.InstallPotProviderAsync(status, progress);
    }, "Поставщик токенов установлен и запущен. Можно скачивать с YouTube.");

    private async Task CheckForUpdates()
    {
        _isChecking = true;
        _statusMessage = null;
        _isError = false;
        _updateAvailable = false;
        _pendingUpdate = null;
        _wasChecked = false;

        try
        {
            Logger.LogInfo($"=== Проверка обновлений ===");
            Logger.LogInfo($"Путь приложения: {Environment.ProcessPath}");
            Logger.LogInfo($"Текущая версия (UI): {UpdateService.CurrentVersion}");

            var update = await UpdateService.CheckForUpdateAsync();

            if (update != null)
            {
                _pendingUpdate = update;
                _latestVersion = update.TargetFullRelease.Version.ToString();
                _updateAvailable = true;
                Logger.LogInfo($"Доступно обновление: {_latestVersion}");
            }
            else
            {
                Logger.LogInfo("Обновлений не найдено");
                _statusMessage = UpdateService.IsInstalled
                    ? "У вас последняя версия."
                    : "Приложение запущено не из установщика (Setup.exe) — автообновление работает только в установленной версии.";
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _statusMessage = $"Ошибка проверки: {ex.Message}";
            Logger.LogError("Ошибка проверки обновлений", ex);
        }
        finally
        {
            _isChecking = false;
            _wasChecked = true;
        }
    }

    private async Task InstallUpdate()
    {
        if (_pendingUpdate == null) return;

        _statusMessage = "Загрузка обновления... Приложение перезапустится автоматически.";
        _isChecking = true;

        try
        {
            var success = await UpdateService.DownloadAndInstallAsync(_pendingUpdate, percent =>
            {
                _statusMessage = $"Загрузка обновления: {percent}%... Приложение перезапустится автоматически.";
                _ = InvokeAsync(StateHasChanged);
            });
            if (!success)
            {
                _isError = true;
                _statusMessage = "Не удалось установить обновление. Попробуйте позже.";
                _isChecking = false;
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _statusMessage = $"Ошибка: {ex.Message}";
            _isChecking = false;
        }
    }
}