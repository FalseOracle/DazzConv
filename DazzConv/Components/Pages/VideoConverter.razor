    private int? _savedAudioBitrate = 192;
    private int _savedCrf = 23;
    private int _savedQScale = 2;
    private string _savedPreset = "medium";

    // 🆕 КАСТОМНЫЙ FPS
    private bool UseCustomFps = false;
    private int CustomFps = 30;

    private bool IsConverting = false;
