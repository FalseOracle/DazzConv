    // Убраны: ts, gif
};

    private bool IsValidCrf => Crf >= 0 && Crf <= 51;
    private bool IsValidVideoBitrate => !VideoBitrate.HasValue || VideoBitrate.Value > 0;
    private bool IsValidAudioBitrate => !AudioBitrate.HasValue || (AudioBitrate.Value >= 64 && AudioBitrate.Value <= 320);
    private bool IsValidFps => CustomFps >= 1 && CustomFps <= 240;

    protected override void OnInitialized()
    {
        LoadProfiles();
        UpdateCachedDescriptions();
    }

    private void OnOutputFormatChanged(ChangeEventArgs e)
    {
        var newFormat = e.Value?.ToString() ?? "mp4";

        // Если переключаемся В GIF режим
        if (newFormat == "gif" && !_isGifMode)
        {
            // Сохраняем текущие настройки
            _savedVideoCodec = VideoCodec;
            _savedAudioCodec = AudioCodec;
            _savedVideoBitrate = VideoBitrate;
            _savedAudioBitrate = AudioBitrate;
            _savedCrf = Crf;
            _savedQScale = QScale;
            _savedPreset = Preset;

            // Устанавливаем GIF-специфичные настройки
            VideoCodec = "gif";
            AudioCodec = "aac"; // Будет заблокировано
            Crf = 20; // Оптимально для GIF
            Preset = "ultrafast"; // GIF медленный, поэтому ultrafast
            UseCustomFps = true;
            CustomFps = 15; // Стандарт для GIF
            Scale = "640:-1"; // Типичное разрешение для GIF

            _isGifMode = true;

            _ = ShowToast("🎨 GIF режим: аудио отключено, FPS установлен на 15", ToastType.Info);
        }
        // Если переключаемся ИЗ GIF режима
        else if (newFormat != "gif" && _isGifMode)
        {
            // Восстанавливаем сохранённые настройки
            VideoCodec = _savedVideoCodec;
            AudioCodec = _savedAudioCodec;
            VideoBitrate = _savedVideoBitrate;
            AudioBitrate = _savedAudioBitrate;
            Crf = _savedCrf;
            QScale = _savedQScale;
            Preset = _savedPreset;

            _isGifMode = false;
        }

        OutputFormat = newFormat;
        UpdateCachedDescriptions();
        StateHasChanged();
    }

    // 🆕 АСИНХРОННАЯ ПРОВЕРКА NVIDIA - форма не виснет!
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                Hotkeys.OnCancelRequested += HandleCancel;
                await Hotkeys.InitializeAsync();
            }
            catch (Exception ex)
            {
                try { Logger.LogWarning($"Горячие клавиши не инициализированы: {ex.Message}"); } catch { }
            }

            // 🆕 Проверяем NVIDIA в фоне, не блокируя UI
            _ = Task.Run(async () =>
            {
                var available = await CheckNvidiaAvailabilityAsync();
                if (available != _isNvidiaAvailable)
                {
                    _isNvidiaAvailable = available;
                    await InvokeAsync(StateHasChanged);

                    if (available)
                    {
                        Logger.LogInfo("NVIDIA GPU обнаружена, NVENC доступен");
                    }
                }
            });
        }
    }

    private async Task<bool> CheckNvidiaAvailabilityAsync()
    {
        try
        {
            return await Task.Run(() =>
            {
                var psi = new System.Diagnostics.ProcessStartInfo
                {
                    FileName = "nvidia-smi",
                    RedirectStandardOutput = true,
                    RedirectStandardError = true,
                    UseShellExecute = false,
                    CreateNoWindow = true
                };
                using var process = System.Diagnostics.Process.Start(psi);
                if (process == null) return false;

                bool exited = process.WaitForExit(2000);
                return exited && process.ExitCode == 0;
            });
        }
        catch
        {
            return false;
        }
    }

    private void UpdateCachedDescriptions()
    {
        _presetDescription = GetPresetDescription(Preset);
        _crfDescription = GetCrfDescription(Crf);
    }

    private void UpdateOutputFileSize()
    {
        if (string.IsNullOrEmpty(OutputFilePath) || !File.Exists(OutputFilePath))
        {
            _outputFileSize = 0;
            _outputFileSizeFormatted = "";
            return;
        }

        try
        {
            _outputFileSize = new FileInfo(OutputFilePath).Length;
            _outputFileSizeFormatted = FormatBytes(_outputFileSize);
        }
        catch
        {
            _outputFileSize = 0;
            _outputFileSizeFormatted = "";
        }
    }

    private void OpenInputFileLocation()
    {
        if (string.IsNullOrEmpty(InputFilePath))
        {
            _ = ShowToast("⚠️ Путь пустой", ToastType.Warning);
            return;
        }

        if (!File.Exists(InputFilePath))
        {
            var dir = Path.GetDirectoryName(InputFilePath);
            if (!string.IsNullOrEmpty(dir) && Directory.Exists(dir))
            {
                try
                {
                    System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                    {
                        FileName = dir,
                        UseShellExecute = true
                    });
                }
                catch (Exception ex)
                {
                    _ = ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
                }
            }
            return;
        }

        try
        {
            var normalizedPath = Path.GetFullPath(InputFilePath).Replace('/', '\\');
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = "/select,\"" + normalizedPath + "\"",
                UseShellExecute = true
            };
            System.Diagnostics.Process.Start(psi);
        }
        catch (Exception ex)
        {
            _ = ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
    }

    private Task HandleCancel()
    {
        if (IsConverting) CancelConversion();
        return Task.CompletedTask;
    }

