    private string GetPresetDescription(string preset) => preset switch
    {
        "ultrafast" => "⚡ Очень быстро",
        "superfast" => "⚡ Быстро",
        "veryfast" => "⚡ Быстро",
        "faster" => "🏃 Быстрее",
        "fast" => "🏃 Быстро",
        "medium" => "⚖️ Баланс",
        "slow" => "🐢 Медленно",
        "slower" => "🐢 Медленнее",
        "veryslow" => "🐌 Очень медленно",
        _ => preset
    };

    private string GetCrfDescription(int crf)
    {
        if (crf <= 10) return "🌟 Без потерь";
        if (crf <= 18) return "⭐ Отличное";
        if (crf <= 23) return "✅ Стандарт";
        if (crf <= 28) return "👍 Хорошее";
        if (crf <= 35) return "📱 Среднее";
        return "📉 Низкое";
    }

    private string GetProgressStatus(int progress)
    {
        if (progress < 10) return "🔄 Инициализация...";
        if (progress < 30) return "📥 Анализ видео...";
        if (progress < 60) return "🎬 Кодирование...";
        if (progress < 90) return "⚡ Обработка...";
        if (progress < 100) return "✨ Завершение...";
        return "✅ Готово!";
    }

    private string FormatBytes(long bytes)
    {
        const long kb = 1024, mb = kb * 1024, gb = mb * 1024;
        if (bytes >= gb) return $"{(bytes / (double)gb):F2} ГБ";
        if (bytes >= mb) return $"{(bytes / (double)mb):F2} МБ";
        if (bytes >= kb) return $"{(bytes / (double)kb):F2} КБ";
        return $"{bytes} Б";
    }

    private async Task SelectFile()
    {
        try
        {
            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Выберите видео файл"
            });

            if (result == null) return;

            InputFilePath = result.FullPath;
            FileName = Path.GetFileName(InputFilePath);
            var ext = Path.GetExtension(InputFilePath).TrimStart('.').ToLower();

            if (!AllowedVideoExtensions.Contains(ext))
            {
                await ShowToast($"❌ Формат .{ext.ToUpper()} не поддерживается!", ToastType.Error);
                InputFilePath = null;
                FileName = "";
                return;
            }

            var fileInfo = new FileInfo(InputFilePath);
            if (fileInfo.Length == 0)
            {
                await ShowToast("❌ Файл пустой!", ToastType.Error);
                InputFilePath = null;
                FileName = "";
                return;
            }

            if (fileInfo.Length > 10L * 1024 * 1024 * 1024)
            {
                await ShowToast("❌ Файл слишком большой (максимум 10 ГБ)!", ToastType.Error);
                InputFilePath = null;
                FileName = "";
                return;
            }

            Logger.LogInfo($"Видео конвертер: загружен файл - {FileName} ({fileInfo.Length} байт)");

            var info = await InfoService.GetInfoAsync(InputFilePath);
            Duration = info.Duration;
            Codec = info.Codec;
            Resolution = info.Resolution;
            Fps = info.Fps;
            DurationSeconds = info.DurationSeconds;

            IsConverted = false;
            Progress = 0;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError("Видео конвертер: ошибка выбора файла", ex);
            await ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
    }

    private void OnCodecChanged(ChangeEventArgs e)
    {
        VideoCodec = e.Value?.ToString() ?? "libx264";
        if (VideoCodec.Contains("nvenc", StringComparison.OrdinalIgnoreCase)) Preset = "medium";

        // Если выбран GIF - меняем формат и отключаем аудио
        if (VideoCodec == "gif")
        {
            OutputFormat = "gif";
            AudioCodec = "aac"; // всё равно не будет использоваться
        }

        UpdateCachedDescriptions();
        StateHasChanged();
    }

    private void OnCrfChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int v))
        {
            Crf = Math.Max(0, Math.Min(51, v));
            _crfDescription = GetCrfDescription(Crf);
        }
    }

    private void OnQScaleChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int v)) QScale = Math.Max(1, Math.Min(31, v));
    }

    private void OnVideoBitrateChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(val)) VideoBitrate = null;
        else if (int.TryParse(val, out int p)) VideoBitrate = p >= 0 ? p : null;
    }

    private void OnAudioBitrateSliderChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int p)) AudioBitrate = Math.Max(64, Math.Min(320, p));
    }

    private async Task StartConversion()
    {
        if (string.IsNullOrEmpty(InputFilePath)) { await ShowToast("⚠️ Выберите файл", ToastType.Warning); return; }
        if (!IsValidCrf) { await ShowToast("❌ CRF должен быть от 0 до 51", ToastType.Error); return; }
        if (!IsValidVideoBitrate) { await ShowToast("❌ Видео битрейт должен быть положительным", ToastType.Error); return; }
        if (!IsValidAudioBitrate) { await ShowToast("❌ Аудио битрейт должен быть от 64 до 320", ToastType.Error); return; }
        if (UseCustomFps && !IsValidFps) { await ShowToast("❌ FPS должен быть от 1 до 240", ToastType.Error); return; }

        try
        {
            var baseName = Path.GetFileNameWithoutExtension(FileName);
            var suggestedName = $"{baseName}_converted.{OutputFormat}";
            var savePath = await ChooseSaveFile(suggestedName);

            if (string.IsNullOrEmpty(savePath)) { await ShowToast("⚠️ Сохранение отменено", ToastType.Warning); return; }
            OutputFilePath = savePath;
        }
        catch (Exception ex)
        {
            await ShowToast($"❌ Ошибка выбора пути: {ex.Message}", ToastType.Error);
            return;
        }

        IsConverting = true;
        IsConverted = false;
        Progress = 0;
        _outputFileSize = 0;
        _outputFileSizeFormatted = "";
        Cts = new CancellationTokenSource();

        // 🆕 ПЕРЕДАЁМ FPS
        var fpsValue = UseCustomFps ? CustomFps.ToString() : "";

        var options = new VideoConversionOptions
        {
            VideoCodec = VideoCodec,
            AudioCodec = AudioCodec,
            VideoBitrate = VideoBitrate,
            AudioBitrate = AudioBitrate,
            Crf = Crf,
            QScale = QScale,
            Preset = Preset,
            Scale = Scale,
            Fps = fpsValue
        };

        var progressReporter = new Progress<int>(value =>
        {
            var newProgress = Math.Max(0, Math.Min(100, value));
            if (newProgress != Progress)
            {
                Progress = newProgress;
                _progressStatus = GetProgressStatus(Progress);
                InvokeAsync(StateHasChanged);
            }
        });

        try
        {
            await VideoService.ConvertAsync(InputFilePath, OutputFilePath, DurationSeconds, progressReporter, options, Cts.Token);

            IsConverted = true;
            UpdateOutputFileSize();
            Logger.LogInfo($"Видео конвертер: завершена - {FileName} -> {Path.GetFileName(OutputFilePath)}");
            await ShowToast("✅ Конвертация завершена!", ToastType.Success);
        }
        catch (OperationCanceledException)
        {
            Logger.LogInfo("Видео конвертер: отменена");
            await ShowToast("⚠️ Конвертация отменена", ToastType.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogError("Видео конвертер: ошибка", ex);
            await ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
        finally
        {
            IsConverting = false;
            StateHasChanged();
        }
    }

    private async Task<string?> ChooseSaveFile(string suggestedName)
    {
        try
        {
            var folder = await Win32FolderPicker.PickFolderAsync("Выберите папку для сохранения");
            if (!string.IsNullOrEmpty(folder)) return Path.Combine(folder, suggestedName);
            return null;
        }
        catch
        {
            var dir = Path.GetDirectoryName(InputFilePath);
            if (!string.IsNullOrEmpty(dir)) return Path.Combine(dir, suggestedName);
            return null;
        }
    }

    private void CancelConversion() => Cts?.Cancel();

    private void OpenFolder()
    {
        if (string.IsNullOrEmpty(OutputFilePath) || !File.Exists(OutputFilePath)) return;

        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = $"/select,\"{OutputFilePath}\"",
                UseShellExecute = true
            };
            System.Diagnostics.Process.Start(psi);
        }
        catch (Exception ex)
        {
            Logger.LogError("Ошибка открытия папки", ex);
        }
    }

    private void ResetConverter()
    {
        InputFilePath = null;
        FileName = "";
        Duration = "";
        Codec = "";
        Resolution = "";
        Fps = "";
        OutputFormat = "mp4";
        VideoCodec = "libx264";
        AudioCodec = "aac";
        VideoBitrate = null;
        AudioBitrate = 192;
        Crf = 23;
        QScale = 2;
        Preset = "medium";
        Scale = "";
        UseCustomFps = false;
        CustomFps = 30;
        IsConverting = false;
        IsConverted = false;
        Progress = 0;
        OutputFilePath = null;
        _showFileDetailsModal = false;
        _outputFileSize = 0;
        _outputFileSizeFormatted = "";
        UpdateCachedDescriptions();
        Cts?.Dispose();
        Cts = null;
        _isGifMode = false;  
        _savedVideoCodec = "libx264";
        _savedAudioCodec = "aac";
        StateHasChanged();
    }

    private void LoadProfiles()
    {
        var profilesFile = GetProfilesFilePath();
        if (File.Exists(profilesFile))
        {
            try
            {
                var json = File.ReadAllText(profilesFile);
                Profiles = System.Text.Json.JsonSerializer.Deserialize<List<VideoProfile>>(json) ?? new List<VideoProfile>();
                StateHasChanged();
            }
            catch
            {
                Profiles = new List<VideoProfile>();
            }
        }
    }

    private async Task SaveProfile()
    {
        if (string.IsNullOrWhiteSpace(NewProfileName))
        {
            await ShowToast("⚠️ Введите имя профиля!", ToastType.Warning);
            return;
        }
        if (Profiles.Any(p => p.Name.Equals(NewProfileName, StringComparison.OrdinalIgnoreCase)))
        {
            await ShowToast($"⚠️ Профиль '{NewProfileName}' уже существует!", ToastType.Warning);
            return;
        }

        Profiles.Add(new VideoProfile
        {
            Name = NewProfileName,
            VideoCodec = VideoCodec,
            AudioCodec = AudioCodec,
            VideoBitrate = VideoBitrate,
            AudioBitrate = AudioBitrate,
            Crf = Crf,
            QScale = QScale,
            Preset = Preset,
            Scale = Scale,
            Fps = UseCustomFps ? CustomFps.ToString() : ""
        });
        SaveProfilesToFile();
        var name = NewProfileName;
        NewProfileName = "";
        await ShowToast($"✅ Профиль '{name}' сохранен!", ToastType.Success);
    }

    private void ApplyProfileByName(string? profileName)
    {
        if (string.IsNullOrEmpty(profileName)) return;
        var profile = Profiles.FirstOrDefault(p => p.Name == profileName);
        if (profile != null)
        {
            VideoCodec = profile.VideoCodec ?? "libx264";
            AudioCodec = profile.AudioCodec ?? "aac";
            VideoBitrate = profile.VideoBitrate;
            AudioBitrate = profile.AudioBitrate;
            Crf = profile.Crf ?? 23;
            QScale = profile.QScale ?? 2;
            Preset = profile.Preset ?? "medium";
            Scale = profile.Scale ?? "";

            // 🆕 ВОССТАНАВЛИВАЕМ FPS
            if (!string.IsNullOrEmpty(profile.Fps) && int.TryParse(profile.Fps, out int fps))
            {
                UseCustomFps = true;
                CustomFps = fps;
            }
            else
            {
                UseCustomFps = false;
                CustomFps = 30;
            }

            UpdateCachedDescriptions();
            StateHasChanged();
            _ = ShowToast($"✅ Применён профиль: {profileName}", ToastType.Success);
        }
    }

    private async Task DeleteProfileByName(string profileName)
    {
        var profile = Profiles.FirstOrDefault(p => p.Name == profileName);
        if (profile != null)
        {
            Profiles.Remove(profile);
            SaveProfilesToFile();
            await ShowToast($"✅ Профиль '{profileName}' удален!", ToastType.Success);
        }
    }

    private string GetProfilesFilePath()
    {
        var appDataPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData), "DazzConv");
        if (!Directory.Exists(appDataPath)) Directory.CreateDirectory(appDataPath);
        return Path.Combine(appDataPath, "profiles.json");
    }

    private void SaveProfilesToFile()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(Profiles, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            File.WriteAllText(GetProfilesFilePath(), json);
        }
        catch (Exception ex)
        {
            Logger.LogError("Ошибка сохранения профилей", ex);
        }
    }

    private async Task ShowToast(string message, ToastType type = ToastType.Info)
    {
        try { await JSRuntime.InvokeVoidAsync("showToast", message, type.ToString().ToLower()); }
        catch { await JSRuntime.InvokeVoidAsync("alert", message); }
    }

    private enum ToastType { Success, Error, Warning, Info }
}