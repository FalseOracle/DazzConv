    // DVD/Старые
    "mpeg", "mpg", "vob", "gif" 

};

    private List<VideoProfile> Profiles = new();
    private string NewProfileName = "";

    // Кэшированные значения
    private bool _isNvidiaAvailable = false;
    private string _presetDescription = "⚖️ Баланс";
    private string _crfDescription = "✅ Стандарт";
    private string _progressStatus = "🔄 Инициализация...";
    private long _outputFileSize = 0;
    private string _outputFileSizeFormatted = "";

    private bool _showFileDetailsModal = false;

    private readonly string[] AllowedVideoExtensions = {
    "mp4", "avi", "mkv", "mov", "wmv", "flv", "webm",
