@page "/video"
@using ConverToDazz.Core.Services
@using ConverToDazz.Core.Models
@using DazzConv.Services
@inject IVideoConverterService VideoService
@inject VideoInfoService InfoService
@inject FFmpegPathService FFmpegService
@inject IJSRuntime JSRuntime
@inject LoggerService Logger
@inject HotkeyService Hotkeys

<h3 class="text-center mb-4">Видео Конвертер</h3>

<div class="card mb-4">
    <div class="card-body text-center">
        <button class="btn btn-primary btn-lg" @onclick="SelectFile">
            <i class="bi bi-camera-video"></i> Выбрать видео файл
        </button>
        <p class="text-muted mt-2 mb-0">
            13 форматов: MP4, MKV, AVI, MOV, WMV, FLV, WebM, M4V, 3GP, MPEG, MPG, VOB, GIF
        </p>
    </div>
</div>

@if (!string.IsNullOrEmpty(FileName))
{
    <div class="row">
        <!-- КОМПАКТНАЯ КАРТОЧКА ФАЙЛА -->
        <div class="col-md-12 mb-4">
            <div class="file-card">
                <div class="file-card-icon video">
                    <i class="bi bi-camera-video-fill"></i>
                </div>
                <div class="file-card-info">
                    <div class="file-card-name" title="@FileName">@FileName</div>
                    <div class="file-card-meta">
                        <span><i class="bi bi-clock"></i> @Duration</span>
                        <span><i class="bi bi-aspect-ratio"></i> @Resolution</span>
                        <span><i class="bi bi-film"></i> @Fps fps</span>
                        <span class="badge bg-@GetCodecBadgeColor(Codec)">@Codec</span>
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-primary" @onclick="ShowFileDetails" title="Подробная информация">
                    <i class="bi bi-info-circle"></i> Детали
                </button>
            </div>
        </div>

        <!-- БЫСТРЫЕ ПРЕСЕТЫ -->
        <div class="col-md-12 mb-4">
            <div class="card border-info">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">⚡ Быстрые настройки</h5>
                </div>
                <div class="card-body p-0">
                    <div class="preset-tips">
                        <div class="preset-tip-item" @onclick="@(() => ApplyQuickPreset("web"))">
                            <div class="preset-tip-icon web">
                                <i class="bi bi-globe"></i>
                            </div>
                            <div class="preset-tip-info">
                                <div class="preset-tip-name">
                                    Для интернета
                                    <span class="badge bg-primary ms-1">H.264</span>
                                </div>
                                <div class="preset-tip-desc">MP4, H.264, AAC • Совместимо со всеми устройствами</div>
                            </div>
                        </div>

                        <div class="preset-tip-item" @onclick="@(() => ApplyQuickPreset("quality"))">
                            <div class="preset-tip-icon quality">
                                <i class="bi bi-stars"></i>
                            </div>
                            <div class="preset-tip-info">
                                <div class="preset-tip-name">
                                    Максимальное качество
                                    <span class="badge bg-warning text-dark ms-1">H.265</span>
                                </div>
                                <div class="preset-tip-desc">MKV, H.265 CRF 18 • Для архива и просмотра</div>
                            </div>
                        </div>

                        <div class="preset-tip-item" @onclick="@(() => ApplyQuickPreset("fast"))">
                            <div class="preset-tip-icon fast">
                                <i class="bi bi-lightning"></i>
                            </div>
                            <div class="preset-tip-info">
                                <div class="preset-tip-name">Быстрая конвертация</div>
                                <div class="preset-tip-desc">MP4, H.264 Ultrafast • Когда нужно срочно</div>
                            </div>
                        </div>

                        <div class="preset-tip-item" @onclick="@(() => ApplyQuickPreset("mobile"))">
                            <div class="preset-tip-icon mobile">
                                <i class="bi bi-phone"></i>
                            </div>
                            <div class="preset-tip-info">
                                <div class="preset-tip-name">Для телефона</div>
                                <div class="preset-tip-desc">MP4 720p, H.264 • Компактный размер</div>
                            </div>
                        </div>

                        @if (_isNvidiaAvailable)
                        {
                            <div class="preset-tip-item" @onclick="@(() => ApplyQuickPreset("nvenc"))">
                                <div class="preset-tip-icon nvenc">
                                    <i class="bi bi-gpu-card"></i>
                                </div>
                                <div class="preset-tip-info">
                                    <div class="preset-tip-name">
                                        NVIDIA NVENC
                                        <span class="badge bg-success ms-1">GPU</span>
                                    </div>
                                    <div class="preset-tip-desc">Аппаратное ускорение • В 5-10 раз быстрее</div>
                                </div>
                            </div>
                        }

                        <div class="preset-tip-item" @onclick="@(() => ApplyQuickPreset("meme"))">
                            <div class="preset-tip-icon meme">
                                <i class="bi bi-emoji-laughing"></i>
                            </div>
                            <div class="preset-tip-info">
                                <div class="preset-tip-name">
                                    Мемный
                                    <span class="badge bg-secondary ms-1">320×240</span>
                                </div>
                                <div class="preset-tip-desc">Минимальный размер, 15 FPS • Для Discord/мемов</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Основные настройки -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">🎬 Видео настройки</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Выходной формат</label>
                        <select class="form-select" value="@OutputFormat" @onchange="OnOutputFormatChanged">
                            @foreach (var format in Formats)
                            {
                                <option value="@format">@format.ToUpper() — @GetFormatDescription(format)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Видео кодек</label>
                        <select class="form-select" value="@VideoCodec" @onchange="OnCodecChanged">
                            <option value="libx264">H.264 (libx264) — универсальный</option>
                            <option value="libx265">H.265/HEVC (libx265) — лучшее сжатие</option>
                            <option value="libvpx-vp9">VP9 (libvpx-vp9) — для WebM</option>
                            <option value="mpeg4">MPEG-4 — старая совместимость</option>
                            <option value="gif">GIF (анимация)</option>
                            @if (_isNvidiaAvailable)
                            {
                                <option value="h264_nvenc">H.264 NVENC (NVIDIA GPU)</option>
                                <option value="hevc_nvenc">HEVC NVENC (NVIDIA GPU)</option>
                            }

                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Preset (скорость кодирования)
                            <span class="text-muted small ms-2">@_presetDescription</span>
                        </label>
                        <select class="form-select" @bind="Preset" @bind:after="() => { _presetDescription = GetPresetDescription(Preset); }">
                            @if (VideoCodec.Contains("nvenc", StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="fast">Fast (быстро)</option>
                                <option value="medium" selected>Medium (баланс)</option>
                                <option value="slow">Slow (медленно, лучше качество)</option>
                            }
                            else
                            {
                                <option value="ultrafast">Ultrafast (очень быстро)</option>
                                <option value="superfast">Superfast</option>
                                <option value="veryfast">Veryfast</option>
                                <option value="faster">Faster</option>
                                <option value="fast">Fast</option>
                                <option value="medium" selected>Medium (баланс)</option>
                                <option value="slow">Slow</option>
                                <option value="slower">Slower</option>
                                <option value="veryslow">Veryslow (лучшее качество)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Разрешение</label>
                        <input type="text" class="form-control" @bind="Scale" placeholder="Оставьте пустым для оригинала" />
                        <div class="form-text">Примеры: 1920x1080, 1280x720, 640x480, 320x240</div>
                    </div>

                    <!-- 🆕 FPS С КАСТОМНЫМ ВВОДОМ -->
                    <div class="mb-3">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" @bind="UseCustomFps"
                                   id="customFpsCheck" disabled="@_isGifMode" />
                            <label class="form-check-label" for="customFpsCheck">
                                Изменить FPS @(_isGifMode ? "(15 fps для GIF)" : "")
                            </label>
                        </div>

                        @if (UseCustomFps)
                        {
                            <div class="input-group">
                                <input type="number"
                                       class="form-control @(IsValidFps ? "" : "is-invalid")"
                                       @bind="CustomFps"
                                       min="1" max="240" step="1"
                                       placeholder="24"
                                       disabled="@_isGifMode" />
                                <span class="input-group-text">fps</span>
                                @if (!IsValidFps)
                                {
                                    <div class="invalid-feedback">FPS: 1-240</div>
                                }
                            </div>
                            @if (!_isGifMode)
                            {
                                <div class="d-flex flex-wrap gap-1 mt-2">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => CustomFps = 15">15</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => CustomFps = 24">24</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => CustomFps = 25">25</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => CustomFps = 30">30</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => CustomFps = 60">60</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => CustomFps = 120">120</button>
                                </div>
                            }
                            <div class="form-text">Оригинал: @Fps fps @(_isGifMode ? "• GIF: 15 fps" : "")</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Аудио и качество -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">🎵 Аудио и качество</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Аудио кодек</label>
                        <select class="form-select" @bind="AudioCodec" disabled="@(VideoCodec == "gif")">
                            <option value="aac">AAC (рекомендуется)</option>
                            <option value="libmp3lame">MP3</option>
                            <option value="libvorbis">Vorbis (для WebM)</option>
                            <option value="pcm_s16le">PCM (без сжатия)</option>
                            <option value="copy">Копировать (без перекодирования)</option>
                        </select>
                        @if (_isGifMode)
                        {
                            <div class="form-text text-warning mt-1">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                GIF не поддерживает аудио
                            </div>
                        }
                    </div>

                    @if (VideoCodec == "libx264" || VideoCodec == "libx265" || VideoCodec.Contains("nvenc") || VideoCodec == "libvpx-vp9")
                    {
                        <div class="mb-3">
                            <label class="form-label">
                                CRF (качество): <strong>@Crf</strong>
                                <span class="text-muted small ms-2">@_crfDescription</span>
                            </label>
                            <input type="range" class="form-range" min="0" max="51" step="1"
                                   value="@Crf" @oninput="OnCrfChanged" disabled="@_isGifMode" />
                            <div class="d-flex justify-content-between small">
                                <span class="text-muted">Без потерь (0)</span>
                                <span class="text-muted">Стандарт (23)</span>
                                <span class="text-muted">Худшее (51)</span>
                            </div>
                            @if (_isGifMode)
                            {
                                <div class="alert alert-info mt-2 mb-0 py-2 small d-flex align-items-center">
                                    <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                                    <div>
                                        <strong>🎨 Режим GIF активирован</strong><br />
                                        <small>
                                            • Аудио отключено<br />
                                            • FPS: 15 (оптимально для GIF)<br />
                                            • Разрешение: 640px (рекомендуется)<br />
                                            • Используется палитра 256 цветов
                                        </small>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (VideoCodec == "mpeg4")
                    {
                        <div class="mb-3">
                            <label class="form-label">QScale (качество): @QScale</label>
                            <input type="range" class="form-range" min="1" max="31" step="1" value="@QScale" @oninput="OnQScaleChanged" />
                            <div class="d-flex justify-content-between small">
                                <span class="text-muted">Лучшее (1)</span>
                                <span class="text-muted">Худшее (31)</span>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Видео битрейт (kbps)</label>
                        <input type="number"
                               class="form-control @(IsValidVideoBitrate ? "" : "is-invalid")"
                               value="@VideoBitrate"
                               @onchange="OnVideoBitrateChanged"
                               min="0"
                               placeholder="Оставьте пустым для CRF" />
                        <div class="form-text">Альтернатива CRF. Например: 3000, 5000, 8000</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label d-block text-center mb-2">
                            <strong>Аудио битрейт: @AudioBitrate kbps</strong>
                        </label>
                        <div class="bitrate-slider-wrapper">
                            <input type="range"
                                   class="custom-bitrate-range"
                                   min="64"
                                   max="320"
                                   step="32"
                                   value="@AudioBitrate"
                                   @oninput="OnAudioBitrateSliderChanged" />
                            <div class="slider-ticks">
                                <span>64</span>
                                <span>320</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ПРОФИЛИ -->
        <div class="col-md-12 mb-4">
            <div class="card border-secondary">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">💾 Мои профили</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3 g-2 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label small mb-1">Сохранить текущие настройки как профиль:</label>
                            <input type="text" class="form-control" @bind="NewProfileName" placeholder="Название профиля..." />
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-info w-100" @onclick="SaveProfile" disabled="@string.IsNullOrWhiteSpace(NewProfileName)">
                                <i class="bi bi-save me-1"></i> Сохранить
                            </button>
                        </div>
                    </div>

                    @if (Profiles.Any())
                    {
                        <div class="profiles-grid">
                            @foreach (var profile in Profiles)
                            {
                                <div class="profile-card" @onclick="() => ApplyProfileByName(profile.Name)">
                                    <div class="profile-card-header">
                                        <div class="profile-card-name">@profile.Name</div>
                                        <button class="btn btn-sm btn-outline-danger profile-delete-btn"
                                                @onclick="() => DeleteProfileByName(profile.Name)"
                                                @onclick:stopPropagation="true"
                                                title="Удалить профиль">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                    <div class="profile-card-badges">
                                        @if (!string.IsNullOrEmpty(profile.VideoCodec))
                                        {
                                            <span class="badge bg-primary">@GetCodecDisplayName(profile.VideoCodec)</span>
                                        }
                                        @if (!string.IsNullOrEmpty(profile.Scale))
                                        {
                                            <span class="badge bg-info">@profile.Scale</span>
                                        }
                                        @if (profile.Crf.HasValue)
                                        {
                                            <span class="badge bg-success">CRF @profile.Crf</span>
                                        }
                                        @if (!string.IsNullOrEmpty(profile.Preset))
                                        {
                                            <span class="badge bg-secondary">@profile.Preset</span>
                                        }
                                        @if (!string.IsNullOrEmpty(profile.Fps))
                                        {
                                            <span class="badge bg-warning text-dark">@profile.Fps fps</span>
                                        }
                                    </div>
                                    <div class="profile-card-footer">
                                        <small class="text-muted">
                                            <i class="bi bi-mouse"></i> Клик для применения
                                        </small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">
                            <i class="bi bi-inbox fs-1"></i>
                            <p class="mb-0">Нет сохранённых профилей</p>
                            <small>Настройте параметры и сохраните как профиль</small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Кнопки управления -->
        <div class="col-md-12 mb-4">
            <div class="card">
                <div class="card-body text-center">
                    <button class="btn btn-success btn-lg me-2" @onclick="StartConversion" disabled="@IsConverting">
                        <i class="bi bi-play-circle"></i> @(IsConverting ? "Конвертация..." : "Начать конвертацию")
                    </button>
                    <button class="btn btn-danger btn-lg" @onclick="CancelConversion" disabled="@(!IsConverting)">
                        <i class="bi bi-x-circle"></i> Отмена
                    </button>
                </div>
            </div>
        </div>

        <!-- Прогресс -->
        @if (IsConverting || Progress > 0)
        {
            <div class="col-md-12 mb-4">
                <div class="card border-warning">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            @if (IsConverting)
                            {
                                <div class="spinner-border text-warning" role="status">
                                    <span class="visually-hidden">Загрузка...</span>
                                </div>
                            }
                            <div>
                                <h5 class="mb-0">⏳ @(IsConverting ? "Конвертация видео..." : "Завершено!")</h5>
                                <small class="text-muted">@_progressStatus</small>
                            </div>
                        </div>
                        <div class="progress" style="height: 30px;">
                            <div class="progress-bar progress-bar-striped @(IsConverting ? "progress-bar-animated" : "") bg-warning text-dark"
                                 role="progressbar" style="width: @Progress%">
                                <strong>@Progress%</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Результат -->
        @if (IsConverted && !string.IsNullOrEmpty(OutputFilePath))
        {
            <div class="col-md-12 mb-4">
                <div class="card border-success">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="success-icon me-3">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 text-success">Конвертация завершена!</h6>
                                <small class="text-muted">
                                    Файл: @Path.GetFileName(OutputFilePath)
                                    @if (_outputFileSize > 0)
                                    {
                                        <span> • @_outputFileSizeFormatted</span>
                                    }
                                </small>
                            </div>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-outline-primary" @onclick="OpenFolder">
                                <i class="bi bi-folder2-open me-2"></i>Открыть папку
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="ResetConverter">
                                <i class="bi bi-arrow-clockwise me-2"></i>Новый файл
                            </button>
                        </div>

                        <div class="mt-3 small text-muted">
                            <i class="bi bi-check-circle text-success me-1"></i>
                            Сохранено: @OutputFilePath
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- МОДАЛЬНОЕ ОКНО -->
@if (_showFileDetailsModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content details-modal">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-info-circle me-2"></i>Информация о видео
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseFileDetails"></button>
                </div>
                <div class="modal-body">
                    <div class="details-title mb-3">
                        <div class="d-flex align-items-center">
                            <div class="file-modal-icon video me-3">
                                <i class="bi bi-camera-video-fill"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">@FileName</h6>
                                <small class="text-muted">Исходный видео файл</small>
                            </div>
                        </div>
                    </div>

                    <div class="details-table">
                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-file-earmark text-primary"></i> Формат
                            </div>
                            <div class="detail-value">
                                <span class="badge bg-@GetCodecBadgeColor(Codec) fs-6">@Codec</span>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-clock text-info"></i> Длительность
                            </div>
                            <div class="detail-value">
                                <strong>@Duration</strong>
                                <small class="text-muted ms-2">(@DurationSeconds.ToString("F1") секунд)</small>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-aspect-ratio text-success"></i> Разрешение
                            </div>
                            <div class="detail-value">
                                <strong>@Resolution</strong>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-film text-warning"></i> Частота кадров
                            </div>
                            <div class="detail-value">
                                <strong>@Fps fps</strong>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-folder text-secondary"></i> Путь
                            </div>
                            <div class="detail-value">
                                <div class="d-flex align-items-start gap-2">
                                    <span class="text-break flex-grow-1" title="@InputFilePath">
                                        @InputFilePath
                                    </span>
                                    <button class="btn btn-sm btn-outline-secondary flex-shrink-0"
                                            @onclick="@(() => CopyToClipboard(InputFilePath ?? string.Empty))"
                                            title="Скопировать путь">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
