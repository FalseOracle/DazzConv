    // 🆕 АСИНХРОННАЯ ПРОВЕРКА NVIDIA - форма не виснет!
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                Hotkeys.OnCancelRequested += HandleCancel;
                await Hotkeys.InitializeAsync();
            }
            catch (Exception ex)
            {
                try { Logger.LogWarning($"Горячие клавиши не инициализированы: {ex.Message}"); } catch { }
            }

            // 🆕 Проверяем NVIDIA в фоне, не блокируя UI
            _ = Task.Run(async () =>
            {
                var available = await CheckNvidiaAvailabilityAsync();
                if (available != _isNvidiaAvailable)
                {
                    _isNvidiaAvailable = available;
                    await InvokeAsync(StateHasChanged);

                    if (available)
                    {
                        Logger.LogInfo("NVIDIA GPU обнаружена, NVENC доступен");
                    }
                }
            });
        }
    }

    private async Task<bool> CheckNvidiaAvailabilityAsync()
    {
        try
        {
            return await Task.Run(() =>
            {
                var psi = new System.Diagnostics.ProcessStartInfo
                {
                    FileName = "nvidia-smi",
                    RedirectStandardOutput = true,
                    RedirectStandardError = true,
                    UseShellExecute = false,
                    CreateNoWindow = true
                };
                using var process = System.Diagnostics.Process.Start(psi);
                if (process == null) return false;

                bool exited = process.WaitForExit(2000);
                return exited && process.ExitCode == 0;
            });
        }
        catch
        {
            return false;
        }
    }

    private void UpdateCachedDescriptions() { }   // описания теперь строятся внутри общей формы

    private void UpdateOutputFileSize()
    {
        if (string.IsNullOrEmpty(OutputFilePath) || !File.Exists(OutputFilePath))
        {
            _outputFileSize = 0;
            _outputFileSizeFormatted = "";
            return;
        }

        try
        {
            _outputFileSize = new FileInfo(OutputFilePath).Length;
            _outputFileSizeFormatted = FormatBytes(_outputFileSize);
        }
        catch
        {
            _outputFileSize = 0;
            _outputFileSizeFormatted = "";
        }
    }

    private void OpenInputFileLocation()
    {
        if (string.IsNullOrEmpty(InputFilePath))
        {
            _ = ShowToast("⚠️ Путь пустой", ToastType.Warning);
            return;
        }

        if (!File.Exists(InputFilePath))
        {
            var dir = Path.GetDirectoryName(InputFilePath);
            if (!string.IsNullOrEmpty(dir) && Directory.Exists(dir))
            {
                try
                {
                    System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                    {
                        FileName = dir,
                        UseShellExecute = true
                    });
                }
                catch (Exception ex)
                {
                    _ = ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
                }
            }
            return;
        }

        try
        {
            var normalizedPath = Path.GetFullPath(InputFilePath).Replace('/', '\\');
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = "/select,\"" + normalizedPath + "\"",
                UseShellExecute = true
            };
            System.Diagnostics.Process.Start(psi);
        }
        catch (Exception ex)
        {
            _ = ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
    }

