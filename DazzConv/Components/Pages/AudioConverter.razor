    {
        InputFilePath = null;
        FileName = "";
        InputFormat = "";
        OutputFormat = "mp3";
        OutputBitrate = 192;
        SampleRate = 0;
        NormalizeAudio = false;
        Mono = false;
        IsConverting = false;
        IsConverted = false;
        Progress = 0;
        ConversionStatus = "Готов к работе";
        _outputFilePath = "";
        _outputFileSize = 0;
        OriginalSize = 0;
        _showFileDetailsModal = false;
