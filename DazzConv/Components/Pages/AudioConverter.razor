    private string GetConversionStatusText()
    {
        if (Progress < 10) return "🔄 Инициализация...";
        if (Progress < 30) return "📥 Чтение файла...";
        if (Progress < 50) return "🎵 Кодирование...";
        if (Progress < 75) return "⚡ Обработка...";
        if (Progress < 95) return "💾 Запись файла...";
        if (Progress < 100) return "✨ Завершение...";
        return "✅ Готово!";
    }

