@page "/audio"
@implements IDisposable
@using ConverToDazz.Core.Services
@using ConverToDazz.Core.Models
@using DazzConv.Services
@using DazzConv.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@inject AudioConverterService AudioService
@inject FFmpegPathService FFmpegService
@inject LoggerService Logger
@inject IJSRuntime JSRuntime
@inject HotkeyService Hotkeys

<h3 class="text-center mb-4">Аудио Конвертер</h3>

<div class="card mb-4" id="uploadSection">
    <div class="card-body text-center">
        <button class="btn btn-primary btn-lg" @onclick="SelectFile">
            <i class="bi bi-music-note-list"></i> Выбрать аудио файл
        </button>
        <p class="text-muted mt-2 mb-0">
            18 форматов: MP3, WAV, FLAC, OGG, AAC, WMA, M4A, OPUS, ALAC, AIFF, APE, WV, TTA, AC3, CAF, AMR, SPX, MP2
        </p>
    </div>
</div>

@if (!string.IsNullOrEmpty(InputFilePath))
{
    <div class="row">
        <!-- 🆕 КОМПАКТНАЯ КАРТОЧКА ФАЙЛА (заменяет старый fileInfoSection) -->
        <div class="col-md-12 mb-4">
            <div class="file-card">
                <div class="file-card-icon">
                    <i class="bi bi-file-earmark-music-fill"></i>
                </div>
                <div class="file-card-info">
                    <div class="file-card-name" title="@FileName">@FileName</div>
                    <div class="file-card-meta">
                        <span><i class="bi bi-clock"></i> @Duration.ToString(@"mm\:ss")</span>
                        <span><i class="bi bi-music-note"></i> @Bitrate kbps</span>
                        <span><i class="bi bi-hdd"></i> @FormatFileSize(OriginalSize)</span>
                        <span class="badge bg-@GetFormatBadgeColor(InputFormat)">@InputFormat.ToUpper()</span>
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-primary" @onclick="ShowFileDetails" title="Подробная информация">
                    <i class="bi bi-info-circle"></i> Детали
                </button>
            </div>
        </div>

        <!-- Настройки конвертации -->
        <div class="col-md-6 mb-4" id="settingsSection">
            <div class="card h-100 border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">🔄 Настройки конвертации</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label"><strong>Исходный формат:</strong></label>
                        <input type="text" class="form-control" value="@InputFormat" disabled />
                    </div>

                    <div class="text-center my-3">
                        <h3>⬇️</h3>
                    </div>

                    <!-- Общая форма настроек (её же использует пакетная конвертация) -->
                    <AudioSettingsForm Settings="A" Large="true" OnChanged="StateHasChanged" OnShakalApplied="OnShakalApplied" />
                </div>
            </div>
        </div>

        <!-- 🆕 БЛОК СОВЕТОВ С ТАБАМИ -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 border-info">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">💡 Какой формат выбрать?</h5>
                </div>

                <!-- 🆕 ТАБЫ КАТЕГОРИЙ -->
                <div class="tip-tabs">
                    <button class="tip-tab @(_activeCategory == CategoryPopular ? "active" : "")"
                            @onclick="@(() => SetCategory(CategoryPopular))">
                        <i class="bi bi-music-note-list"></i>
                        <span>Популярные</span>
                    </button>
                    <button class="tip-tab @(_activeCategory == CategoryLossless ? "active" : "")"
                            @onclick="@(() => SetCategory(CategoryLossless))">
                        <i class="bi bi-gem"></i>
                        <span>Lossless</span>
                    </button>
                    <button class="tip-tab @(_activeCategory == CategoryVideo ? "active" : "")"
                            @onclick="@(() => SetCategory(CategoryVideo))">
                        <i class="bi bi-film"></i>
                        <span>Монтаж</span>
                    </button>
                    <button class="tip-tab @(_activeCategory == CategoryVoice ? "active" : "")"
                            @onclick="@(() => SetCategory(CategoryVoice))">
                        <i class="bi bi-mic"></i>
                        <span>Голос</span>
                    </button>
                    <button class="tip-tab @(_activeCategory == CategorySpecial ? "active" : "")"
                            @onclick="@(() => SetCategory(CategorySpecial))">
                        <i class="bi bi-tools"></i>
                        <span>Спец.</span>
                    </button>
                </div>

                <div class="card-body p-0">
                    <div class="format-tips fade-in">
                        <!-- 🎵 ПОПУЛЯРНЫЕ -->
                        @if (_activeCategory == "popular")
                        {
                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("mp3", 320))">
                                <div class="format-tip-icon mp3">
                                    <i class="bi bi-music-note-beamed"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        MP3 320 kbps
                                        <span class="badge bg-success ms-1">Популярный</span>
                                    </div>
                                    <div class="format-tip-desc">Для музыки, телефона, плеера</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("mp3", 128))">
                                <div class="format-tip-icon podcast">
                                    <i class="bi bi-mic"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">MP3 128 kbps</div>
                                    <div class="format-tip-desc">Для подкастов, аудиокниг</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("aac", 192))">
                                <div class="format-tip-icon aac">
                                    <i class="bi bi-apple"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">AAC 192 kbps</div>
                                    <div class="format-tip-desc">Для iPhone, iPad, Apple Music</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("ogg", 192))">
                                <div class="format-tip-icon ogg">
                                    <i class="bi bi-file-music"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        OGG 192 kbps
                                        <span class="badge bg-info ms-1">Открытый</span>
                                    </div>
                                    <div class="format-tip-desc">Без патентов, Linux, игры</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("m4a", 256))">
                                <div class="format-tip-icon m4a">
                                    <i class="bi bi-apple"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">M4A 256 kbps</div>
                                    <div class="format-tip-desc">Apple iTunes, лучше чем MP3</div>
                                </div>
                            </div>
                        }

                        <!-- 💎 LOSSLESS -->
                        @if (_activeCategory == "lossless")
                        {
                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("flac", 0))">
                                <div class="format-tip-icon flac">
                                    <i class="bi bi-gem"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        FLAC
                                        <span class="badge bg-warning text-dark ms-1">Топ</span>
                                    </div>
                                    <div class="format-tip-desc">Архив, аудиофилы, универсальный lossless</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("wav", 0))">
                                <div class="format-tip-icon wav">
                                    <i class="bi bi-soundwave"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">WAV</div>
                                    <div class="format-tip-desc">DAW, студии, без сжатия</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("alac", 0))">
                                <div class="format-tip-icon alac">
                                    <i class="bi bi-apple"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">ALAC</div>
                                    <div class="format-tip-desc">Apple Lossless для iTunes и iPhone</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("aiff", 0))">
                                <div class="format-tip-icon aiff">
                                    <i class="bi bi-mac"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        AIFF
                                        <span class="badge bg-info ms-1">Pro</span>
                                    </div>
                                    <div class="format-tip-desc">Для Mac, видеомонтажа (Final Cut, Logic)</div>
                                </div>
                            </div>
                        }

                        <!-- 🎬 ВИДЕОМОНТАЖ -->
                        @if (_activeCategory == "video")
                        {
                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("ac3", 384))">
                                <div class="format-tip-icon ac3">
                                    <i class="bi bi-film"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        AC3 (Dolby)
                                        <span class="badge bg-danger ms-1">Кино</span>
                                    </div>
                                    <div class="format-tip-desc">DVD, Blu-ray, 5.1 surround</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("caf", 0))">
                                <div class="format-tip-icon caf">
                                    <i class="bi bi-camera-reels"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">CAF</div>
                                    <div class="format-tip-desc">Core Audio для iOS/macOS видеомонтажа</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("wav", 0))">
                                <div class="format-tip-icon wav">
                                    <i class="bi bi-soundwave"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        WAV (PCM)
                                        <span class="badge bg-primary ms-1">Стандарт</span>
                                    </div>
                                    <div class="format-tip-desc">Adobe Premiere, DaVinci Resolve</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("aiff", 0))">
                                <div class="format-tip-icon aiff">
                                    <i class="bi bi-mac"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">AIFF</div>
                                    <div class="format-tip-desc">Final Cut Pro, Logic Pro</div>
                                </div>
                            </div>
                        }

                        <!-- 🎙️ ГОЛОС -->
                        @if (_activeCategory == "voice")
                        {
                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("opus", 64))">
                                <div class="format-tip-icon opus">
                                    <i class="bi bi-broadcast"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        OPUS 64 kbps
                                        <span class="badge bg-info ms-1">Топ</span>
                                    </div>
                                    <div class="format-tip-desc">Discord, звонки, стриминг речи</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("mp3", 96))">
                                <div class="format-tip-icon mp3">
                                    <i class="bi bi-mic-fill"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">MP3 96 kbps</div>
                                    <div class="format-tip-desc">Подкасты, интервью, лекции</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("amr", 12))">
                                <div class="format-tip-icon amr">
                                    <i class="bi bi-telephone"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">AMR</div>
                                    <div class="format-tip-desc">Мобильная запись, диктофоны, 3GPP</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("spx", 32))">
                                <div class="format-tip-icon spx">
                                    <i class="bi bi-chat-audio"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">Speex</div>
                                    <div class="format-tip-desc">Специально для речи, VoIP</div>
                                </div>
                            </div>
                        }

                        <!-- 🔧 СПЕЦИФИЧНЫЕ -->
                        @if (_activeCategory == "special")
                        {
                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("ape", 0))">
                                <div class="format-tip-icon ape">
                                    <i class="bi bi-archive"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">APE</div>
                                    <div class="format-tip-desc">Monkey's Audio — сильное lossless сжатие</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("wv", 0))">
                                <div class="format-tip-icon wv">
                                    <i class="bi bi-layers"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">WavPack</div>
                                    <div class="format-tip-desc">Lossless + hybrid режим</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("tta", 0))">
                                <div class="format-tip-icon tta">
                                    <i class="bi bi-file-earmark-zip"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">TTA</div>
                                    <div class="format-tip-desc">True Audio lossless, быстрое сжатие</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("mp2", 192))">
                                <div class="format-tip-icon mp2">
                                    <i class="bi bi-broadcast-pin"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        MP2
                                        <span class="badge bg-secondary ms-1">Радио</span>
                                    </div>
                                    <div class="format-tip-desc">Вещание, DAB радио, MPEG-1</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("wma", 192))">
                                <div class="format-tip-icon wma">
                                    <i class="bi bi-windows"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">WMA</div>
                                    <div class="format-tip-desc">Старые Windows-устройства, Zune</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Кнопки управления -->
        <div class="col-md-12 mb-4" id="controlsSection">
            <div class="card">
                <div class="card-body text-center">
                    <button class="btn btn-success btn-lg me-2" @onclick="StartConversion" disabled="@IsConverting">
                        <i class="bi bi-play-circle"></i> @(IsConverting ? "Конвертация..." : "Начать конвертацию")
                    </button>
                    <button class="btn btn-danger btn-lg" @onclick="CancelConversion" disabled="@(!IsConverting)">
                        <i class="bi bi-x-circle"></i> Отмена
                    </button>
                </div>
            </div>
        </div>

        <!-- Прогресс -->
        @if (IsConverting || Progress > 0)
        {
            <div class="col-md-12 mb-4" id="progressSection">
                <div class="card border-warning">
                    <div class="card-body">
                        <h5>⏳ Прогресс конвертации</h5>
                        <div class="progress" style="height: 40px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning text-dark"
                                 role="progressbar" style="width: @Progress%">
                                <strong>@Progress%</strong>
                            </div>
                        </div>
                        <p class="text-center mt-2 mb-0 text-muted">@ConversionStatus</p>
                    </div>
                </div>
            </div>
        }

        <!-- Результат конвертации -->
        @if (!string.IsNullOrEmpty(_outputFilePath))
        {
            <div class="col-md-12 mb-4">
                <div class="card border-success">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="success-icon me-3">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 text-success">Конвертация завершена!</h6>
                                <small class="text-muted">
                                    Файл: @System.IO.Path.GetFileName(_outputFilePath)
                                    @if (_outputFileSize > 0)
                                    {
                                        <span> • @FormatFileSize(_outputFileSize)</span>
                                    }
                                </small>
                            </div>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-success" @onclick="DownloadFile">
                                <i class="bi bi-download me-2"></i>Скачать файл
                            </button>
                            <button class="btn btn-outline-primary" @onclick="OpenFileLocation">
                                <i class="bi bi-folder2-open me-2"></i>Открыть папку
                            </button>
                            @if (_outputFileSize > 0)
                            {
                                <button class="btn btn-outline-secondary" @onclick="ClearResult">
                                    <i class="bi bi-x-lg me-2"></i>Очистить
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- 🆕 МОДАЛЬНОЕ ОКНО С ДЕТАЛЯМИ ФАЙЛА -->
@if (_showFileDetailsModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content details-modal">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-info-circle me-2"></i>Информация о файле
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseFileDetails"></button>
                </div>
                <div class="modal-body">
                    <!-- Заголовок -->
                    <div class="details-title mb-3">
                        <div class="d-flex align-items-center">
                            <div class="file-modal-icon me-3">
                                <i class="bi bi-file-earmark-music-fill"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">@FileName</h6>
                                <small class="text-muted">Исходный аудио файл</small>
                            </div>
                        </div>
                    </div>

                    <!-- Таблица деталей -->
                    <div class="details-table">
                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-file-earmark text-primary"></i> Формат
                            </div>
                            <div class="detail-value">
                                <span class="badge bg-@GetFormatBadgeColor(InputFormat) fs-6">
                                    @InputFormat.ToUpper()
                                </span>
                                <small class="text-muted ms-2">@GetFormatFullName(InputFormat)</small>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-clock text-info"></i> Длительность
                            </div>
                            <div class="detail-value">
                                @Duration.ToString(@"hh\:mm\:ss")
                                <small class="text-muted ms-2">(@((int)Duration.TotalSeconds) секунд)</small>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-music-note text-success"></i> Битрейт
                            </div>
                            <div class="detail-value">
                                <strong>@Bitrate kbps</strong>
                                <small class="text-muted ms-2">@GetBitrateQuality(Bitrate)</small>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-hdd text-warning"></i> Размер
                            </div>
                            <div class="detail-value">
                                <strong>@FormatFileSize(OriginalSize)</strong>
                                <small class="text-muted ms-2">(@OriginalSize.ToString("N0") байт)</small>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-folder text-secondary"></i> Путь
                            </div>
                            <div class="detail-value">
                                <div class="d-flex align-items-start gap-2">
                                    <span class="text-break flex-grow-1" title="@InputFilePath">
                                        @InputFilePath
                                    </span>
                                    <button class="btn btn-sm btn-outline-secondary flex-shrink-0"
                                        @onclick="@(() => CopyToClipboard(InputFilePath ?? string.Empty))"
                                        title="Скопировать путь">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-check-circle text-success"></i> Файл на диске
                            </div>
                            <div class="detail-value">
                                @if (!string.IsNullOrEmpty(InputFilePath) && File.Exists(InputFilePath))
                                {
                                    <span class="badge bg-success">✅ Найден</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">❌ Не найден (перемещён или удалён)</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-primary" @onclick="() => CopyToClipboard(FileName)">
                        <i class="bi bi-clipboard me-1"></i> Копировать имя
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="@(() => CopyToClipboard(InputFilePath ?? string.Empty))">
                        <i class="bi bi-link-45deg me-1"></i> Копировать путь
                    </button>
                    <button class="btn btn-success" @onclick="OpenInputFileLocation">
                        <i class="bi bi-folder2-open me-1"></i> Открыть папку
                    </button>
                    <button class="btn btn-secondary" @onclick="CloseFileDetails">
                        <i class="bi bi-x-lg me-1"></i> Закрыть
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>


    /* Заголовки секций советов */
    .format-tip-section-title {
        padding: 0.5rem 1.25rem 0.25rem;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #888;
        background: rgba(0, 0, 0, 0.02);
        border-bottom: 1px solid #f0f0f0;
    }

    body.dark-theme .format-tip-section-title {
        color: #aaa;
        background: rgba(255, 255, 255, 0.03);
        border-bottom-color: #2a2a3e;
    }

        /* 🆕 Табы категорий */
    .tip-tabs {
        display: flex;
        gap: 0;
        padding: 0.5rem 0.5rem 0;
