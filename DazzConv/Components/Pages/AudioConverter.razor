        "wav" => "(без сжатия)",
        "ogg" => "(открытый)",
        "flac" => "(без потерь)",
        "aac" => "(лучше MP3)",
        "wma" => "(Windows)",
        "m4a" => "(Apple)",
        "opus" => "(современный)",
        _ => ""
    };

    private string GetFormatHelpText(string format) => format switch
    {
        "mp3" => "Самый популярный формат",
        "wav" => "Без сжатия, большой размер",
        "ogg" => "Открытый формат",
        "flac" => "Сжатие без потерь",
        "aac" => "Лучше чем MP3",
        "wma" => "Windows Media Audio",
