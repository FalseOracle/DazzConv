@code {
    // Раньше подписка на горячие клавиши никогда не снималась: HotkeyService живёт всё время работы приложения,
    // поэтому каждое открытие страницы добавляло ещё один обработчик (утечка + вызовы в уже закрытые страницы).
    public void Dispose()
    {
        Hotkeys.OnCancelRequested -= HandleCancel;
        try { Cts?.Cancel(); } catch { }
    }

    // Константы для категорий (избегаем проблем с кавычками в Razor)
    private const string CategoryPopular = "popular";
    private const string CategoryLossless = "lossless";
    private const string CategoryVideo = "video";
    private const string CategoryVoice = "voice";
    private const string CategorySpecial = "special";

    private string FileName = "";
    private TimeSpan Duration;
    private int Bitrate;
    private string InputFormat = "";
    // Все настройки — в общей модели AudioSettings; свойства ниже — мостики для остального кода страницы.
    private readonly AudioSettings A = new();
    private string OutputFormat { get => A.OutputFormat; set => A.SetFormat(value); }
    private int OutputBitrate { get => A.Bitrate; set => A.Bitrate = value; }
    private int SampleRate { get => A.SampleRate; set => A.SampleRate = value; }
    private bool NormalizeAudio { get => A.Normalize; set => A.Normalize = value; }
    private bool Mono { get => A.Mono; set => A.Mono = value; }

    private Task OnShakalApplied(string summary) => ShowToast($"📉 Шакал: {summary}", ToastType.Success);
    private bool IsConverting = false;
    private bool IsConverted = false;
    private int Progress = 0;
    private string ConversionStatus = "Готов к работе";
    private string? InputFilePath;
    private CancellationTokenSource? Cts;

    private long OriginalSize;
    private bool _showFileDetailsModal = false;
    private string _activeCategory = CategoryPopular;
    private string _outputFilePath = "";
    private string _tempOutputPath = "";
    private long _outputFileSize = 0;

    private bool ShowBitrateOptions => A.Format.HasBitrate;

    // входные форматы = выходные (единый список InputFormats); видео принимается для извлечения звука
    private readonly string[] AllowedAudioExtensions = InputFormats.Audio;
    private readonly string[] AllowedVideoExtensions = InputFormats.Video;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                Hotkeys.OnCancelRequested += HandleCancel;
                await Hotkeys.InitializeAsync();
            }
            catch (Exception ex)
            {
                try { Logger.LogWarning($"Горячие клавиши не инициализированы: {ex.Message}"); } catch { }
            }
        }
    }

    private Task HandleCancel()
    {
        if (IsConverting) CancelConversion();
        return Task.CompletedTask;
    }

    private void ShowFileDetails()
    {
        _showFileDetailsModal = true;
        StateHasChanged();
    }

    private void CloseFileDetails()
    {
        _showFileDetailsModal = false;
        StateHasChanged();
    }

    private void SetCategory(string category)
    {
        if (_activeCategory != category)
        {
            _activeCategory = category;
            StateHasChanged();
        }
    }

    private async Task CopyToClipboard(string text)
    {
        if (string.IsNullOrEmpty(text)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await ShowToast("📋 Скопировано в буфер обмена", ToastType.Success);
        }
        catch (Exception ex)
        {
            Logger.LogWarning($"Ошибка копирования: {ex.Message}");
            await ShowToast("❌ Не удалось скопировать", ToastType.Error);
        }
    }

    private void OpenInputFileLocation()
    {
        if (string.IsNullOrEmpty(InputFilePath)) return;
        try
        {
            var normalizedPath = Path.GetFullPath(InputFilePath).Replace('/', '\\');
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = "/select,\"" + normalizedPath + "\"",
                UseShellExecute = true
            };
            System.Diagnostics.Process.Start(psi);
        }
        catch (Exception ex)
        {
            Logger.LogError($"Ошибка открытия папки: {ex.Message}");
            _ = ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
    }

    private void QuickFormatSelect(string format, int bitrate)
    {
        OutputFormat = format;
        if (bitrate > 0 && ShowBitrateOptions)
        {
            OutputBitrate = bitrate;
        }
        StateHasChanged();
        _ = ShowToast($"✅ Выбран формат: {format.ToUpper()}{(bitrate > 0 ? $" @ {bitrate} kbps" : "")}", ToastType.Success);
    }

    private string GetFormatBadgeColor(string format) => format.ToLower() switch
    {
        "mp3" or "aac" or "m4a" => "success",
        "flac" or "alac" or "ape" or "wv" or "tta" => "warning text-dark",
        "wav" or "aiff" or "caf" => "danger",
        "ogg" or "opus" or "spx" => "info",
        "ac3" => "danger",
        "amr" => "secondary",
        "wma" => "primary",
        "mp2" => "dark",
        _ => "secondary"
    };

    private string GetFormatFullName(string format) => format.ToLower() switch
    {
        "mp3" => "MPEG Audio Layer III",
        "mp2" => "MPEG-1 Audio Layer II",
        "wav" => "Waveform Audio File Format",
        "flac" => "Free Lossless Audio Codec",
        "ogg" => "Ogg Vorbis",
        "aac" => "Advanced Audio Coding",
        "wma" => "Windows Media Audio",
        "m4a" => "MPEG-4 Audio",
        "opus" => "Opus Interactive Audio Codec",
        "ac3" => "Audio Codec 3 (Dolby Digital)",
        "aiff" => "Audio Interchange File Format",
        "alac" => "Apple Lossless Audio Codec",
        "ape" => "Monkey's Audio",
        "amr" => "Adaptive Multi-Rate",
        "caf" => "Core Audio Format",
        "spx" => "Speex Speech Codec",
        "tta" => "True Audio Lossless",
        "wv" => "WavPack Hybrid Lossless",
        _ => "Unknown Format"
    };

    private string GetBitrateQuality(int bitrate)
    {
        if (bitrate >= 320) return "🌟 Максимальное качество";
        if (bitrate >= 256) return "⭐ Отличное качество";
        if (bitrate >= 192) return "✅ Высокое качество";
        if (bitrate >= 128) return "👍 Среднее качество";
        if (bitrate >= 96) return "📱 Для мобильных";
        return "📉 Низкое качество";
    }

    private async Task SelectFile()
    {
        try
        {
            var result = await FilePicker.Default.PickAsync(InputPickers.AudioOrVideo("Выберите аудио или видео файл"));

            if (result == null) return;

            ResetFileState();   // раньше ResetConverter() сбрасывал и выбранный формат, и битрейт

            InputFilePath = result.FullPath;
            FileName = Path.GetFileName(InputFilePath);
            InputFormat = Path.GetExtension(InputFilePath).TrimStart('.').ToLower();

            bool isAudio = AllowedAudioExtensions.Contains(InputFormat);
            bool isVideo = AllowedVideoExtensions.Contains(InputFormat);

            if (!isAudio && !isVideo)
            {
                await ShowToast($"❌ Формат .{InputFormat.ToUpper()} не поддерживается!", ToastType.Error);
                InputFilePath = null;
                FileName = "";
                return;
            }

            var fileInfo = new FileInfo(InputFilePath);
            if (fileInfo.Length == 0)
            {
                await ShowToast("❌ Файл пустой (0 байт)!", ToastType.Error);
                InputFilePath = null;
                FileName = "";
                return;
            }

            if (fileInfo.Length > 2L * 1024 * 1024 * 1024)
            {
                await ShowToast("❌ Файл слишком большой (максимум 2 ГБ)!", ToastType.Error);
                InputFilePath = null;
                FileName = "";
                return;
            }

            if (isAudio && !ValidateAudioContent(InputFilePath, InputFormat))
            {
                await ShowToast($"❌ Содержимое не соответствует формату {InputFormat.ToUpper()}!", ToastType.Error);
                InputFilePath = null;
                FileName = "";
                return;
            }

            OriginalSize = fileInfo.Length;

            if (isVideo)
            {
                await ShowToast($"ℹ️ Видео файл ({InputFormat.ToUpper()})\n\nБудет извлечена аудиодорожка.", ToastType.Info);
            }

            var ffmpegPath = FFmpegService.GetFFmpegPath();
            var info = await AudioFileInfo.FromFileAsync(ffmpegPath, InputFilePath);
            Duration = info.Duration;
            Bitrate = info.Bitrate;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError("Ошибка выбора файла", ex);
            await ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
    }

    private bool ValidateAudioContent(string filePath, string extension)
    {
        try
        {
            var fileInfo = new FileInfo(filePath);
            if (fileInfo.Length < 4) return false;

            var buffer = new byte[12];
            using var fs = File.OpenRead(filePath);
            fs.Read(buffer, 0, Math.Min(12, (int)fileInfo.Length));

            return extension.ToLower() switch
            {
                "mp3" => (buffer[0] == 0xFF && (buffer[1] & 0xE0) == 0xE0) || (buffer[0] == 0x49 && buffer[1] == 0x44 && buffer[2] == 0x33),
                "wav" => buffer[0] == 0x52 && buffer[1] == 0x49 && buffer[2] == 0x46 && buffer[3] == 0x46,
                "flac" => buffer[0] == 0x66 && buffer[1] == 0x4C && buffer[2] == 0x61 && buffer[3] == 0x43,
                "ogg" => buffer[0] == 0x4F && buffer[1] == 0x67 && buffer[2] == 0x67 && buffer[3] == 0x53,
                "m4a" => buffer.Length >= 8 && buffer[4] == 0x66 && buffer[5] == 0x74 && buffer[6] == 0x79 && buffer[7] == 0x70,
                "aiff" => buffer[0] == 0x46 && buffer[1] == 0x4F && buffer[2] == 0x52 && buffer[3] == 0x4D,
                _ => true
            };
        }
        catch
        {
            return true;
        }
    }

    private async Task StartConversion()
    {
        if (string.IsNullOrEmpty(InputFilePath))
        {
            await ShowToast("⚠️ Выберите файл", ToastType.Warning);
            return;
        }

        IsConverting = true;
        IsConverted = false;
        Progress = 0;
        _outputFilePath = "";
        _outputFileSize = 0;
        ConversionStatus = "Инициализация...";
        Cts?.Dispose();
        Cts = new CancellationTokenSource();

        var ffmpegPath = FFmpegService.GetFFmpegPath();
        var convertedFilePath = Path.Combine(Path.GetTempPath(),
            Path.GetFileNameWithoutExtension(FileName) + "_converted." + A.OutputExt);
        _tempOutputPath = convertedFilePath;
        // остаток от прошлого запуска: без -y ffmpeg ждал бы подтверждения перезаписи и «зависал»
        try { if (File.Exists(convertedFilePath)) File.Delete(convertedFilePath); } catch { }

        var progressReporter = new Progress<int>(value =>
        {
            Progress = Math.Max(0, Math.Min(100, value));
            ConversionStatus = GetConversionStatusText();
            InvokeAsync(StateHasChanged);
        });

        try
        {
            bool isVideo = AllowedVideoExtensions.Contains(InputFormat);

            // Раньше для обычных аудиофайлов битрейт, частота и нормализация вообще не передавались в ffmpeg
            // (работал только путь «звук из видео»). Теперь оба случая идут через сервис с параметрами.
            await AudioService.ConvertAsync(ffmpegPath, InputFilePath, convertedFilePath, Duration, progressReporter, Cts.Token,
                A.ToOptions(stripVideo: isVideo));

            if (!File.Exists(convertedFilePath))
                throw new Exception("Файл не создан");

            var fileInfo = new FileInfo(convertedFilePath);
            _outputFilePath = convertedFilePath;
            _outputFileSize = fileInfo.Length;

            IsConverted = true;
            ConversionStatus = "Готово!";
            StateHasChanged();

            await ShowToast("✅ Конвертация завершена!", ToastType.Success);
        }
        catch (OperationCanceledException)
        {
            await HandleConversionError("Конвертация отменена");
        }
        catch (Exception ex)
        {
            Logger.LogError("Ошибка конвертации", ex);
            await HandleConversionError($"Ошибка: {ex.Message}");
        }
        finally
        {
            // раньше после успешной конвертации IsConverting оставался true — кнопка «Начать» была заблокирована
            IsConverting = false;
            StateHasChanged();
        }
    }

    private async Task HandleConversionError(string message)
    {
        // раньше удалялся _outputFilePath, который при ошибке ещё пуст, — недописанный файл оставался в %TEMP%
        foreach (var leftover in new[] { _outputFilePath, _tempOutputPath })
        {
            if (!string.IsNullOrEmpty(leftover) && File.Exists(leftover))
            {
                try { File.Delete(leftover); } catch { }
            }
        }

        IsConverting = false;
        IsConverted = false;
        Progress = 0;
        ConversionStatus = "Ошибка: " + message;
        _outputFilePath = "";
        _outputFileSize = 0;
        await ShowToast($"❌ {message}", ToastType.Error);
    }

