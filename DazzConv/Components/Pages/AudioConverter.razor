    private void CancelConversion() => Cts?.Cancel();

    private async Task DownloadFile()
    {
        if (string.IsNullOrEmpty(_outputFilePath) || !File.Exists(_outputFilePath))
        {
            await ShowToast("⚠️ Файл не найден", ToastType.Warning);
            return;
        }

        try
        {
            var fileName = Path.GetFileName(_outputFilePath);
            // поток прямо из файла: раньше весь файл (до гигабайт) читался в память
            await using var stream = new FileStream(_outputFilePath, FileMode.Open, FileAccess.Read, FileShare.Read, 81920, useAsync: true);
            using var streamRef = new DotNetStreamReference(stream);

            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

            await ShowToast("✅ Файл скачивается...", ToastType.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError("Ошибка скачивания", ex);
            await ShowToast($"❌ Ошибка скачивания: {ex.Message}", ToastType.Error);
        }
    }

    private void OpenFileLocation()
    {
        if (string.IsNullOrEmpty(_outputFilePath))
        {
            _ = ShowToast("⚠️ Путь пустой", ToastType.Warning);
            return;
        }

        if (!File.Exists(_outputFilePath))
        {
            var dir = Path.GetDirectoryName(_outputFilePath);
            if (!string.IsNullOrEmpty(dir) && Directory.Exists(dir))
            {
                try
                {
                    System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                    {
                        FileName = dir,
                        UseShellExecute = true
                    });
                }
                catch (Exception ex)
                {
                    _ = ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
                }
            }
            return;
        }

        try
        {
            var normalizedPath = Path.GetFullPath(_outputFilePath).Replace('/', '\\');
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = "/select,\"" + normalizedPath + "\"",
                UseShellExecute = true
            };
            System.Diagnostics.Process.Start(psi);
        }
        catch (Exception ex)
        {
            Logger.LogError($"Ошибка открытия папки: {ex.Message}");
            _ = ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
    }

    private void ClearResult()
    {
        if (!string.IsNullOrEmpty(_outputFilePath) && File.Exists(_outputFilePath))
        {
            try { File.Delete(_outputFilePath); } catch { }
        }
        _outputFilePath = "";
        _outputFileSize = 0;
        IsConverted = false;
        Progress = 0;
        ConversionStatus = "Готов к работе";
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes == 0) return "0 Б";
        const long kb = 1024, mb = kb * 1024, gb = mb * 1024;
        if (bytes >= gb) return $"{(bytes / (double)gb):F2} ГБ";
        if (bytes >= mb) return $"{(bytes / (double)mb):F2} МБ";
        if (bytes >= kb) return $"{(bytes / (double)kb):F2} КБ";
        return $"{bytes} Б";
    }

