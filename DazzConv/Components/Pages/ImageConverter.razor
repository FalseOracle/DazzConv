@code {
    // 🆕 Константы категорий
    private const string CategoryPopular = "popular";
    private const string CategoryDesign = "design";
    private const string CategoryGames = "games";
    private const string CategoryVfx = "vfx";
    private const string CategorySpecial = "special";

    // 🆕 Активная категория табов
    private string _activeCategory = CategoryPopular;

    private string FileName = "";
    private string FileSize = "";
    private string InputFormat = "";
    private int ImageWidth;
    private int ImageHeight;
    private string OutputFormat = "png";
    private int Quality = 85;
    private bool ResizeEnabled = false;
    private int NewWidth;
    private int NewHeight;
    private bool KeepAspectRatio = true;
    private bool OptimizeSize = false;
    private bool IsConverting = false;
    private bool IsConverted = false;
    private int Progress = 0;
    private string? InputFilePath;
    private byte[]? ConvertedData;
    private string PreviewBase64 = "";
    private CancellationTokenSource? Cts;
    private long OriginalSize;
    private long ConvertedSize;
    private string? SavedFilePath;

    private bool _showFileDetailsModal = false;

    private readonly string[] AllowedExtensions = {
        "jpg", "jpeg", "png", "gif", "webp", "avif", "heic", "heif",
        "bmp", "tiff", "tif", "pnm", "pbm", "pgm", "ppm", "psd",
        "tga", "dds", "pcx", "sgi", "rgb",
        "dpx", "exr", "hdr", "cin",
        "ico", "jxl", "qoi", "ff"
    };

    private readonly string[] SupportedOutputFormats = {
        // Популярные (6)
        "jpg", "png", "webp", "avif", "gif", "heic",
        "tiff", "bmp", "pnm", "psd",
        "tga", "dds", "pcx", "sgi",
        "dpx", "exr", "hdr", "cin",
        "ico", "jxl", "qoi", "ff"
    };

    private bool ShowQualitySlider => OutputFormat is "jpg" or "jpeg" or "webp" or "avif";
    private bool IsValidImageSize(int size) => size >= 1 && size <= 8192;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                Hotkeys.OnCancelRequested += HandleCancel;
                await Hotkeys.InitializeAsync();
            }
            catch (Exception ex)
            {
                try { Logger.LogWarning($"Горячие клавиши не инициализированы: {ex.Message}"); } catch { }
            }
        }
    }

    private Task HandleCancel()
    {
        if (IsConverting) CancelConversion();
        return Task.CompletedTask;
    }

    private void SetCategory(string category)
    {
        if (_activeCategory != category)
        {
            _activeCategory = category;
            StateHasChanged();
        }
    }

    private void ShowFileDetails()
    {
        _showFileDetailsModal = true;
        StateHasChanged();
    }

    private void CloseFileDetails()
    {
        _showFileDetailsModal = false;
        StateHasChanged();
    }

    private async Task CopyToClipboard(string text)
    {
        if (string.IsNullOrEmpty(text)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await ShowToast("📋 Скопировано в буфер обмена", ToastType.Success);
        }
        catch (Exception ex)
        {
            Logger.LogWarning($"Ошибка копирования: {ex.Message}");
            await ShowToast("❌ Не удалось скопировать", ToastType.Error);
        }
    }

    private void OpenInputFileLocation()
    {
        if (string.IsNullOrEmpty(InputFilePath)) return;
        try
        {
            var normalizedPath = Path.GetFullPath(InputFilePath).Replace('/', '\\');
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = "/select,\"" + normalizedPath + "\"",
                UseShellExecute = true
            };
            System.Diagnostics.Process.Start(psi);
        }
        catch (Exception ex)
        {
            Logger.LogError($"Ошибка открытия папки: {ex.Message}");
            _ = ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
    }

    private void QuickFormatSelect(string format)
    {
        OutputFormat = format;
        StateHasChanged();
        _ = ShowToast($"✅ Выбран формат: {format.ToUpper()}", ToastType.Success);
    }

    private string GetFormatBadgeColor(string format) => format.ToLower() switch
    {
        "jpg" or "jpeg" or "webp" or "jxl" => "success",
        "png" or "tiff" or "tif" => "info",
        "avif" or "exr" or "hdr" => "warning text-dark",
        "gif" or "bmp" or "pcx" => "dark",
        "ico" or "dds" or "heic" or "heif" => "secondary",
        "tga" or "dpx" or "cin" => "danger",
        "qoi" or "ff" or "pnm" => "primary",
        _ => "secondary"
    };

    private string GetFormatFullName(string format) => format.ToLower() switch
    {
        "jpg" or "jpeg" => "Joint Photographic Experts Group",
        "png" => "Portable Network Graphics",
        "webp" => "Web Picture Format (Google)",
        "avif" => "AV1 Image File Format",
        "gif" => "Graphics Interchange Format",
        "heic" or "heif" => "High Efficiency Image Format (Apple)",
        "tiff" or "tif" => "Tagged Image File Format",
        "bmp" => "Bitmap Image (Windows)",
        "pnm" or "pbm" or "pgm" or "ppm" => "Portable Anymap (Unix)",
        "psd" => "Adobe Photoshop Document",
        "tga" => "Truevision Targa",
        "dds" => "DirectDraw Surface (Microsoft)",
        "pcx" => "PiCture eXchange (ZSoft)",
        "sgi" or "rgb" => "Silicon Graphics Image",
        "dpx" => "Digital Picture Exchange (Kodak)",
        "exr" => "OpenEXR (Industrial Light & Magic)",
        "hdr" => "Radiance HDR (High Dynamic Range)",
        "cin" => "Cineon (Kodak)",
        "ico" => "Windows Icon",
        "jxl" => "JPEG XL (ISO/IEC 18181)",
        "qoi" => "Quite OK Image Format",
        "ff" => "Farbfeld (suckless.org)",
        _ => "Unknown Format"
    };

    private string GetQualityDescription(int quality)
    {
        if (quality >= 90) return "🌟 Отличное";
        if (quality >= 75) return "⭐ Высокое";
        if (quality >= 50) return "✅ Среднее";
        if (quality >= 25) return "📱 Низкое";
        return "📉 Минимальное";
    }

    private string GetAspectRatioName(int width, int height)
    {
        if (width == 0 || height == 0) return "";
        var gcd = GCD(width, height);
        var w = width / gcd;
        var h = height / gcd;
        var ratio = (double)width / height;

        if (Math.Abs(ratio - 1.0) < 0.05) return "1:1 (квадрат)";
        if (Math.Abs(ratio - 16.0 / 9) < 0.05) return "16:9 (широкий)";
        if (Math.Abs(ratio - 4.0 / 3) < 0.05) return "4:3 (стандарт)";
        if (Math.Abs(ratio - 3.0 / 2) < 0.05) return "3:2 (фото)";
        if (Math.Abs(ratio - 21.0 / 9) < 0.05) return "21:9 (ультраширокий)";
        if (Math.Abs(ratio - 9.0 / 16) < 0.05) return "9:16 (вертикальный)";
        return $"{w}:{h}";
    }

    private int GCD(int a, int b)
    {
        while (b != 0)
        {
            var temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }

    private async Task SelectFile()
    {
        try
        {
            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Выберите изображение",
                FileTypes = FilePickerFileType.Images
            });

            if (result == null) return;

            var ext = Path.GetExtension(result.FullPath).TrimStart('.').ToLower();

            if (!AllowedExtensions.Contains(ext))
            {
                Logger.LogWarning($"Изображения: отклонён файл .{ext}");
                await ShowToast($"❌ Формат .{ext.ToUpper()} не поддерживается!", ToastType.Error);
                return;
            }

            var fileInfo = new FileInfo(result.FullPath);
            if (fileInfo.Length == 0)
            {
                await ShowToast("❌ Файл пустой (0 байт)!", ToastType.Error);
                return;
            }

            if (fileInfo.Length > 500L * 1024 * 1024)
            {
                await ShowToast("❌ Файл слишком большой (максимум 500 МБ)!", ToastType.Error);
                return;
            }

            if (!ValidateImageContent(result.FullPath, ext))
            {
                await ShowToast($"❌ Содержимое не соответствует формату {ext.ToUpper()}!", ToastType.Error);
                return;
            }

            Logger.LogInfo($"Изображения: загружен файл - {Path.GetFileName(result.FullPath)} ({fileInfo.Length} байт)");
            await LoadImage(result.FullPath);
        }
        catch (Exception ex)
        {
            Logger.LogError("Изображения: ошибка выбора файла", ex);
            await ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
    }

    private bool ValidateImageContent(string filePath, string extension)
    {
        try
        {
            var fileInfo = new FileInfo(filePath);
            if (fileInfo.Length < 4) return false;

            var buffer = new byte[16];
            using var fs = File.OpenRead(filePath);
            fs.Read(buffer, 0, Math.Min(16, (int)fileInfo.Length));

            return extension.ToLower() switch
            {
                "jpg" or "jpeg" => buffer[0] == 0xFF && buffer[1] == 0xD8 && buffer[2] == 0xFF,
                "png" => buffer[0] == 0x89 && buffer[1] == 0x50 && buffer[2] == 0x4E && buffer[3] == 0x47,
                "gif" => buffer[0] == 0x47 && buffer[1] == 0x49 && buffer[2] == 0x46,
                "bmp" => buffer[0] == 0x42 && buffer[1] == 0x4D,
                "webp" => buffer.Length >= 12 && buffer[0] == 0x52 && buffer[1] == 0x49 && buffer[2] == 0x46 && buffer[3] == 0x46 &&
                          buffer[8] == 0x57 && buffer[9] == 0x45 && buffer[10] == 0x42 && buffer[11] == 0x50,
                "tiff" or "tif" => (buffer[0] == 0x49 && buffer[1] == 0x49 && buffer[2] == 0x2A) ||
                                    (buffer[0] == 0x4D && buffer[1] == 0x4D && buffer[3] == 0x2A),
                "ico" => buffer[0] == 0x00 && buffer[1] == 0x00 && buffer[2] == 0x01 && buffer[3] == 0x00,
                "avif" or "heic" or "heif" => buffer.Length >= 8 && buffer[4] == 0x66 && buffer[5] == 0x74 &&
                                               buffer[6] == 0x79 && buffer[7] == 0x70,
                "tga" => true,
                "dds" => buffer[0] == 0x44 && buffer[1] == 0x44 && buffer[2] == 0x53 && buffer[3] == 0x20,
                "pcx" => buffer[0] == 0x0A,
                "exr" => buffer[0] == 0x76 && buffer[1] == 0x2F && buffer[2] == 0x31 && buffer[3] == 0x01,
                "hdr" => buffer[0] == 0x23 && buffer[1] == 0x3F,
                "dpx" => buffer[0] == 0x53 && buffer[1] == 0x44 && buffer[2] == 0x50 && buffer[3] == 0x58,
                "jxl" => buffer[0] == 0xFF && buffer[1] == 0x0A,
                "qoi" => buffer[0] == 0x71 && buffer[1] == 0x6F && buffer[2] == 0x69 && buffer[3] == 0x66,
                "ff" => buffer[0] == 0x66 && buffer[1] == 0x61 && buffer[2] == 0x72 && buffer[3] == 0x62,
                "psd" => buffer[0] == 0x38 && buffer[1] == 0x42 && buffer[2] == 0x50 && buffer[3] == 0x53,
                "pnm" or "pbm" or "pgm" or "ppm" => buffer[0] == 0x50 && buffer[1] >= 0x31 && buffer[1] <= 0x36,
                _ => true
            };
        }
        catch
        {
            return true;
        }
    }

    private async Task LoadImage(string filePath)
    {
        try
        {
            InputFilePath = filePath;
            FileName = Path.GetFileName(filePath);

            var info = ImageFileInfo.FromFile(filePath);
            FileSize = FormatBytes(info.Size);
            OriginalSize = info.Size;
            InputFormat = info.Format;

            var preview = await ImageService.CreatePreviewAsync(filePath, 300);
            PreviewBase64 = Convert.ToBase64String(preview);

            using var img = new ImageMagick.MagickImage(filePath);
            ImageWidth = (int)img.Width;
            ImageHeight = (int)img.Height;
            NewWidth = ImageWidth;
            NewHeight = ImageHeight;

            IsConverted = false;
            ConvertedData = null;
            Progress = 0;
            SavedFilePath = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError("Изображения: ошибка загрузки", ex);
            await ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
    }

    private void OnFormatChanged(ChangeEventArgs e) { OutputFormat = e.Value?.ToString() ?? "png"; StateHasChanged(); }
    private void OnQualityChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int q)) Quality = q; }

    private async Task StartConversion()
    {
        if (string.IsNullOrEmpty(InputFilePath))
        {
            await ShowToast("⚠️ Выберите файл", ToastType.Warning);
            return;
        }

        if (ResizeEnabled && (!IsValidImageSize(NewWidth) || !IsValidImageSize(NewHeight)))
        {
            await ShowToast("❌ Недопустимый размер (1-8192 px)", ToastType.Error);
            return;
        }

        IsConverting = true;
        IsConverted = false;
        Progress = 10;
        Cts = new CancellationTokenSource();

        try
        {
            Progress = 30;
            StateHasChanged();

            var options = new ImageConversionOptions
            {
                OutputFormat = OutputFormat,
                Quality = Quality,
                ResizeEnabled = ResizeEnabled,
                Width = ResizeEnabled ? NewWidth : ImageWidth,
                Height = ResizeEnabled ? NewHeight : ImageHeight,
                KeepAspectRatio = KeepAspectRatio,
                OptimizeSize = OptimizeSize
            };

            Progress = 60;
            StateHasChanged();

            ConvertedData = await ImageService.ConvertAdvancedAsync(InputFilePath, options);
            ConvertedSize = ConvertedData.Length;

            Progress = 100;
            IsConverted = true;

            Logger.LogInfo($"Изображения: конвертация завершена - {FileName} -> {OutputFormat} ({ConvertedSize} байт)");
            await ShowToast("✅ Конвертация завершена!", ToastType.Success);
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            Logger.LogInfo("Изображения: конвертация отменена");
            await ShowToast("⚠️ Конвертация отменена", ToastType.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogError("Изображения: ошибка конвертации", ex);
            await ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
        finally
        {
            IsConverting = false;
            StateHasChanged();
        }
    }

    private void CancelConversion() => Cts?.Cancel();

    private async Task SaveFile()
    {
        if (ConvertedData == null)
        {
            await ShowToast("❌ Нет данных для сохранения", ToastType.Error);
            return;
        }

        try
        {
            var folder = await Win32FolderPicker.PickFolderAsync("Выберите папку для сохранения");
            if (string.IsNullOrEmpty(folder))
            {
                await ShowToast("⚠️ Сохранение отменено", ToastType.Warning);
                return;
            }

            var baseName = Path.GetFileNameWithoutExtension(FileName);
            var suggestedName = $"{baseName}_converted.{OutputFormat}";
            var savePath = Path.Combine(folder, suggestedName);

            await File.WriteAllBytesAsync(savePath, ConvertedData);
            SavedFilePath = savePath;

            Logger.LogInfo($"Изображения: файл сохранён - {savePath}");
            await ShowToast("✅ Файл сохранён", ToastType.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError("Изображения: ошибка сохранения", ex);
            await ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
    }

    private async Task OpenFolder()
    {
        if (string.IsNullOrEmpty(SavedFilePath) || !File.Exists(SavedFilePath))
        {
            _ = ShowToast("⚠️ Файл не найден", ToastType.Warning);
            return;
        }

        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = "/select,\"" + SavedFilePath + "\"",
                UseShellExecute = true
            };
            System.Diagnostics.Process.Start(psi);
        }
        catch (Exception ex)
        {
            Logger.LogError("Изображения: ошибка открытия папки", ex);
            _ = ShowToast($"❌ Ошибка: {ex.Message}", ToastType.Error);
        }
    }

    private void ResetConverter()
    {
        InputFilePath = null;
        FileName = "";
        FileSize = "";
        InputFormat = "";
        ImageWidth = 0;
        ImageHeight = 0;
        OutputFormat = "png";
        Quality = 85;
        ResizeEnabled = false;
        NewWidth = 0;
        NewHeight = 0;
        KeepAspectRatio = true;
        OptimizeSize = false;
        IsConverting = false;
        IsConverted = false;
        Progress = 0;
        PreviewBase64 = "";
        ConvertedData = null;
        OriginalSize = 0;
        ConvertedSize = 0;
        SavedFilePath = null;
        _showFileDetailsModal = false;
        _activeCategory = CategoryPopular;
        Cts?.Dispose();
        Cts = null;
        StateHasChanged();
    }

    private string FormatBytes(long bytes)
    {
        const long kb = 1024, mb = kb * 1024, gb = mb * 1024;
        if (bytes >= gb) return $"{(bytes / (double)gb):F2} ГБ";
        if (bytes >= mb) return $"{(bytes / (double)mb):F2} МБ";
        if (bytes >= kb) return $"{(bytes / (double)kb):F2} КБ";
        return $"{bytes} Б";
    }

