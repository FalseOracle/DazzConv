@page "/image"
@using ConverToDazz.Core.Services
@using ConverToDazz.Core.Models
@using DazzConv.Services
@using Microsoft.AspNetCore.Components.Forms
@inject ImageConverterService ImageService
@inject IJSRuntime JSRuntime
@inject LoggerService Logger
@inject HotkeyService Hotkeys

<h3 class="text-center mb-4">Конвертер Изображений</h3>

<div class="card mb-4" id="uploadSection">
    <div class="card-body text-center">
        <button class="btn btn-primary btn-lg" @onclick="SelectFile">
            <i class="bi bi-image"></i> Выбрать изображение
        </button>
        <p class="text-muted mt-2 mb-0">
            22 формата: JPG, PNG, WebP, AVIF, GIF, HEIC, TIFF, BMP, PNM, PSD,
            TGA, DDS, PCX, SGI, DPX, EXR, HDR, CINEON, ICO, JXL, QOI, Farbfeld
        </p>
    </div>
</div>

@if (!string.IsNullOrEmpty(InputFilePath))
{
    <div class="row">
        <!-- 🆕 КОМПАКТНАЯ КАРТОЧКА ФАЙЛА -->
        <div class="col-md-12 mb-4">
            <div class="file-card">
                <div class="file-card-icon image">
                    <i class="bi bi-image-fill"></i>
                </div>
                <div class="file-card-info">
                    <div class="file-card-name" title="@FileName">@FileName</div>
                    <div class="file-card-meta">
                        <span><i class="bi bi-aspect-ratio"></i> @ImageWidth × @ImageHeight px</span>
                        <span><i class="bi bi-hdd"></i> @FileSize</span>
                        <span class="badge bg-@GetFormatBadgeColor(InputFormat)">@InputFormat.ToUpper()</span>
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-primary" @onclick="ShowFileDetails" title="Подробная информация">
                    <i class="bi bi-info-circle"></i> Детали
                </button>
            </div>
        </div>

        <!-- Настройки конвертации -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">🎨 Настройки конвертации</h5>
                </div>
                <div class="card-body">
                    <!-- Выходной формат -->
                    <div class="mb-3">
                        <label class="form-label"><strong>Выходной формат:</strong></label>
                        <select class="form-select form-select-lg" value="@OutputFormat" @onchange="OnFormatChanged">
                            @foreach (var format in SupportedOutputFormats)
                            {
                                <option value="@format">@format.ToUpper() - @GetFormatName(format)</option>
                            }
                        </select>

                        @if (OutputFormat == "ico")
                        {
                            <div class="alert alert-info mt-2 mb-0 py-2 small">
                                <i class="bi bi-info-circle me-1"></i>
                                <strong>ICO:</strong> Максимум 256×256 px, автоуменьшение.
                            </div>
                        }
                        else if (OutputFormat == "avif" || OutputFormat == "heic" || OutputFormat == "heif")
                        {
                            <div class="alert alert-info mt-2 mb-0 py-2 small">
                                <i class="bi bi-info-circle me-1"></i>
                                <strong>@OutputFormat.ToUpper():</strong> Лучшее сжатие, но не везде поддерживается.
                            </div>
                        }
                        else if (OutputFormat == "jxl")
                        {
                            <div class="alert alert-info mt-2 mb-0 py-2 small">
                                <i class="bi bi-info-circle me-1"></i>
                                <strong>JPEG XL:</strong> Преемник JPEG. Lossless + прогрессивная загрузка.
                            </div>
                        }
                        else if (OutputFormat == "gif")
                        {
                            <div class="alert alert-warning mt-2 mb-0 py-2 small">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                <strong>GIF:</strong> Только 256 цветов, не для фотографий.
                            </div>
                        }
                        else if (OutputFormat == "exr" || OutputFormat == "hdr" || OutputFormat == "dpx")
                        {
                            <div class="alert alert-info mt-2 mb-0 py-2 small">
                                <i class="bi bi-stars me-1"></i>
                                <strong>@OutputFormat.ToUpper():</strong> Профессиональный формат для VFX/HDR.
                            </div>
                        }
                        else if (OutputFormat == "dds")
                        {
                            <div class="alert alert-info mt-2 mb-0 py-2 small">
                                <i class="bi bi-gpu-card me-1"></i>
                                <strong>DDS:</strong> GPU-сжатие для игр (DirectX).
                            </div>
                        }
                        else if (OutputFormat == "psd")
                        {
                            <div class="alert alert-warning mt-2 mb-0 py-2 small">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                <strong>PSD:</strong> Только чтение слоёв, запись ограничена.
                            </div>
                        }
                    </div>

                    <!-- Качество -->
                    @if (ShowQualitySlider)
                    {
                        <div class="mb-3">
                            <label class="form-label">
                                <strong>Качество: @Quality%</strong>
                                <span class="text-muted ms-2 small">@GetQualityDescription(Quality)</span>
                            </label>
                            <input type="range" class="form-range" min="1" max="100" step="5"
                                   value="@Quality" @oninput="OnQualityChanged" />
                            <div class="d-flex justify-content-between small">
                                <span class="text-muted">Мин. размер</span>
                                <span class="text-muted">Баланс</span>
                                <span class="text-muted">Макс. качество</span>
                            </div>
                        </div>
                    }

                    <!-- Изменение размера -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="ResizeEnabled" id="resizeCheck" />
                            <label class="form-check-label" for="resizeCheck">
                                <strong>Изменить размер</strong>
                            </label>
                        </div>

                        @if (ResizeEnabled)
                        {
                            <div class="row mt-2 g-2">
                                <div class="col-6">
                                    <label class="form-label small mb-1">Ширина (px)</label>
                                    <input type="number"
                                           class="form-control form-control-sm @(IsValidImageSize(NewWidth) ? "" : "is-invalid")"
                                           @bind="NewWidth" min="1" max="8192" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-1">Высота (px)</label>
                                    <input type="number"
                                           class="form-control form-control-sm @(IsValidImageSize(NewHeight) ? "" : "is-invalid")"
                                           @bind="NewHeight" min="1" max="8192" />
                                </div>
                            </div>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" @bind="KeepAspectRatio" id="aspectCheck" />
                                <label class="form-check-label small" for="aspectCheck">
                                    Сохранить пропорции
                                </label>
                            </div>
                        }
                    </div>

                    <!-- Оптимизация -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="OptimizeSize" id="optimizeCheck" />
                            <label class="form-check-label" for="optimizeCheck">
                                Оптимизировать размер файла
                            </label>
                        </div>
                    </div>

                    <!-- Кнопки управления -->
                    <div class="d-grid gap-2 mt-4">
                        <button class="btn btn-success btn-lg" @onclick="StartConversion" disabled="@IsConverting">
                            <i class="bi bi-play-circle"></i> @(IsConverting ? "Конвертация..." : "Начать конвертацию")
                        </button>
                        <button class="btn btn-danger" @onclick="CancelConversion" disabled="@(!IsConverting)">
                            <i class="bi bi-x-circle"></i> Отмена
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 🆕 БЛОК СОВЕТОВ ПО ФОРМАТАМ -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 border-info">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">💡 Какой формат выбрать?</h5>
                </div>

                <!-- 🆕 ТАБЫ КАТЕГОРИЙ -->
                <div class="tip-tabs">
                    <button class="tip-tab @(_activeCategory == CategoryPopular ? "active" : "")"
                            @onclick="@(() => SetCategory(CategoryPopular))">
                        <i class="bi bi-globe"></i>
                        <span>Популярные</span>
                    </button>
                    <button class="tip-tab @(_activeCategory == CategoryDesign ? "active" : "")"
                            @onclick="@(() => SetCategory(CategoryDesign))">
                        <i class="bi bi-palette"></i>
                        <span>Дизайн</span>
                    </button>
                    <button class="tip-tab @(_activeCategory == CategoryGames ? "active" : "")"
                            @onclick="@(() => SetCategory(CategoryGames))">
                        <i class="bi bi-controller"></i>
                        <span>Игры</span>
                    </button>
                    <button class="tip-tab @(_activeCategory == CategoryVfx ? "active" : "")"
                            @onclick="@(() => SetCategory(CategoryVfx))">
                        <i class="bi bi-film"></i>
                        <span>Видео/VFX</span>
                    </button>
                    <button class="tip-tab @(_activeCategory == CategorySpecial ? "active" : "")"
                            @onclick="@(() => SetCategory(CategorySpecial))">
                        <i class="bi bi-tools"></i>
                        <span>Спец.</span>
                    </button>
                </div>

                <div class="card-body p-0">
                    <div class="format-tips fade-in">
                        <!-- 🌐 ПОПУЛЯРНЫЕ -->
                        @if (_activeCategory == CategoryPopular)
                        {
                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("jpg"))">
                                <div class="format-tip-icon jpg">
                                    <i class="bi bi-camera"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        JPEG
                                        <span class="badge bg-success ms-1">Стандарт</span>
                                    </div>
                                    <div class="format-tip-desc">Фото, соцсети, универсальный. С 1992 года</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("png"))">
                                <div class="format-tip-icon png">
                                    <i class="bi bi-file-image"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        PNG
                                        <span class="badge bg-info ms-1">Lossless</span>
                                    </div>
                                    <div class="format-tip-desc">Прозрачность, логотипы, скриншоты</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("webp"))">
                                <div class="format-tip-icon webp">
                                    <i class="bi bi-globe2"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        WebP
                                        <span class="badge bg-primary ms-1">Google</span>
                                    </div>
                                    <div class="format-tip-desc">На 30% меньше JPG. Стандарт веба с 2010</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("avif"))">
                                <div class="format-tip-icon avif">
                                    <i class="bi bi-stars"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        AVIF
                                        <span class="badge bg-warning text-dark ms-1">2019</span>
                                    </div>
                                    <div class="format-tip-desc">Лучшее сжатие на сегодня. На основе AV1</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("gif"))">
                                <div class="format-tip-icon gif">
                                    <i class="bi bi-emoji-laughing"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        GIF
                                        <span class="badge bg-dark ms-1">Мемы</span>
                                    </div>
                                    <div class="format-tip-desc">Анимации, 256 цветов. Легенда с 1987</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("heic"))">
                                <div class="format-tip-icon heic">
                                    <i class="bi bi-apple"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        HEIC
                                        <span class="badge bg-secondary ms-1">Apple</span>
                                    </div>
                                    <div class="format-tip-desc">Стандарт iPhone с 2017. Эффективное сжатие</div>
                                </div>
                            </div>
                        }

                        <!-- 🎨 ДИЗАЙН/ПЕЧАТЬ -->
                        @if (_activeCategory == CategoryDesign)
                        {
                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("tiff"))">
                                <div class="format-tip-icon tiff">
                                    <i class="bi bi-printer"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        TIFF
                                        <span class="badge bg-danger ms-1">Print</span>
                                    </div>
                                    <div class="format-tip-desc">Полиграфия, CMYK, сканеры. С 1986 года</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("bmp"))">
                                <div class="format-tip-icon bmp">
                                    <i class="bi bi-file-earmark-image"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">BMP</div>
                                    <div class="format-tip-desc">Без сжатия, Windows-стандарт. Большой размер</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("pnm"))">
                                <div class="format-tip-icon pnm">
                                    <i class="bi bi-terminal"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">PNM (PBM/PGM/PPM)</div>
                                    <div class="format-tip-desc">Unix-формат 80-х. Простой текстовый</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("psd"))">
                                <div class="format-tip-icon psd">
                                    <i class="bi bi-brush"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        PSD
                                        <span class="badge bg-info ms-1">Photoshop</span>
                                    </div>
                                    <div class="format-tip-desc">Adobe Photoshop, слои. Только чтение</div>
                                </div>
                            </div>
                        }

                        <!-- 🎮 ДЛЯ ИГР -->
                        @if (_activeCategory == CategoryGames)
                        {
                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("tga"))">
                                <div class="format-tip-icon tga">
                                    <i class="bi bi-joystick"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        TGA (Targa)
                                        <span class="badge bg-warning text-dark ms-1">Retro</span>
                                    </div>
                                    <div class="format-tip-desc">Quake, Half-Life, DOS-игры. С 1984 года</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("dds"))">
                                <div class="format-tip-icon dds">
                                    <i class="bi bi-gpu-card"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        DDS
                                        <span class="badge bg-primary ms-1">DirectX</span>
                                    </div>
                                    <div class="format-tip-desc">Современные игры, GPU-сжатие (DXT/BC)</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("pcx"))">
                                <div class="format-tip-icon pcx">
                                    <i class="bi bi-cpu"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        PCX
                                        <span class="badge bg-secondary ms-1">DOS</span>
                                    </div>
                                    <div class="format-tip-desc">Duke Nukem, Commander Keen, 90-е</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("sgi"))">
                                <div class="format-tip-icon sgi">
                                    <i class="bi bi-box"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">SGI / RGB</div>
                                    <div class="format-tip-desc">Silicon Graphics, старые 3D-станции</div>
                                </div>
                            </div>
                        }

                        <!-- 🎬 ВИДЕО/VFX -->
                        @if (_activeCategory == CategoryVfx)
                        {
                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("dpx"))">
                                <div class="format-tip-icon dpx">
                                    <i class="bi bi-camera-reels"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        DPX
                                        <span class="badge bg-danger ms-1">Hollywood</span>
                                    </div>
                                    <div class="format-tip-desc">Киносканеры, Kodak. Стандарт DI с 1994</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("exr"))">
                                <div class="format-tip-icon exr">
                                    <i class="bi bi-stars"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        OpenEXR
                                        <span class="badge bg-warning text-dark ms-1">ILM</span>
                                    </div>
                                    <div class="format-tip-desc">HDR, VFX, Star Wars/Marvel. С 1999 года</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("hdr"))">
                                <div class="format-tip-icon hdr">
                                    <i class="bi bi-brightness-high"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">HDR (Radiance)</div>
                                    <div class="format-tip-desc">HDR-освещение, 3D-рендеры, HDRI-карты</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("cin"))">
                                <div class="format-tip-icon cin">
                                    <i class="bi bi-film"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">CINEON</div>
                                    <div class="format-tip-desc">Предшественник DPX, Kodak. Редкий</div>
                                </div>
                            </div>
                        }

                        <!-- 🔧 СПЕЦФОРМАТЫ -->
                        @if (_activeCategory == CategorySpecial)
                        {
                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("ico"))">
                                <div class="format-tip-icon ico">
                                    <i class="bi bi-app-indicator"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">ICO</div>
                                    <div class="format-tip-desc">Иконки Windows, favicon. До 256×256 px</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("jxl"))">
                                <div class="format-tip-icon jxl">
                                    <i class="bi bi-lightning-charge"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        JPEG XL
                                        <span class="badge bg-success ms-1">2022</span>
                                    </div>
                                    <div class="format-tip-desc">Преемник JPEG. Lossless + лучшее сжатие</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("qoi"))">
                                <div class="format-tip-icon qoi">
                                    <i class="bi bi-speedometer2"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">
                                        QOI
                                        <span class="badge bg-info ms-1">Fast</span>
                                    </div>
                                    <div class="format-tip-desc">Quite OK Image. В 10× быстрее PNG (2021)</div>
                                </div>
                            </div>

                            <div class="format-tip-item" @onclick="@(() => QuickFormatSelect("ff"))">
                                <div class="format-tip-icon ff">
                                    <i class="bi bi-file-code"></i>
                                </div>
                                <div class="format-tip-info">
                                    <div class="format-tip-name">Farbfeld</div>
                                    <div class="format-tip-desc">suckless.org. Простой lossless, pipe-friendly</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Прогресс -->
        @if (IsConverting)
        {
            <div class="col-md-12 mb-4">
                <div class="card border-warning">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="spinner-border text-warning" role="status">
                                <span class="visually-hidden">Загрузка...</span>
                            </div>
                            <div>
                                <h5 class="mb-0">⏳ Конвертация изображения...</h5>
                                <small class="text-muted">@Progress%</small>
                            </div>
                        </div>
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning text-dark"
                                 role="progressbar" style="width: @Progress%">
                                <strong>@Progress%</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- 🆕 РЕЗУЛЬТАТ КОНВЕРТАЦИИ (как в AudioConverter) -->
        @if (IsConverted && ConvertedData != null)
        {
            <div class="col-md-12 mb-4">
                <div class="card border-success">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="success-icon me-3">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 text-success">Конвертация завершена!</h6>
                                <small class="text-muted">
                                    Формат: <strong>@OutputFormat.ToUpper()</strong>
                                    @if (ConvertedSize > 0)
                                    {
                                        <span> • @FormatBytes(ConvertedSize)</span>
                                        @if (OriginalSize > 0)
                                        {
                                            var change = ((double)(ConvertedSize - OriginalSize) / OriginalSize * 100);
                                            <span class="@((change < 0) ? "text-success" : "text-danger") ms-2">
                                                (@(change > 0 ? "+" : "")@change.ToString("F1")%)
                                            </span>
                                        }
                                    }
                                </small>
                            </div>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-success" @onclick="SaveFile">
                                <i class="bi bi-download me-2"></i>Сохранить на диск...
                            </button>

                            @if (!string.IsNullOrEmpty(SavedFilePath) && File.Exists(SavedFilePath))
                            {
                                <button class="btn btn-outline-primary" @onclick="OpenFolder">
                                    <i class="bi bi-folder2-open me-2"></i>Открыть папку
                                </button>
                            }
                            <button class="btn btn-outline-secondary" @onclick="ResetConverter">
                                <i class="bi bi-arrow-clockwise me-2"></i>Новый файл
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(SavedFilePath))
                        {
                            <div class="mt-3 small text-muted">
                                <i class="bi bi-check-circle text-success me-1"></i>
                                Сохранено: @SavedFilePath
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- 🆕 МОДАЛЬНОЕ ОКНО С ДЕТАЛЯМИ + ПРЕВЬЮ -->
@if (_showFileDetailsModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content details-modal">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-info-circle me-2"></i>Информация об изображении
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseFileDetails"></button>
                </div>
                <div class="modal-body">
                    <!-- Превью -->
                    @if (!string.IsNullOrEmpty(PreviewBase64))
                    {
                        <div class="image-preview-container mb-3">
                            <img src="data:image/png;base64,@PreviewBase64"
                                 class="img-fluid rounded"
                                 alt="Preview" />
                        </div>
                    }

                    <!-- Заголовок -->
                    <div class="details-title mb-3">
                        <div class="d-flex align-items-center">
                            <div class="file-modal-icon image me-3">
                                <i class="bi bi-image-fill"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">@FileName</h6>
                                <small class="text-muted">Исходное изображение</small>
                            </div>
                        </div>
                    </div>

                    <!-- Таблица деталей -->
                    <div class="details-table">
                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-file-earmark text-primary"></i> Формат
                            </div>
                            <div class="detail-value">
                                <span class="badge bg-@GetFormatBadgeColor(InputFormat) fs-6">
                                    @InputFormat.ToUpper()
                                </span>
                                <small class="text-muted ms-2">@GetFormatFullName(InputFormat)</small>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-aspect-ratio text-info"></i> Разрешение
                            </div>
                            <div class="detail-value">
                                <strong>@ImageWidth × @ImageHeight px</strong>
                                <small class="text-muted ms-2">
                                    (@(((long)ImageWidth * ImageHeight).ToString("N0")) пикселей,
                                    @GetAspectRatioName(ImageWidth, ImageHeight))
                                </small>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-hdd text-warning"></i> Размер
                            </div>
                            <div class="detail-value">
                                <strong>@FileSize</strong>
                                <small class="text-muted ms-2">(@OriginalSize.ToString("N0") байт)</small>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-folder text-secondary"></i> Путь
                            </div>
                            <div class="detail-value">
                                <div class="d-flex align-items-start gap-2">
                                    <span class="text-break flex-grow-1" title="@InputFilePath">
                                        @InputFilePath
                                    </span>
                                    <button class="btn btn-sm btn-outline-secondary flex-shrink-0"
                                            @onclick="@(() => CopyToClipboard(InputFilePath ?? string.Empty))"
                                            title="Скопировать путь">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="bi bi-check-circle text-success"></i> Файл существует
                            </div>
                            <div class="detail-value">
                                @if (!string.IsNullOrEmpty(InputFilePath) && File.Exists(InputFilePath))
                                {
                                    <span class="badge bg-success">✅ Да</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">❌ Нет</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-primary" @onclick="@(() => CopyToClipboard(FileName))">
                        <i class="bi bi-clipboard me-1"></i> Копировать имя
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="@(() => CopyToClipboard(InputFilePath ?? string.Empty))">
                        <i class="bi bi-link-45deg me-1"></i> Копировать путь
                    </button>
                    <button class="btn btn-success" @onclick="OpenInputFileLocation">
                        <i class="bi bi-folder2-open me-1"></i> Открыть папку
                    </button>
                    <button class="btn btn-secondary" @onclick="CloseFileDetails">
                        <i class="bi bi-x-lg me-1"></i> Закрыть
                    </button>
                </div>
            </div>
        </div>
    </div>
}

