    {
        "jpg" or "jpeg" => "универсальный",
        "png" => "без потерь",
        "webp" => "Google, для веба",
        "avif" => "лучшее сжатие",
        "gif" => "анимации, 256 цветов",
        "heic" or "heif" => "Apple iPhone",
        "tiff" or "tif" => "полиграфия, CMYK",
        "bmp" => "без сжатия, Windows",
        "pnm" or "pbm" or "pgm" or "ppm" => "Unix, простой",
        "psd" => "Photoshop",
        "tga" => "старые игры, Targa",
        "dds" => "DirectX текстуры",
        "pcx" => "DOS-игры",
        "sgi" or "rgb" => "Silicon Graphics",
        "dpx" => "киносканеры",
        "exr" => "VFX, HDR, ILM",
        "hdr" => "HDR-освещение",
        "cin" => "Kodak Cineon",
        "ico" => "иконки Windows",
        "jxl" => "преемник JPEG",
        "qoi" => "быстрый lossless",
        "ff" => "farbfeld, простой",
        _ => format.ToUpper()
    };

    private async Task ShowToast(string message, ToastType type = ToastType.Info)
    {
        try { await JSRuntime.InvokeVoidAsync("showToast", message, type.ToString().ToLower()); }
        catch { await JSRuntime.InvokeVoidAsync("alert", message); }
    }

    private enum ToastType { Success, Error, Warning, Info }
}