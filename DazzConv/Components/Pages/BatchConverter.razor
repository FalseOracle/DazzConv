    // ===== Управление файлами =====
    private void RemoveFile(string file)
    {
        var fileName = Path.GetFileName(file);
        SelectedFiles.Remove(file);
        _selectedFilesSet.Remove(fileName);

        try
        {
            if (File.Exists(file) && file.Contains("DazzConv_Batch"))
                File.Delete(file);
        }
        catch { }

        StateHasChanged();
    }

    private void ClearFiles()
    {
        foreach (var file in SelectedFiles)
        {
            try
            {
                if (!File.Exists(file)) continue;

                // 🛡️ ЗАЩИТА: удаляем ТОЛЬКО если файл в DazzConv_Batch И не в OutputPath
                if (!file.Contains("DazzConv_Batch")) continue;

                try
                {
                    var normalizedFile = Path.GetFullPath(file);
                    var normalizedOutput = Path.GetFullPath(OutputPath);

                    if (normalizedFile.StartsWith(normalizedOutput, StringComparison.OrdinalIgnoreCase))
                    {
                        Logger.LogWarning($"Batch: пропущено удаление — файл в OutputPath: {Path.GetFileName(file)}");
                        continue;
                    }
                }
                catch { }

                File.Delete(file);
            }
            catch { }
        }

        CleanupAllTempFiles();

        SelectedFiles.Clear();
        _selectedFilesSet.Clear();
        ConversionResults.Clear();
        BatchProgress = 0;
        StateHasChanged();
    }

    // ===== Конвертация =====
    private async Task StartBatchConversion()
    {

        // 🛡️ ВАЛИДАЦИЯ БИТРЕЙТА ДЛЯ AC3
        if (AudioOutputFormat == "ac3")
        {
            int[] validAc3Bitrates = { 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 384, 448, 512, 576, 640 };
            if (!validAc3Bitrates.Contains(AudioBitrate))
            {
                await JSRuntime.InvokeVoidAsync("showToast", 
                    $"⚠️ AC3 не поддерживает битрейт {AudioBitrate} kbps. Используется ближайший допустимый.", "warning");
                AudioBitrate = validAc3Bitrates.OrderBy(b => Math.Abs(b - AudioBitrate)).First();
            }
            if ((BatchType == "mixed" || BatchType == "video") &&
    SelectedFiles.Any(f => GetFileType(Path.GetExtension(f).ToLower()) == "video") &&
    !IsVideoFormatVerified(VideoOutputFormat))
            {
                var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
                    $"⚠️ Формат {VideoOutputFormat.ToUpper()} может не поддерживаться вашей сборкой FFmpeg.\n\n" +
                    $"Рекомендуется использовать: MP4, MKV или AVI.\n\n" +
                    $"Продолжить?");

                if (!confirm)
                {
                    await ShowNotification("Конвертация отменена", NotificationType.Warning);
                    return;
                }
            }
        }

        var invalidFiles = new List<string>();
        foreach (var file in SelectedFiles)
        {
            if (!File.Exists(file))
            {
                invalidFiles.Add($"{Path.GetFileName(file)} (файл не найден)");
                continue;
            }

            var ext = Path.GetExtension(file).ToLowerInvariant();
            if (!ValidateFileContent(file, ext))
            {
                invalidFiles.Add($"{Path.GetFileName(file)} (неверный формат)");
            }
        }

        if (invalidFiles.Any())
        {
            // Удаляем невалидные файлы из списка
            foreach (var invalidFile in invalidFiles)
            {
                var fileName = invalidFile.Split(" (")[0];
                var fileToRemove = SelectedFiles.FirstOrDefault(f => Path.GetFileName(f) == fileName);
                if (fileToRemove != null)
                {
                    SelectedFiles.Remove(fileToRemove);
                    _selectedFilesSet.Remove(fileName);
                }
            }

            Logger.LogWarning($"Удалено невалидных файлов перед конвертацией: {invalidFiles.Count}");

            // Показываем toast с деталями
            await ShowRejectionToast(invalidFiles, "⚠️ Обнаружены проблемные файлы");

            if (!SelectedFiles.Any())
            {
                await JSRuntime.InvokeVoidAsync("showToast",
                    "❌ Все файлы невалидны! Конвертация отменена.", "error");
                return;
            }
        }

        if (!SelectedFiles.Any())
        {
            await ShowNotification("Выберите файлы для конвертации", NotificationType.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(OutputPath))
        {
            await ShowNotification("Введите путь к папке для сохранения", NotificationType.Warning);
            return;
        }

        if (!IsValidOutputPath)
        {
            await ShowNotification("❌ Нельзя сохранять в системные папки!", NotificationType.Error);
            return;
        }

        try
        {
            if (!Directory.Exists(OutputPath))
                Directory.CreateDirectory(OutputPath);
        }
        catch (Exception ex)
        {
            await ShowNotification($"❌ Ошибка создания папки: {ex.Message}", NotificationType.Error);
            return;
        }

        bool wasCancelled = false;

        try
        {
            IsConverting = true;
            Cts = new CancellationTokenSource();
            ConversionResults.Clear();
            var ffmpegPath = FFmpegService.GetFFmpegPath();

            for (int i = 0; i < SelectedFiles.Count; i++)
            {
                // 🛡️ ПРОВЕРКА ОТМЕНЫ ПЕРЕД КАЖДЫМ ФАЙЛОМ
                if (Cts.IsCancellationRequested)
                {
                    wasCancelled = true;
                    ConversionStatus = "⚠️ Отменено пользователем";
                    Logger.LogInfo($"Batch: конвертация отменена на файле {i + 1}");
                    break;
                }

                CurrentFileIndex = i + 1;
                CurrentFileName = Path.GetFileName(SelectedFiles[i]);
                CurrentFileProgress = 0;
                ConversionStatus = $"Обработка файла {CurrentFileIndex} из {SelectedFiles.Count}...";

                if (i % 10 == 0 || i == SelectedFiles.Count - 1)
                {
                    BatchProgress = Math.Min(100, Math.Max(0, (int)((double)CurrentFileIndex / SelectedFiles.Count * 100)));
                }

                try { await InvokeAsync(StateHasChanged); } catch { }
                await Task.Delay(1);

                try
                {
                    var safeFileName = string.Join("_", Path.GetFileNameWithoutExtension(SelectedFiles[i]).Split(Path.GetInvalidFileNameChars()));
                    if (safeFileName.Length > 100) safeFileName = safeFileName.Substring(0, 100);

                    var fileExt = Path.GetExtension(SelectedFiles[i]);
                    var fileType = GetFileType(fileExt);

                    string outExt = fileType switch
                    {
                        "audio" => AudioOutputFormat,
                        "image" => ImageOutputFormat,
                        "video" => VideoOutputFormat,
                        _ => "bin"
                    };

                    var outputPath = Path.Combine(OutputPath, safeFileName + "." + outExt);

                    if (outputPath.Length > 250)
                    {
                        var maxNameLength = 250 - OutputPath.Length - outExt.Length - 2;
                        if (maxNameLength < 10) maxNameLength = 10;
                        safeFileName = safeFileName.Substring(0, Math.Min(safeFileName.Length, maxNameLength));
                        outputPath = Path.Combine(OutputPath, safeFileName + "." + outExt);
                    }

                    // 🛡️ ВАЖНО: проверяем что outputPath в OutputPath
                    if (!Path.GetFullPath(outputPath).StartsWith(Path.GetFullPath(OutputPath), StringComparison.OrdinalIgnoreCase))
                    {
                        throw new InvalidOperationException("Путь вывода находится вне выбранной папки!");
                    }

                    var startTime = DateTime.Now;

                    if (fileType == "audio")
                        await ConvertAudioFile(ffmpegPath, SelectedFiles[i], outputPath);
                    else if (fileType == "image")
                        await ConvertImageFile(SelectedFiles[i], outputPath);
                    else if (fileType == "video")
                        await ConvertVideoFile(ffmpegPath, SelectedFiles[i], outputPath);
                    else
                        throw new InvalidOperationException($"Неподдерживаемый тип файла: {fileExt}");

                    var elapsed = (DateTime.Now - startTime).TotalMilliseconds;
                    if (elapsed < 100)
                    {
                        CurrentFileProgress = 100;
                        try { await InvokeAsync(StateHasChanged); } catch { }
                        await Task.Delay(50);
                    }

                    ConversionResults.Add(new ConversionResult
                    {
                        FilePath = SelectedFiles[i],
                        OutputPath = outputPath,
                        Success = true,
                        Message = "Успешно"
                    });
                }
                catch (OperationCanceledException)
                {
                    wasCancelled = true;
                    Logger.LogInfo($"Batch: отмена на файле {Path.GetFileName(SelectedFiles[i])}");
                    break;
                }
                catch (Exception ex)
                {
                    // 🛡️ НЕ прерываем при ошибке одного файла
                    Logger.LogError($"Ошибка конвертации {SelectedFiles[i]}", ex);
                    ConversionResults.Add(new ConversionResult
                    {
                        FilePath = SelectedFiles[i],
                        Success = false,
                        Message = ex.Message.Length > 150 ? ex.Message.Substring(0, 150) + "..." : ex.Message
                    });
                }

                if (i % 10 == 0 || i == SelectedFiles.Count - 1)
                {
                    BatchProgress = Math.Min(100, Math.Max(0, (int)((double)CurrentFileIndex / SelectedFiles.Count * 100)));
                    try { await InvokeAsync(StateHasChanged); } catch { }
                }
            }

            var successCount = ConversionResults.Count(r => r.Success);
            var failCount = ConversionResults.Count(r => !r.Success);

            if (wasCancelled)
            {
                await ShowNotification($"⚠️ Конвертация отменена\n\nУспешно: {successCount}\nОшибок: {failCount}", NotificationType.Warning);
            }
            else if (successCount > 0)
            {
                await ShowNotification($"✅ Конвертация завершена!\n\nУспешно: {successCount}\nОшибок: {failCount}\n\nПапка: {OutputPath}", NotificationType.Success);
            }
            else
            {
                await ShowNotification($"❌ Все файлы завершились ошибкой!", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError("Критическая ошибка пакетной конвертации", ex);
            await ShowNotification($"Критическая ошибка: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsConverting = false;
            BatchProgress = wasCancelled ? BatchProgress : 100;

            try { Cts?.Dispose(); } catch { }
            Cts = null;

            // 🛡️ Чистим temp ТОЛЬКО если не было отмены
            if (!wasCancelled)
            {
                CleanupAllTempFiles();
            }
            else
            {
                Logger.LogInfo("Batch: отмена — временные файлы сохранены");
            }

            try { await InvokeAsync(StateHasChanged); } catch { }
        }
    }

    private async Task ConvertAudioFile(string ffmpegPath, string inputFile, string outputFile)
    {
        var audioCodec = GetAudioCodecForFormat(AudioOutputFormat);
        var bitrate = AudioBitrate;

        if (AudioOutputFormat == "ac3")
        {
            bitrate = GetValidAc3Bitrate(bitrate);
            if (bitrate > 640) bitrate = 640;
        }

        await AudioService.ConvertAsync(ffmpegPath, inputFile, outputFile, TimeSpan.Zero,
            new Progress<int>(p =>
            {
                if (Cts?.IsCancellationRequested ?? true) return;
                CurrentFileProgress = Math.Max(0, Math.Min(100, p));
                try { InvokeAsync(StateHasChanged); } catch { }
            }),
            Cts!.Token);

        if (!(Cts?.IsCancellationRequested ?? false))
            CleanupTempFile(inputFile);
    }

    private async Task ConvertImageFile(string inputFile, string outputFile)
    {
        if (inputFile.Length > 240)
            throw new InvalidOperationException($"Путь слишком длинный ({inputFile.Length} символов).");

        if (!File.Exists(inputFile))
            throw new FileNotFoundException($"Файл не найден: {inputFile}");

        var fileInfo = new FileInfo(inputFile);
        if (fileInfo.Length == 0)
            throw new InvalidOperationException("Файл пустой (0 байт)");

        if (fileInfo.Length > 500L * 1024 * 1024)
            throw new InvalidOperationException($"Файл слишком большой ({FormatFileSize(fileInfo.Length)})");

        try
        {
            CurrentFileProgress = 10;
            try { InvokeAsync(StateHasChanged); } catch { }

            var options = new ImageConversionOptions
            {
                OutputFormat = ImageOutputFormat,
                Quality = ImageQuality,
                ResizeEnabled = ResizeImages,
                Width = ImageWidth,
                Height = ImageHeight,
                KeepAspectRatio = KeepAspectRatio,
                OptimizeSize = OptimizeImages
            };

            CurrentFileProgress = 30;
            try { InvokeAsync(StateHasChanged); } catch { }

            byte[] data;
            try
            {
                data = await ImageService.ConvertAdvancedAsync(inputFile, options);
            }
            catch (ImageMagick.MagickCoderErrorException ex) when (
                ex.Message.Contains("iCCP", StringComparison.OrdinalIgnoreCase) ||
                ex.Message.Contains("profile", StringComparison.OrdinalIgnoreCase))
            {
                Logger.LogWarning($"Batch: iCCP ошибка в {Path.GetFileName(inputFile)}, пробуем без профиля");
                CurrentFileProgress = 50;
                try { InvokeAsync(StateHasChanged); } catch { }
                data = await ConvertImageWithStripProfile(inputFile, options);
            }

            if (Cts?.IsCancellationRequested ?? false)
                throw new OperationCanceledException(Cts.Token);

            CurrentFileProgress = 85;
            try { InvokeAsync(StateHasChanged); } catch { }

            await File.WriteAllBytesAsync(outputFile, data, Cts!.Token);

            CurrentFileProgress = 100;
            try { InvokeAsync(StateHasChanged); } catch { }
        }
        catch (ImageMagick.MagickMissingDelegateErrorException ex)
        {
            throw new InvalidOperationException($"Формат не поддерживается: {ex.Message}");
        }
        catch (ImageMagick.MagickException ex)
        {
            throw new InvalidOperationException($"Ошибка ImageMagick: {ex.Message}");
        }

        if (!(Cts?.IsCancellationRequested ?? false))
            CleanupTempFile(inputFile);
    }

    private Task<byte[]> ConvertImageWithStripProfile(string inputPath, ImageConversionOptions options)
    {
        return Task.Run(() =>
        {
            var settings = new ImageMagick.MagickReadSettings
            {
                ColorSpace = ImageMagick.ColorSpace.sRGB
            };

            using var image = new ImageMagick.MagickImage(inputPath, settings);
            image.Strip();
            image.ColorSpace = ImageMagick.ColorSpace.sRGB;

            if (options.ResizeEnabled)
            {
                if (options.KeepAspectRatio)
                {
                    image.Resize(new ImageMagick.MagickGeometry((uint)options.Width, (uint)options.Height)
                    {
                        IgnoreAspectRatio = false
                    });
                }
                else
                {
                    image.Resize((uint)options.Width, (uint)options.Height);
                }
            }

            image.Quality = (uint)options.Quality;

            var format = options.OutputFormat.ToLower() switch
            {
                // Популярные
                "png" => ImageMagick.MagickFormat.Png,
                "jpg" or "jpeg" => ImageMagick.MagickFormat.Jpeg,
                "webp" => ImageMagick.MagickFormat.WebP,
                "avif" => ImageMagick.MagickFormat.Avif,
                "gif" => ImageMagick.MagickFormat.Gif,
                "heic" or "heif" => ImageMagick.MagickFormat.Heic,
                "bmp" => ImageMagick.MagickFormat.Bmp,
                "tiff" or "tif" => ImageMagick.MagickFormat.Tiff,
                "pnm" or "ppm" => ImageMagick.MagickFormat.Ppm,
                "pbm" => ImageMagick.MagickFormat.Pbm,
                "pgm" => ImageMagick.MagickFormat.Pgm,
                "psd" => ImageMagick.MagickFormat.Psd,
                "tga" => ImageMagick.MagickFormat.Tga,
                "dds" => ImageMagick.MagickFormat.Dds,
                "pcx" => ImageMagick.MagickFormat.Pcx,
                "sgi" or "rgb" => ImageMagick.MagickFormat.Sgi,
                "dpx" => ImageMagick.MagickFormat.Dpx,
                "exr" => ImageMagick.MagickFormat.Exr,
                "hdr" => ImageMagick.MagickFormat.Hdr,
                "cin" => ImageMagick.MagickFormat.Cin,
                "ico" => ImageMagick.MagickFormat.Ico,
                "jxl" => ImageMagick.MagickFormat.Jxl,
                "qoi" => ImageMagick.MagickFormat.Qoi,
                "ff" => ImageMagick.MagickFormat.Farbfeld,
                _ => ImageMagick.MagickFormat.Png
            };

            if (format == ImageMagick.MagickFormat.Icon)
            {
                const int maxIconSize = 256;
                if (image.Width > maxIconSize || image.Height > maxIconSize)
                {
                    image.FilterType = ImageMagick.FilterType.Lanczos;
                    image.Resize(new ImageMagick.MagickGeometry((uint)maxIconSize, (uint)maxIconSize)
                    {
                        IgnoreAspectRatio = false
                    });
                }
                image.Format = ImageMagick.MagickFormat.Icon;
            }

            using var ms = new MemoryStream();
            image.Format = format;
            image.Write(ms);
            return ms.ToArray();
        });
    }

    private async Task ConvertVideoFile(string ffmpegPath, string inputFile, string outputFile)
    {
        await VideoService.ConvertAsync(
            ffmpegPath: ffmpegPath,
            inputFile: inputFile,
            outputFile: outputFile,
            outputFormat: VideoOutputFormat,
