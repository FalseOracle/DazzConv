@code {
    // ===== Основные поля =====
    private string BatchType = "mixed";
    private List<string> SelectedFiles = new();
    private string OutputPath = "";
    private HashSet<string> _selectedFilesSet = new();
    private bool _isDragOver = false;
    private bool IncludeSubfolders = false;

    // ===== Индикатор загрузки файлов =====
    private bool IsLoadingFiles = false;
    private int LoadingProgress = 0;
    private int LoadingFilesProcessed = 0;
    private int LoadingFilesTotal = 0;
    private int LoadingFilesRejected = 0;

    // ===== Audio settings =====
    private string AudioOutputFormat = "mp3";
    private int AudioBitrate = 192;
    private bool NormalizeAudio = false;

    // ===== Image settings =====
    private string ImageOutputFormat = "png";
    private int ImageQuality = 85;
    private bool ResizeImages = false;
    private int ImageWidth = 1920;
    private int ImageHeight = 1080;
    private bool KeepAspectRatio = true;
    private bool OptimizeImages = false;
    private bool AudioSupportsBitrate => AudioOutputFormat is
     "mp3" or "aac" or "ogg" or "opus" or "wma" or "m4a" or "ac3" or "amr" or "spx" or "mp2";
    private bool ImageSupportsQuality => ImageOutputFormat is
        "jpg" or "jpeg" or "webp" or "avif" or "heic" or "heif" or "jxl";
    private bool VideoSupportsCrf => VideoCodec is not "mpeg4";
    // Проверенные форматы, которые точно работают в FFmpeg
    private readonly HashSet<string> VerifiedVideoFormats = new()
    {
        "mp4", "mkv", "avi", "mov", "wmv", "flv", "webm",
        "m4v", "3gp", "mpeg", "mpg", "vob"
    };

    // Форматы, которые могут не работать в некоторых сборках FFmpeg
    private readonly HashSet<string> UnverifiedVideoFormats = new()
    {
        "ts", "m2ts", "ogv", "asf", "rm", "divx", "f4v"
    };

    private bool IsVideoFormatVerified(string format)
    {
        return VerifiedVideoFormats.Contains(format.ToLower());
    }

    private string GetFormatWarning(string format)
    {
        if (UnverifiedVideoFormats.Contains(format.ToLower()))
        {
            return $"⚠️ Формат {format.ToUpper()} может не поддерживаться вашей сборкой FFmpeg. Рекомендуется использовать MP4, MKV или AVI.";
        }
        return "";
    }


    // ===== Video settings =====
    private string VideoOutputFormat = "mp4";
    private string VideoCodec = "libx264";
    private int VideoCrf = 23;
    private int VideoQScale = 2;
    private string VideoPreset = "medium";
    private string VideoResolution = "";
    private int VideoAudioBitrate = 192;
    private string VideoAudioCodec = "aac";
    private string VideoFps = "";

    // ===== Conversion state =====
    private bool IsConverting = false;
    private int CurrentFileIndex = 0;
    private string CurrentFileName = "";
    private string ConversionStatus = "";
    private List<ConversionResult> ConversionResults = new();
    private CancellationTokenSource? Cts;
    private int _displayedFilesCount = 10;

    private int _currentFileProgress;
    private int CurrentFileProgress
    {
        get => _currentFileProgress;
        set => _currentFileProgress = Math.Max(0, Math.Min(100, value));
    }

    private int _batchProgress;
    private int BatchProgress
    {
        get => _batchProgress;
        set => _batchProgress = Math.Max(0, Math.Min(100, value));
    }

    private void ShowMoreFiles()
    {
        _displayedFilesCount = Math.Min(_displayedFilesCount + 20, SelectedFiles.Count);
        StateHasChanged();
    }

    private void ShowLessFiles()
    {
        _displayedFilesCount = 10;
        StateHasChanged();
    }

    private NotificationMessage? CurrentNotification;

    // ===== Вспомогательные классы =====
    private class NotificationMessage
    {
        public string Message { get; set; } = "";
        public NotificationType Type { get; set; }
        public DateTime Timestamp { get; set; } = DateTime.Now;
    }

    private async Task ScrollResultsLeft()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("BatchScroll.scrollLeft", "resultsTable");
        }
        catch (Exception ex)
        {
            Logger.LogWarning($"Batch: ошибка прокрутки влево: {ex.Message}");
        }
    }

    private async Task ScrollResultsRight()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("BatchScroll.scrollRight", "resultsTable");
        }
        catch (Exception ex)
        {
            Logger.LogWarning($"Batch: ошибка прокрутки вправо: {ex.Message}");
        }
    }

    private void OpenFolder(string filePath)
    {
        try
        {
            var folder = Path.GetDirectoryName(filePath);
            if (!string.IsNullOrEmpty(folder) && Directory.Exists(folder))
            {
                var psi = new System.Diagnostics.ProcessStartInfo
                {
                    FileName = folder,
                    UseShellExecute = true
                };
                System.Diagnostics.Process.Start(psi);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning($"Batch: ошибка открытия папки {filePath}: {ex.Message}");
        }
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Подписываемся на горячие клавиши
                Hotkeys.OnCancelRequested += HandleCancel;

                // Инициализируем с защитой от ошибок
                await Hotkeys.InitializeAsync();
            }
            catch (Exception ex)
            {
                // Если горячие клавиши не работают — это не критично
                // Логируем и продолжаем работу
                try
                {
                    Logger.LogWarning($"Горячие клавиши не инициализированы: {ex.Message}");
                }
                catch { }
            }
        }
    }

    private async Task HandleCancel()
    {
        if (IsConverting) CancelBatchConversion();
    }


    private enum NotificationType
    {
        Success,
        Warning,
        Error,
        Info
    }
    private string GetTotalSize()
    {
        try
        {
            long total = 0;
            foreach (var file in SelectedFiles.Take(100))
            {
                try
                {
                    if (File.Exists(file))
                        total += new FileInfo(file).Length;
                }
                catch { }
            }
            return FormatFileSize(total);
        }
        catch
        {
            return "0 Б";
        }
    }

    private string GetFileSize(string filePath)
    {
        try
        {
            if (File.Exists(filePath))
                return FormatFileSize(new FileInfo(filePath).Length);
            return "0 Б";
        }
        catch
        {
            return "0 Б";
        }
    }

    private class ConversionResult
    {
        public string FilePath { get; set; } = "";
        public string OutputPath { get; set; } = "";
        public bool Success { get; set; }
        public string Message { get; set; } = "";
    }

    // ===== Инициализация =====
    protected override void OnInitialized()
    {
        OutputPath = GetDefaultOutputPath();
    }

    // ===== Валидация пути =====
    private bool IsValidOutputPath
    {
        get
        {
            if (string.IsNullOrWhiteSpace(OutputPath))
                return false;

            try
            {
                var invalidPaths = new[] {
                    @"C:\Windows",
                    @"C:\Windows\System32",
                    @"C:\Program Files",
                    @"C:\Program Files (x86)",
                    Environment.SystemDirectory,
                    Environment.GetFolderPath(Environment.SpecialFolder.Windows)
                };

                var normalizedPath = Path.GetFullPath(OutputPath).ToLower();
                return !invalidPaths.Any(p => normalizedPath.StartsWith(p.ToLower()));
            }
            catch
            {
                return false;
            }
        }
    }

    private string GetDefaultOutputPath()
    {
        return BatchType switch
        {
            "audio" => Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyMusic), "DazzConv_Batch"),
            "image" => Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyPictures), "DazzConv_Batch"),
            "video" => Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyVideos), "DazzConv_Batch"),
            _ => Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "DazzConv_Batch")
        };
    }

    private string GetAcceptTypes()
    {
        if (BatchType == "mixed")
        {
            return string.Join(",", AllowedExtensions.Values.SelectMany(x => x));
        }
        return string.Join(",", AllowedExtensions[BatchType]);
    }

    private string GetFileType(string extension)
    {
        var ext = extension.ToLowerInvariant();
        if (!ext.StartsWith(".")) ext = "." + ext;

        if (AllowedExtensions["audio"].Contains(ext)) return "audio";
        if (AllowedExtensions["image"].Contains(ext)) return "image";
        if (AllowedExtensions["video"].Contains(ext)) return "video";
        return "unknown";
    }

