    private string GetFileExtension(string filePath) => Path.GetExtension(filePath).TrimStart('.');

    private string FormatFileSize(long bytes)
    {
        if (bytes == 0) return "0 Б";
        const long kb = 1024, mb = kb * 1024, gb = mb * 1024;
        if (bytes >= gb) return $"{(bytes / (double)gb):F2} ГБ";
        if (bytes >= mb) return $"{(bytes / (double)mb):F2} МБ";
        if (bytes >= kb) return $"{(bytes / (double)kb):F2} КБ";
        return $"{bytes} Б";
    }

    private void OpenFile(string filePath)
    {
        if (string.IsNullOrEmpty(filePath))
        {
            Logger.LogWarning("Batch: путь к файлу пустой");
            return;
        }

        if (!File.Exists(filePath))
        {
            Logger.LogWarning($"Batch: файл не существует - {filePath}");
            _ = ShowNotification("⚠️ Файл не найден", NotificationType.Warning);

            // Fallback — открываем папку вывода
            if (!string.IsNullOrEmpty(OutputPath) && Directory.Exists(OutputPath))
            {
                try
                {
                    var psi = new System.Diagnostics.ProcessStartInfo
                    {
                        FileName = OutputPath,
                        UseShellExecute = true
                    };
                    System.Diagnostics.Process.Start(psi);
                }
                catch { }
            }
            return;
        }

        try
        {
            // Нормализуем путь (заменяем / на \)
            var normalizedPath = Path.GetFullPath(filePath).Replace('/', '\\');
            var arguments = "/select,\"" + normalizedPath + "\"";

            Logger.LogInfo($"Batch: открываем папку с выделением файла: {normalizedPath}");
            Logger.LogInfo($"Batch: аргументы explorer: {arguments}");

            // ИСПРАВЛЕНО: UseShellExecute = true — иначе аргументы игнорируются в MAUI WebView2
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = arguments,
                UseShellExecute = true   // ← ИСПРАВЛЕНО! Было false
            };

            System.Diagnostics.Process.Start(psi);
            Logger.LogInfo($"Batch: команда выполнена");
        }
        catch (Exception ex)
        {
            Logger.LogError($"Batch: ошибка открытия папки с файлом {filePath}", ex);

            // Fallback — просто открываем папку
            try
            {
                var folder = Path.GetDirectoryName(filePath);
                if (!string.IsNullOrEmpty(folder))
                {
                    var psi = new System.Diagnostics.ProcessStartInfo
                    {
                        FileName = folder,
                        UseShellExecute = true
                    };
                    System.Diagnostics.Process.Start(psi);
                }
            }
            catch { }
        }
    }

    // ===== Уведомления =====
    private async Task ShowNotification(string message, NotificationType type)
    {
        var notification = new NotificationMessage { Message = message, Type = type };
        CurrentNotification = notification;
        await InvokeAsync(StateHasChanged);

        // Раньше здесь был await Task.Delay(5000): каждый вызов (в т.ч. итог пакетной конвертации)
        // задерживал вызывающий код на 5 секунд — и IsConverting/очистка temp срабатывали с опозданием.
        _ = HideNotificationLaterAsync(notification);
    }

    private async Task HideNotificationLaterAsync(NotificationMessage notification)
    {
        await Task.Delay(5000);
        if (ReferenceEquals(CurrentNotification, notification))
        {
            CurrentNotification = null;
            try { await InvokeAsync(StateHasChanged); } catch { }
        }
    }
