                PickerTitle = $"Выберите любой файл в папке с {BatchType switch { "audio" => "аудио", "image" => "изображениями", "video" => "видео" }}"
            };
            var result = await FilePicker.Default.PickAsync(options);
            if (result != null)
            {
                folder = Path.GetDirectoryName(result.FullPath);
            }
#endif

            if (string.IsNullOrEmpty(folder) || !Directory.Exists(folder))
            {
                await ShowNotification("⚠️ Папка не выбрана", NotificationType.Warning);
                return;
            }

            var extensions = BatchType switch
            {
                "audio" => AllowedExtensions["audio"],
                "image" => AllowedExtensions["image"],
                "video" => AllowedExtensions["video"],
                "mixed" => AllowedExtensions.Values.SelectMany(x => x).ToArray(),
                _ => Array.Empty<string>()
            };

            // ИСПРАВЛЕНО: используем TopDirectoryOnly по умолчанию
            var searchOption = IncludeSubfolders ? SearchOption.AllDirectories : SearchOption.TopDirectoryOnly;

            Logger.LogInfo($"Batch: поиск файлов в {folder} (подпапки: {IncludeSubfolders})");

            var files = new List<string>();
            await Task.Run(() =>
            {
                foreach (var ext in extensions)
                {
                    try
                    {
                        files.AddRange(Directory.EnumerateFiles(folder, $"*{ext}", searchOption));
                    }
                    catch { }
                }
            });

            Logger.LogInfo($"Batch: найдено {files.Count} файлов с нужными расширениями");

            var newFiles = files.Where(f => !_selectedFilesSet.Contains(Path.GetFileName(f))).ToList();

            if (newFiles.Any())
            {
                // Показываем индикатор
                IsLoadingFiles = true;
                LoadingProgress = 0;
                LoadingFilesProcessed = 0;
                LoadingFilesTotal = newFiles.Count;
                LoadingFilesRejected = 0;
                StateHasChanged();

                var addedCount = 0;
                var rejectionReasons = new List<string>();
                const int batchSize = 50;

                for (int i = 0; i < newFiles.Count; i++)
                {
                    var file = newFiles[i];
                    var ext = Path.GetExtension(file).ToLowerInvariant();

                    var allowedExtsForFolder = BatchType == "mixed"
                        ? AllowedExtensions.Values.SelectMany(x => x).ToArray()
                        : AllowedExtensions[BatchType];

                    if (!allowedExtsForFolder.Contains(ext))
                    {
                        rejectionReasons.Add($"{Path.GetFileName(file)}: формат {ext.ToUpper()} не поддерживается");
                        LoadingFilesRejected++;
                        LoadingFilesProcessed++;

                        if (i % batchSize == 0 || i == newFiles.Count - 1)
                        {
                            LoadingProgress = (int)((double)LoadingFilesProcessed / newFiles.Count * 100);
                            StateHasChanged();
                        }
                        continue;
                    }

                    if (file.Length > 240)
                    {
                        Logger.LogWarning($"Batch: пропущен файл со слишком длинным путём ({file.Length} символов): {file}");
                        rejectionReasons.Add($"{Path.GetFileName(file)}: путь слишком длинный");
                        LoadingFilesRejected++;
                        LoadingFilesProcessed++;
                        continue;
                    }

                    if (!ValidateFileContent(file, ext))
                    {
                        rejectionReasons.Add($"{Path.GetFileName(file)}: содержимое не соответствует формату {ext.ToUpper()}");
                        LoadingFilesRejected++;
                        LoadingFilesProcessed++;

                        if (i % batchSize == 0 || i == newFiles.Count - 1)
                        {
                            LoadingProgress = (int)((double)LoadingFilesProcessed / newFiles.Count * 100);
                            StateHasChanged();
                        }
                        continue;
                    }

                    SelectedFiles.Add(file);
                    _selectedFilesSet.Add(Path.GetFileName(file));
                    addedCount++;
                    LoadingFilesProcessed++;

                    if (i % batchSize == 0 || i == newFiles.Count - 1)
                    {
                        LoadingProgress = (int)((double)LoadingFilesProcessed / newFiles.Count * 100);
                        StateHasChanged();
                        await Task.Delay(1);
                    }
                }

                IsLoadingFiles = false;

                if (rejectionReasons.Any())
                {
                    await ShowRejectionToast(rejectionReasons);
                }

                if (addedCount > 0)
                {
                    await JSRuntime.InvokeVoidAsync("showToast",
                        $"✅ Добавлено {addedCount} файлов из папки", "success");
                }
                else if (rejectionReasons.Any())
                {
                    await JSRuntime.InvokeVoidAsync("showToast",
                        $"❌ Все файлы в папке отклонены!", "error");
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("showToast",
                        $"⚠️ Новые файлы не найдены", "info");
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showToast",
                    $"⚠️ Новые файлы не найдены в папке", "info");
            }
        }
        catch (Exception ex)
        {
            Logger?.LogError("Ошибка выбора папки", ex);
            await ShowNotification($"Ошибка: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsLoadingFiles = false;
            StateHasChanged();
        }
    }


