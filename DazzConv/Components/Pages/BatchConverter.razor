@page "/batch"
@using System.IO
@using System.Linq
@using ConverToDazz.Core.Services
@using DazzConv.Services
@using Microsoft.Maui.Storage
@using Microsoft.JSInterop
@inject ImageConverterService ImageService
@inject AudioConverterService AudioService
@inject FFmpegPathService FFmpegService
@inject IJSRuntime JSRuntime
@inject VideoConverterService VideoService
@inject LoggerService Logger
@inject HotkeyService Hotkeys

<div class="batch-container">
    <!-- Заголовок -->
    <div class="batch-header mb-4">
        <div class="d-flex align-items-center mb-3">
            <div class="icon-wrapper me-3">
                <i class="bi bi-layers-fill"></i>
            </div>
            <div>
                <h2 class="mb-1">Мульти конвертация</h2>
                <p class="mb-0 text-muted">Обработайте множество файлов одновременно</p>
            </div>
        </div>
    </div>


    <InputFile id="batchFileInput"
               OnChange="OnMultipleFilesSelected"
               multiple
               accept="@GetAcceptTypes()"
               style="position:fixed; top:-1000px; left:-1000px; width:1px; height:1px; opacity:0; pointer-events:none;" />

    <!-- Основная панель -->
    <div class="card modern-card mb-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <h5 class="mb-0"><i class="bi bi-folder2-open me-2"></i>Настройки</h5>
        </div>
        <div class="card-body px-4 pb-4">
            <!-- Тип файлов и папка вывода -->
            <div class="row mb-4">
                <div class="col-lg-6 mb-3 mb-lg-0">
                    <label class="form-label fw-semibold mb-2">
                        <i class="bi bi-filetype-@BatchType me-2"></i>Тип файлов
                    </label>
                    <select class="form-select form-select-lg" value="@BatchType" @onchange="OnBatchTypeChanged">
                        <option value="mixed">🌐 Смешанный (Аудио + Видео + Фото)</option>
                        <option value="audio">🎵 Аудио файлы</option>
                        <option value="image">🖼️ Изображения</option>
                        <option value="video">🎬 Видео файлы</option>
                    </select>
                </div>
                <div class="col-lg-6">
                    <label class="form-label fw-semibold mb-2">
                        <i class="bi bi-folder me-2"></i>Папка вывода
                    </label>
                    <div class="input-group input-group-lg">
                        <input type="text"
                               class="form-control @(!IsValidOutputPath && !string.IsNullOrWhiteSpace(OutputPath) ? "is-invalid" : "")"
                               @bind="OutputPath"
                               @bind:event="oninput"
                               placeholder="Введите путь к папке или нажмите 'Обзор'..." />
                        <button class="btn btn-outline-primary" @onclick="ChooseOutputFolder" title="Выбрать папку">
                            <i class="bi bi-folder2-open"></i> Обзор
                        </button>
                    </div>
                    @if (!IsValidOutputPath && !string.IsNullOrWhiteSpace(OutputPath))
                    {
                        <div class="invalid-feedback d-block">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Нельзя сохранять в системные папки!
                        </div>
                    }
                    else if (string.IsNullOrWhiteSpace(OutputPath))
                    {
                        <div class="form-text mt-2">
                            <i class="bi bi-info-circle me-1"></i>
                            По умолчанию: @GetDefaultOutputPath()
                        </div>
                    }
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12">
                    <div class="d-flex flex-wrap gap-3 align-items-center">
                        <button class="btn btn-primary btn-lg px-4" @onclick="TriggerFileInput" disabled="@IsLoadingFiles">
                            <i class="bi bi-plus-circle me-2"></i>Добавить файлы
                        </button>
                        <button class="btn btn-outline-primary btn-lg px-4" @onclick="SelectFolder" disabled="@IsLoadingFiles">
                            <i class="bi bi-folder-plus me-2"></i>Добавить папку
                        </button>
                        <div class="form-check ms-3">
                            <input class="form-check-input" type="checkbox" @bind="IncludeSubfolders" id="subfoldersCheck" />
                            <label class="form-check-label" for="subfoldersCheck">
                                Включая подпапки
                            </label>
                        </div>
                        @if (SelectedFiles.Any())
                        {
                            <button class="btn btn-outline-danger btn-lg px-4 ms-auto" @onclick="ClearFiles" disabled="@IsLoadingFiles">
                                <i class="bi bi-trash me-2"></i>Очистить все (@SelectedFiles.Count)
                            </button>
                        }
                    </div>

                    @* НОВОЕ: Индикатор загрузки файлов *@
                    @if (IsLoadingFiles)
                    {
                        <div class="alert alert-info mt-3 mb-0">
                            <div class="d-flex align-items-center">
                                <div class="spinner-border spinner-border-sm me-3" role="status">
                                    <span class="visually-hidden">Загрузка...</span>
                                </div>
                                <div class="flex-grow-1">
                                    <strong>Обработка файлов...</strong>
                                    <div class="progress mt-2" style="height: 8px;">
                                        <div class="progress-bar progress-bar-striped progress-bar-animated"
                                             role="progressbar"
                                             style="width: @LoadingProgress%">
                                        </div>
                                    </div>
                                    <small class="text-muted mt-1 d-block">
                                        Обработано @LoadingFilesProcessed из @LoadingFilesTotal
                                        @if (LoadingFilesRejected > 0)
                                        {
                                            <span class="text-warning ms-2">• Отклонено: @LoadingFilesRejected</span>
                                        }
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Список файлов -->
            @if (SelectedFiles.Any())
            {
                <div class="files-section mt-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="mb-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Выбрано файлов: <strong>@SelectedFiles.Count</strong>
                        </h6>
                        <span class="badge bg-primary-subtle text-primary">
                            @GetTotalSize()
                        </span>
                    </div>

                    <div class="files-list">
                        @foreach (var file in SelectedFiles.Take(_displayedFilesCount))
                        {
                            <div class="file-item">
                                <div class="file-icon">
                                    <i class="bi @GetFileIcon(file)"></i>
                                </div>
                                <div class="file-info flex-grow-1">
                                    <div class="file-name fw-medium">@Path.GetFileName(file)</div>
                                    <div class="file-meta text-muted small">
                                        @GetFileSize(file) • @(GetFileExtension(file).ToUpper())
                                    </div>
                                </div>
                                <button class="btn btn-sm btn-ghost-danger" @onclick="() => RemoveFile(file)" title="Удалить">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        }

                        @* Кнопки "Показать ещё" / "Свернуть" *@
                        @if (SelectedFiles.Count > _displayedFilesCount)
                        {
                            <div class="text-center py-3">
                                <button class="btn btn-sm btn-outline-primary px-4" @onclick="ShowMoreFiles">
                                    <i class="bi bi-chevron-down me-1"></i>
                                    Показать ещё 20 файлов
                                    <span class="badge bg-primary ms-2">осталось @(SelectedFiles.Count - _displayedFilesCount)</span>
                                </button>
                            </div>
                        }
                        else if (_displayedFilesCount > 10)
                        {
                            <div class="text-center py-3">
                                <button class="btn btn-sm btn-outline-secondary px-4" @onclick="ShowLessFiles">
                                    <i class="bi bi-chevron-up me-1"></i>
                                    Свернуть список
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state text-center py-5">
                    <div class="empty-icon mb-3">
                        <i class="bi bi-cloud-arrow-up"></i>
                    </div>
                    <h5 class="mb-2">Нет выбранных файлов</h5>
                    <p class="text-muted mb-4">Нажмите "Добавить файлы" или "Добавить папку"</p>
                    <button class="btn btn-primary btn-lg px-5" @onclick="TriggerFileInput">
                        <i class="bi bi-plus-circle me-2"></i>Выбрать файлы
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Настройки конвертации -->
    @if (SelectedFiles.Any())
    {
        <div class="card modern-card mb-4">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="mb-0"><i class="bi bi-sliders me-2"></i>Параметры конвертации</h5>
            </div>
            <div class="card-body px-4 pb-4">
                @if (BatchType == "mixed" || BatchType == "audio")
                {
                    <div class="mb-4 p-3 border rounded">
                        <h6 class="fw-bold mb-3 text-primary">🎵 Настройки Аудио</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold mb-2">Формат</label>
                                <select class="form-select" value="@AudioOutputFormat" @onchange="OnAudioFormatChanged">
                                    <optgroup label="🎵 Популярные">
                                        <option value="mp3">MP3 — универсальный</option>
                                        <option value="aac">AAC — лучше MP3</option>
                                        <option value="ogg">OGG Vorbis — открытый</option>
                                        <option value="opus">OPUS — современный</option>
                                        <option value="m4a">M4A — Apple</option>
                                        <option value="wma">WMA — Windows</option>
                                    </optgroup>
                                    <optgroup label="💎 Без потерь (Lossless)">
                                        <option value="flac">FLAC — универсальный lossless</option>
                                        <option value="wav">WAV — без сжатия</option>
                                        <option value="alac">ALAC — Apple Lossless</option>
                                        <option value="aiff">AIFF — Mac/Pro</option>
                                        <option value="ape">APE — Monkey's Audio</option>
                                        <option value="wv">WavPack — hybrid lossless</option>
                                        <option value="tta">TTA — True Audio</option>
                                    </optgroup>
                                    <optgroup label="🎬 Видеомонтаж">
                                        <option value="ac3">AC3 — Dolby Digital</option>
                                        <option value="caf">CAF — Core Audio</option>
                                    </optgroup>
                                    <optgroup label="🎙️ Голос / Вещание">
                                        <option value="amr">AMR — мобильная речь</option>
                                        <option value="spx">Speex — VoIP</option>
                                        <option value="mp2">MP2 — DAB радио</option>
                                    </optgroup>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                @if (AudioSupportsBitrate)
                                {
                                    @if (AudioOutputFormat == "ac3")
                                    {
                                        <label class="form-label fw-semibold mb-2">
                                            Битрейт: <span class="text-primary">@AudioBitrate</span> kbps
                                            <span class="badge bg-warning text-dark ms-2">AC3</span>
                                        </label>
                                        <select class="form-select" value="@AudioBitrate" @onchange="OnAudioBitrateChanged">
                                            <option value="32">32 kbps (минимальный)</option>
                                            <option value="40">40 kbps</option>
                                            <option value="48">48 kbps</option>
                                            <option value="56">56 kbps</option>
                                            <option value="64">64 kbps</option>
                                            <option value="80">80 kbps</option>
                                            <option value="96">96 kbps</option>
                                            <option value="112">112 kbps</option>
                                            <option value="128">128 kbps (стандарт)</option>
                                            <option value="160">160 kbps</option>
                                            <option value="192">192 kbps</option>
                                            <option value="224">224 kbps</option>
                                            <option value="256">256 kbps</option>
                                            <option value="320">320 kbps</option>
                                            <option value="384">384 kbps</option>
                                            <option value="448">448 kbps (DVD стандарт)</option>
                                            <option value="512">512 kbps</option>
                                            <option value="576">576 kbps</option>
                                            <option value="640">640 kbps (максимальный)</option>
                                        </select>
                                        <div class="form-text text-warning mt-1">
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                            AC3 поддерживает только определенные битрейты
                                        </div>
                                    }
                                    else
                                    {
                                        <label class="form-label fw-semibold mb-2">Битрейт: <span class="text-primary">@AudioBitrate</span> kbps</label>
                                        <input type="range" class="form-range" min="64" max="320" step="32" value="@AudioBitrate" @oninput="OnAudioBitrateChanged" />
                                        <div class="d-flex justify-content-between small text-muted">
                                            <span>64</span><span>128</span><span>192</span><span>256</span><span>320</span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="NormalizeAudio" id="normCheck" />
                            <label class="form-check-label" for="normCheck">Нормализовать громкость</label>
                        </div>
                    </div>
                }

                @if (BatchType == "mixed" || BatchType == "image")
                {
                    <div class="mb-4 p-3 border rounded">
                        <h6 class="fw-bold mb-3 text-success">🖼️ Настройки Изображений</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold mb-2">Формат</label>
                                <select class="form-select" value="@ImageOutputFormat" @onchange="OnImageFormatChanged">
                                    <optgroup label="🌐 Популярные">
                                        <option value="jpg">JPG — универсальный</option>
                                        <option value="png">PNG — без потерь, прозрачность</option>
                                        <option value="webp">WebP — Google, для веба</option>
                                        <option value="avif">AVIF — лучшее сжатие</option>
                                        <option value="gif">GIF — анимации, 256 цветов</option>
                                        <option value="heic">HEIC — Apple iPhone</option>
                                    </optgroup>
                                    <optgroup label="🎨 Дизайн / Печать">
                                        <option value="tiff">TIFF — полиграфия, CMYK</option>
                                        <option value="bmp">BMP — без сжатия, Windows</option>
                                        <option value="pnm">PNM — Unix, простой</option>
                                        <option value="psd">PSD — Photoshop</option>
                                    </optgroup>
                                    <optgroup label="🎮 Для игр">
                                        <option value="tga">TGA — Targa, ретро-игры</option>
                                        <option value="dds">DDS — DirectX текстуры</option>
                                        <option value="pcx">PCX — DOS-игры</option>
                                        <option value="sgi">SGI — Silicon Graphics</option>
                                    </optgroup>
                                    <optgroup label="🎬 Видео / VFX">
                                        <option value="dpx">DPX — киносканеры</option>
                                        <option value="exr">OpenEXR — VFX, HDR</option>
                                        <option value="hdr">HDR — Radiance, HDRI</option>
                                        <option value="cin">CINEON — Kodak</option>
                                    </optgroup>
                                    <optgroup label="🔧 Спецформаты">
                                        <option value="ico">ICO — иконки Windows</option>
                                        <option value="jxl">JPEG XL — преемник JPEG</option>
                                        <option value="qoi">QOI — быстрый lossless</option>
                                        <option value="ff">Farbfeld — простой lossless</option>
                                    </optgroup>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                @if (ImageSupportsQuality)
                                {
                                    <label class="form-label fw-semibold mb-2">Качество: <span class="text-success">@ImageQuality</span>%</label>
                                    <input type="range" class="form-range" min="1" max="100" value="@ImageQuality" @oninput="OnImageQualityChanged" />
                                    <div class="d-flex justify-content-between small text-muted">
                                        <span>1%</span><span>50%</span><span>100%</span>
                                    </div>
                                }
                                else
                                {
                                    <label class="form-label fw-semibold mb-2">Качество</label>
                                    <div class="alert alert-info mb-0 py-2 small">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Для формата <strong>@ImageOutputFormat.ToUpper()</strong> качество не применяется (формат без потерь)
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" @bind="ResizeImages" id="resizeCheck" />
                            <label class="form-check-label" for="resizeCheck">Изменить размер</label>
                        </div>
                        @if (ResizeImages)
                        {
                            <div class="row mt-2">
                                <div class="col-6">
                                    <label class="form-label small">Ширина: @ImageWidth px</label>
                                    <input type="range" class="form-range" min="100" max="4096" step="100" value="@ImageWidth" @oninput="OnImageWidthChanged" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Высота: @ImageHeight px</label>
                                    <input type="range" class="form-range" min="100" max="4096" step="100" value="@ImageHeight" @oninput="OnImageHeightChanged" />
                                </div>
                            </div>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" @bind="KeepAspectRatio" id="aspectCheck" />
                                <label class="form-check-label" for="aspectCheck">Сохранить пропорции</label>
                            </div>
                            @if (ImageOutputFormat == "ico")
                            {
                                <div class="alert alert-warning mt-2 mb-0 py-2 small">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    Для ICO размер ограничен 256×256 пикселей
                                </div>
                            }
                        }
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" @bind="OptimizeImages" id="optCheck" />
                            <label class="form-check-label" for="optCheck">Оптимизировать размер (удалить метаданные)</label>
                        </div>
                    </div>
                }

                @if (BatchType == "mixed" || BatchType == "video")
                {
                    <div class="mb-4 p-3 border rounded">
                        <h6 class="fw-bold mb-3 text-danger">🎬 Настройки Видео</h6>
                        <div class="alert alert-warning mb-3 py-2">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Внимание!</strong> Конвертация видео может занять много времени.
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold mb-2">Формат</label>
                                <select class="form-select" value="@VideoOutputFormat" @onchange="OnVideoFormatChanged">
                                    <optgroup label="🌐 Популярные">
                                        <option value="mp4">MP4 — универсальный, H.264/H.265</option>
                                        <option value="mkv">MKV — все кодеки, субтитры</option>
                                        <option value="avi">AVI — старая совместимость</option>
                                        <option value="mov">MOV — Apple QuickTime</option>
                                        <option value="wmv">WMV — Windows Media</option>
                                        <option value="flv">FLV — Flash Video</option>
                                        <option value="webm">WebM — веб, VP9/AV1</option>
                                    </optgroup>
                                    <optgroup label="📱 Мобильные / Apple">
                                        <option value="m4v">M4V — Apple iTunes/Video</option>
                                        <option value="3gp">3GP — мобильные устройства</option>
                                    </optgroup>
                                    <optgroup label="💿 DVD / Старые">
                                        <option value="mpeg">MPEG — MPEG-1/2, DVD</option>
                                        <option value="mpg">MPG — MPEG-1/2, DVD</option>
                                        <option value="vob">VOB — DVD Video Object</option>
                                    </optgroup>
                                    <optgroup label="📡 Streaming / TV">
                                        <option value="ts">TS — транспортный поток, TV</option>
                                        <option value="m2ts">M2TS — Blu-ray, AVCHD</option>
                                    </optgroup>
                                    <optgroup label="🔧 Другие">
                                        <option value="ogv">OGV — Ogg Theora, открытый</option>
                                        <option value="gif">GIF — анимация, 256 цветов</option>
                                        <option value="asf">ASF — Advanced Systems Format</option>
                                        <option value="rm">RM — RealMedia</option>
                                        <option value="divx">DivX — DivX видео</option>
                                        <option value="f4v">F4V — Flash Video (новый)</option>
                                    </optgroup>
                                </select>
                                @if (!IsVideoFormatVerified(VideoOutputFormat))
                                {
                                    <div class="alert alert-warning mt-2 mb-0 py-2 small">
                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                        @GetFormatWarning(VideoOutputFormat)
                                    </div>
                                }
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold mb-2">Видео кодек</label>
                                <select class="form-select" value="@VideoCodec" @onchange="OnVideoCodecChanged">
                                    <option value="libx264">H.264 (libx264) — универсальный</option>
                                    <option value="mpeg4">MPEG-4 — старая совместимость</option>
                                </select>
                            </div>
                        </div>

                        @if (VideoSupportsCrf)
                        {
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold mb-2">Качество (CRF): <span class="text-danger">@VideoCrf</span></label>
                                    <input type="range" class="form-range" min="0" max="51" value="@VideoCrf" @oninput="OnVideoCrfChanged" />
                                    <div class="form-text">0 = без потерь, 23 = стандарт, 51 = худшее</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold mb-2">Preset (скорость)</label>
                                    <select class="form-select" value="@VideoPreset" @onchange="OnVideoPresetChanged">
                                        <option value="ultrafast">Ultrafast (быстро)</option>
                                        <option value="superfast">Superfast</option>
                                        <option value="veryfast">Veryfast</option>
                                        <option value="faster">Faster</option>
                                        <option value="fast">Fast</option>
                                        <option value="medium">Medium (баланс)</option>
                                        <option value="slow">Slow (медленно)</option>
                                        <option value="slower">Slower</option>
                                        <option value="veryslow">Veryslow (лучшее качество)</option>
                                    </select>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold mb-2">QScale (качество): <span class="text-danger">@VideoQScale</span></label>
                                    <input type="range" class="form-range" min="1" max="31" value="@VideoQScale" @oninput="OnVideoQScaleChanged" />
                                    <div class="form-text">1 = лучшее, 31 = худшее</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold mb-2">Preset (скорость)</label>
                                    <select class="form-select" value="@VideoPreset" @onchange="OnVideoPresetChanged">
                                        <option value="ultrafast">Ultrafast</option>
                                        <option value="superfast">Superfast</option>
                                        <option value="veryfast">Veryfast</option>
                                        <option value="faster">Faster</option>
                                        <option value="fast">Fast</option>
                                        <option value="medium">Medium</option>
                                        <option value="slow">Slow</option>
                                    </select>
                                </div>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold mb-2">Разрешение</label>
                                <select class="form-select" value="@VideoResolution" @onchange="OnVideoResolutionChanged">
                                    <option value="">Оригинальное</option>
                                    <option value="2160p">4K (2160p)</option>
                                    <option value="1440p">2K (1440p)</option>
                                    <option value="1080p">Full HD (1080p)</option>
                                    <option value="720p">HD (720p)</option>
                                    <option value="480p">SD (480p)</option>
                                    <option value="360p">360p</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold mb-2">Аудио кодек</label>
                                <select class="form-select" value="@VideoAudioCodec" @onchange="OnVideoAudioCodecChanged">
                                    <option value="aac">AAC (рекомендуется)</option>
                                    <option value="libmp3lame">MP3</option>
                                    <option value="copy">Копировать (без перекодирования)</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold mb-2">Аудио битрейт: <span class="text-danger">@VideoAudioBitrate</span> kbps</label>
                                <input type="range" class="form-range" min="64" max="320" step="32" value="@VideoAudioBitrate" @oninput="OnVideoAudioBitrateChanged" />
                                <div class="d-flex justify-content-between small text-muted">
                                    <span>64</span><span>128</span><span>192</span><span>256</span><span>320</span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold mb-2">FPS</label>
                                <select class="form-select" value="@VideoFps" @onchange="OnVideoFpsChanged">
                                    <option value="">Оригинальный</option>
                                    <option value="24">24 fps (кино)</option>
                                    <option value="25">25 fps (PAL)</option>
                                    <option value="30">30 fps</option>
                                    <option value="60">60 fps</option>
                                </select>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Кнопка начала -->
        <div class="text-center mb-5">
            <button class="btn btn-success btn-xl px-5 py-3" @onclick="StartBatchConversion" disabled="@IsConverting">
                @if (IsConverting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <text>Конвертация...</text>
                }
                else
                {
                    <i class="bi bi-play-circle me-2"></i>
                    <text>Начать конвертацию (@SelectedFiles.Count файлов)</text>
                }
            </button>
            @if (IsConverting)
            {
                <button class="btn btn-outline-danger btn-xl px-5 py-3 ms-3" @onclick="CancelBatchConversion">
                    <i class="bi bi-x-circle me-2"></i>Отмена
                </button>
            }
        </div>

        <!-- Прогресс -->
        @if (IsConverting || BatchProgress > 0)
        {
            <div class="card modern-card mb-4 border-primary">
                <div class="card-header bg-primary text-white pt-4 px-4">
                    <h5 class="mb-0"><i class="bi bi-arrow-repeat me-2"></i>Прогресс конвертации</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <strong>Общий прогресс:</strong>
                            <span class="text-primary">@BatchProgress% (файл @CurrentFileIndex из @SelectedFiles.Count)</span>
                        </div>
                        <div class="progress" style="height: 30px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                                 role="progressbar" style="width: @BatchProgress%">
                                <strong>@BatchProgress%</strong>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <strong>Текущий файл:</strong>
                            <span>@CurrentFileProgress%</span>
                        </div>
                        <div class="small text-muted mb-1 text-truncate" title="@CurrentFileName">@CurrentFileName</div>
                        <div class="progress" style="height: 15px;">
                            <div class="progress-bar bg-info" role="progressbar" style="width: @CurrentFileProgress%">
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(ConversionStatus))
                    {
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle me-2"></i>@ConversionStatus
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Результаты -->
        @if (ConversionResults.Any())
        {
            <div class="card modern-card">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-clipboard-check me-2"></i>Результаты</h5>
                        <span class="badge @(ConversionResults.All(r => r.Success) ? "bg-success" : "bg-warning") text-white px-3 py-2">
                            Успешно: @ConversionResults.Count(r => r.Success) / @ConversionResults.Count
                        </span>
                    </div>
                </div>
                <div class="card-body px-4 pb-4">
                    <!-- Кнопки прокрутки -->
                    <div class="d-flex justify-content-end mb-2 gap-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ScrollResultsLeft" title="Прокрутить влево">
                            <i class="bi bi-arrow-left"></i> Влево
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ScrollResultsRight" title="Прокрутить вправо">
                            Вправо <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>

                    <div class="table-responsive" id="resultsTable" style="max-height: 600px; overflow-x: auto;">
                        <table class="table table-hover mb-0" style="min-width: 1200px;">
                            <thead class="table-light" style="position: sticky; top: 0; background: white; z-index: 10;">
                                <tr>
                                    <th style="width: 60px; min-width: 60px;">#</th>
                                    <th style="min-width: 300px; max-width: 400px;">Файл</th>
                                    <th style="width: 120px; min-width: 120px;">Статус</th>
                                    <th style="min-width: 200px; max-width: 300px;">Сообщение</th>
                                    <th style="width: 100px; min-width: 100px;">Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < ConversionResults.Count; i++)
                                {
                                    var result = ConversionResults[i];
                                    <tr class="@(result.Success ? "" : "table-danger")">
                                        <td style="vertical-align: middle;">@(i + 1)</td>
                                        <td style="vertical-align: middle;">
                                            <div class="d-flex align-items-center" style="max-width: 400px;">
                                                <i class="bi @GetFileIcon(result.FilePath) me-2 fs-5" style="flex-shrink: 0;"></i>
                                                <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                    <div class="fw-medium" title="@Path.GetFileName(result.FilePath)">
                                                        @Path.GetFileName(result.FilePath)
                                                    </div>
                                                    <small class="text-muted">@FormatFileSize(new FileInfo(result.FilePath).Length)</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="vertical-align: middle;">
                                            @if (result.Success)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>Успешно
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-x-circle me-1"></i>Ошибка
                                                </span>
                                            }
                                        </td>
                                        <td style="vertical-align: middle;">
                                            <small class="text-muted" style="overflow: hidden; text-overflow: ellipsis; display: block; max-width: 300px;" title="@result.Message">
                                                @result.Message
                                            </small>
                                        </td>
                                        <td style="vertical-align: middle;">
                                            @if (result.Success && !string.IsNullOrEmpty(result.OutputPath) && File.Exists(result.OutputPath))
                                            {
                                                <button class="btn btn-sm btn-outline-success" @onclick="() => OpenFile(result.OutputPath)" title="Открыть папку с файлом">
                                                    <i class="bi bi-folder2-open"></i>
                                                </button>
                                            }
                                            else if (!string.IsNullOrEmpty(result.OutputPath))
                                            {
                                                <button class="btn btn-sm btn-outline-warning" @onclick="() => OpenFolder(result.OutputPath)" title="Открыть папку (файл не найден)">
                                                    <i class="bi bi-folder"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

