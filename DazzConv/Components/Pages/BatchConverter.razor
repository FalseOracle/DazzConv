            {
                if (Cts?.IsCancellationRequested ?? true) return;
                CurrentFileProgress = Math.Max(0, Math.Min(100, p));
                try { InvokeAsync(StateHasChanged); } catch { }
            }),
            token: Cts!.Token);

        if (!(Cts?.IsCancellationRequested ?? false))
            CleanupTempFile(inputFile);
    }

    private int GetValidAc3Bitrate(int requestedBitrate)
    {
        int[] validBitrates = { 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 384, 448, 512, 576, 640 };
        return validBitrates.OrderBy(b => Math.Abs(b - requestedBitrate)).First();
    }

    private string GetAudioCodecForFormat(string format) => format.ToLower() switch
    {
        "mp3" => "libmp3lame",
        "mp2" => "mp2",
        "aac" or "m4a" => "aac",
        "ogg" => "libvorbis",
        "opus" => "libopus",
        "wma" => "wmav2",
        "ac3" => "ac3",
        "flac" => "flac",
        "wav" => "pcm_s16le",
        "aiff" => "pcm_s16be",
        "alac" => "alac",
        "ape" => "ape",
        "wv" => "wavpack",
        "tta" => "tta",
        "caf" => "pcm_s16le",
        _ => "libmp3lame"
    };


    private void CleanupTempFile(string filePath)
    {
        try
        {
            if (string.IsNullOrEmpty(filePath)) return;
            if (!File.Exists(filePath)) return;

            // 🛡️ ЗАЩИТА: НЕ удаляем если файл в OutputPath
            try
            {
                var normalizedFile = Path.GetFullPath(filePath);
                var normalizedOutput = Path.GetFullPath(OutputPath);

                if (normalizedFile.StartsWith(normalizedOutput, StringComparison.OrdinalIgnoreCase))
                {
                    Logger.LogWarning($"Batch: пропущено удаление — файл в OutputPath: {Path.GetFileName(filePath)}");
                    return;
                }
            }
            catch { }

            if (filePath.Contains("DazzConv_Batch"))
            {
                File.Delete(filePath);
                Logger.LogInfo($"Batch: удалён временный файл {Path.GetFileName(filePath)}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning($"Batch: не удалось удалить temp файл: {ex.Message}");
        }
    }

    private void CleanupAllTempFiles()
    {
        try
        {
            var tempFolder = Path.Combine(Path.GetTempPath(), "DazzConv_Batch");

            if (!Directory.Exists(tempFolder)) return;

            // 🛡️ ЗАЩИТА: НЕ чистим если OutputPath совпадает с temp папкой
            try
            {
                var normalizedTemp = Path.GetFullPath(tempFolder);
                var normalizedOutput = Path.GetFullPath(OutputPath);

                if (normalizedTemp.Equals(normalizedOutput, StringComparison.OrdinalIgnoreCase) ||
                    normalizedOutput.StartsWith(normalizedTemp + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
                {
                    Logger.LogWarning("Batch: пропущена очистка — OutputPath находится внутри temp папки!");
                    return;
                }
            }
            catch { }

            var files = Directory.GetFiles(tempFolder);
            var deletedCount = 0;

            foreach (var file in files)
            {
                try
                {
                    File.Delete(file);
                    deletedCount++;
                }
                catch (Exception ex)
                {
                    Logger.LogWarning($"Batch: не удалось удалить {Path.GetFileName(file)}: {ex.Message}");
                }
            }

            if (deletedCount > 0)
            {
                Logger.LogInfo($"Batch: массовая очистка - удалено {deletedCount} временных файлов");
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning($"Batch: ошибка массовой очистки: {ex.Message}");
        }
    }


    private void CancelBatchConversion()
    {
        try
        {
            if (Cts != null && !Cts.IsCancellationRequested)
            {
                Cts.Cancel();
                ConversionStatus = "⚠️ Отмена...";
                Logger.LogInfo("Batch: запрошена отмена конвертации");
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError("Batch: ошибка отмены", ex);
        }
    }

