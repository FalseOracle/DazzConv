    private async Task OnMultipleFilesSelected(InputFileChangeEventArgs e)
    {
        try
        {
            Logger.LogInfo($"=== Начало обработки файлов ===");
            Logger.LogInfo($"BatchType: {BatchType}");

            var files = e.GetMultipleFiles(10000);
            var totalFiles = files.Count;

            Logger.LogInfo($"Получено файлов: {totalFiles}");

            // Показываем индикатор загрузки
            IsLoadingFiles = true;
            LoadingProgress = 0;
            LoadingFilesProcessed = 0;
            LoadingFilesTotal = totalFiles;
            LoadingFilesRejected = 0;
            StateHasChanged();

            var addedCount = 0;
            var rejectedCount = 0;
            var rejectionReasons = new List<string>();

            var allowedExts = BatchType == "mixed"
                ? AllowedExtensions.Values.SelectMany(x => x).ToArray()
                : AllowedExtensions[BatchType];

            var tempFolder = Path.Combine(Path.GetTempPath(), "DazzConv_Batch");
            Directory.CreateDirectory(tempFolder);

            // Обрабатываем файлы порциями по 50 штук для обновления UI
            const int batchSize = 50;
            for (int i = 0; i < totalFiles; i++)
            {
                var file = files[i];
                var fileName = file.Name;
                var ext = Path.GetExtension(fileName).ToLowerInvariant();

                // ПРОВЕРКА 1: Расширение
                if (string.IsNullOrEmpty(ext) || !allowedExts.Contains(ext))
                {
                    if (!string.IsNullOrEmpty(ext))
                    {
                        rejectionReasons.Add($"{fileName}: формат {ext.ToUpper()} не поддерживается");
                    }
                    else
                    {
                        rejectionReasons.Add($"{fileName}: нет расширения");
                    }
                    rejectedCount++;
                    LoadingFilesProcessed++;
                    LoadingFilesRejected++;

                    // Обновляем UI каждые batchSize файлов
                    if (i % batchSize == 0 || i == totalFiles - 1)
                    {
                        LoadingProgress = (int)((double)LoadingFilesProcessed / totalFiles * 100);
                        StateHasChanged();
                    }
                    continue;
                }

                // ПРОВЕРКА 2: Имя файла
                var safeName = SanitizeFileName(fileName);
                if (string.IsNullOrEmpty(safeName))
                {
                    rejectionReasons.Add($"{fileName}: недопустимое имя файла");
                    rejectedCount++;
                    LoadingFilesProcessed++;
                    LoadingFilesRejected++;
                    continue;
                }

                // ПРОВЕРКА 3: Дубликаты
                if (_selectedFilesSet.Contains(safeName))
                {
                    rejectionReasons.Add($"{fileName}: файл уже добавлен");
                    rejectedCount++;
                    LoadingFilesProcessed++;
                    LoadingFilesRejected++;
                    continue;
                }

                var destPath = Path.Combine(tempFolder, safeName);
                var counter = 1;
                while (File.Exists(destPath))
                {
                    var nameWithoutExt = Path.GetFileNameWithoutExtension(safeName);
                    destPath = Path.Combine(tempFolder, $"{nameWithoutExt}_{counter}{ext}");
                    counter++;
                }

                try
                {
                    using var readStream = file.OpenReadStream(maxAllowedSize: 2L * 1024 * 1024 * 1024);
                    using var writeStream = File.Create(destPath);
                    await readStream.CopyToAsync(writeStream);

                    // ПРОВЕРКА 4: Magic numbers
                    if (!ValidateFileContent(destPath, ext))
                    {
                        File.Delete(destPath);
                        rejectionReasons.Add($"{fileName}: содержимое не соответствует формату {ext.ToUpper()}");
                        rejectedCount++;
                        LoadingFilesProcessed++;
                        LoadingFilesRejected++;
                        continue;
                    }

                    SelectedFiles.Add(destPath);
                    _selectedFilesSet.Add(safeName);
                    addedCount++;
                    LoadingFilesProcessed++;
                }
                catch (Exception ex)
                {
                    Logger.LogError($"Ошибка копирования {safeName}", ex);
                    try { if (File.Exists(destPath)) File.Delete(destPath); } catch { }
                    rejectionReasons.Add($"{fileName}: ошибка чтения файла");
                    rejectedCount++;
                    LoadingFilesProcessed++;
                    LoadingFilesRejected++;
                }

                // Обновляем UI каждые batchSize файлов
                if (i % batchSize == 0 || i == totalFiles - 1)
                {
                    LoadingProgress = (int)((double)LoadingFilesProcessed / totalFiles * 100);
                    StateHasChanged();
                    // Даём UI время отрисоваться
                    await Task.Delay(1);
                }
            }

            Logger.LogInfo($"=== ИТОГО ===");
            Logger.LogInfo($"Добавлено: {addedCount}, Отклонено: {rejectedCount}");

            // Показываем toast с причинами отклонения
            if (rejectionReasons.Any())
            {
                await ShowRejectionToast(rejectionReasons);
            }

            // Показываем toast об успехе
            if (addedCount > 0)
            {
                await JSRuntime.InvokeVoidAsync("showToast",
                    $"✅ Добавлено файлов: {addedCount}", "success");
            }
            else if (rejectedCount > 0)
            {
                await JSRuntime.InvokeVoidAsync("showToast",
                    $"❌ Все файлы отклонены! Проверьте лог для деталей", "error");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError("Критическая ошибка добавления файлов", ex);
            await ShowNotification($"Ошибка: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsLoadingFiles = false;
            StateHasChanged();
        }
    }

    // Проверка содержимого файла по magic numbers (теперь синхронная, работает с файлом на диске)
    private bool ValidateFileContent(string filePath, string extension)
    {
        try
        {
            var fileInfo = new FileInfo(filePath);
            if (fileInfo.Length < 4) return false;

            var buffer = new byte[16];
            using var fs = File.OpenRead(filePath);
            fs.Read(buffer, 0, Math.Min(16, (int)fileInfo.Length));

            var isValid = extension.ToLower() switch
            {
                // ===== АУДИО =====
                ".mp3" => (buffer[0] == 0xFF && (buffer[1] & 0xE0) == 0xE0) ||
                          (buffer[0] == 0x49 && buffer[1] == 0x44 && buffer[2] == 0x33),
                ".wav" => buffer[0] == 0x52 && buffer[1] == 0x49 &&
                          buffer[2] == 0x46 && buffer[3] == 0x46,
                ".flac" => buffer[0] == 0x66 && buffer[1] == 0x4C &&
                           buffer[2] == 0x61 && buffer[3] == 0x43,
                ".ogg" => buffer[0] == 0x4F && buffer[1] == 0x67 &&
                          buffer[2] == 0x67 && buffer[3] == 0x53,
                ".aac" or ".wma" or ".opus" or ".ac3" or ".amr" or ".spx" or ".mp2" => true,
                ".m4a" or ".alac" => CheckFtypBox(buffer),
                ".aiff" => buffer[0] == 0x46 && buffer[1] == 0x4F &&
                           buffer[2] == 0x52 && buffer[3] == 0x4D,
                ".ape" => buffer[0] == 0x4D && buffer[1] == 0x41 &&
                          buffer[2] == 0x43 && buffer[3] == 0x20,
                ".wv" => buffer[0] == 0x77 && buffer[1] == 0x76 &&
                         buffer[2] == 0x70 && buffer[3] == 0x6B,
                ".tta" => buffer[0] == 0x54 && buffer[1] == 0x54 &&
                          buffer[2] == 0x41 && buffer[3] == 0x31,
                ".caf" => buffer[0] == 0x63 && buffer[1] == 0x61 &&
                          buffer[2] == 0x66 && buffer[3] == 0x66,

                // ===== ИЗОБРАЖЕНИЯ =====
                ".jpg" or ".jpeg" => buffer[0] == 0xFF && buffer[1] == 0xD8 && buffer[2] == 0xFF,
                ".png" => buffer[0] == 0x89 && buffer[1] == 0x50 &&
                          buffer[2] == 0x4E && buffer[3] == 0x47,
                ".gif" => buffer[0] == 0x47 && buffer[1] == 0x49 && buffer[2] == 0x46,
                ".bmp" => buffer[0] == 0x42 && buffer[1] == 0x4D,
                ".webp" => buffer.Length >= 12 && buffer[0] == 0x52 && buffer[1] == 0x49 &&
                           buffer[2] == 0x46 && buffer[3] == 0x46 &&
                           buffer[8] == 0x57 && buffer[9] == 0x45 &&
                           buffer[10] == 0x42 && buffer[11] == 0x50,
                ".avif" or ".heic" or ".heif" => CheckFtypBox(buffer),
                ".tiff" or ".tif" => (buffer[0] == 0x49 && buffer[1] == 0x49) ||
                                     (buffer[0] == 0x4D && buffer[1] == 0x4D),
                ".ico" => buffer[0] == 0x00 && buffer[1] == 0x00 &&
                          buffer[2] == 0x01 && buffer[3] == 0x00,
                ".tga" => true,
                ".dds" => buffer[0] == 0x44 && buffer[1] == 0x44 &&
                          buffer[2] == 0x53 && buffer[3] == 0x20,
                ".pcx" => buffer[0] == 0x0A,
                ".exr" => buffer[0] == 0x76 && buffer[1] == 0x2F &&
                          buffer[2] == 0x31 && buffer[3] == 0x01,
                ".hdr" => buffer[0] == 0x23 && buffer[1] == 0x3F,
                ".dpx" => buffer[0] == 0x53 && buffer[1] == 0x44 &&
                          buffer[2] == 0x50 && buffer[3] == 0x58,
                ".jxl" => buffer[0] == 0xFF && buffer[1] == 0x0A,
                ".qoi" => buffer[0] == 0x71 && buffer[1] == 0x6F &&
                          buffer[2] == 0x69 && buffer[3] == 0x66,
                ".ff" => buffer[0] == 0x66 && buffer[1] == 0x61 &&
                         buffer[2] == 0x72 && buffer[3] == 0x62,
                ".psd" => buffer[0] == 0x38 && buffer[1] == 0x42 &&
                          buffer[2] == 0x50 && buffer[3] == 0x53,
                ".pnm" or ".pbm" or ".pgm" or ".ppm" =>
                    buffer[0] == 0x50 && buffer[1] >= 0x31 && buffer[1] <= 0x36,
                ".sgi" or ".rgb" => buffer[0] == 0x01 && buffer[1] == 0xDA,
                ".cin" => buffer[0] == 0x80 && buffer[1] == 0x2A &&
                          buffer[2] == 0x5F && buffer[3] == 0xD7,

                // ===== ВИДЕО =====
                ".mp4" or ".mov" or ".m4v" or ".3gp" => CheckFtypBox(buffer),
                ".avi" => buffer[0] == 0x52 && buffer[1] == 0x49 &&
                          buffer[2] == 0x46 && buffer[3] == 0x46,
                ".mkv" or ".webm" => buffer[0] == 0x1A && buffer[1] == 0x45 &&
                                     buffer[2] == 0xDF && buffer[3] == 0xA3,
                ".wmv" => buffer[0] == 0x30 && buffer[1] == 0x26 &&
                          buffer[2] == 0xB2 && buffer[3] == 0x75,
                ".flv" => buffer[0] == 0x46 && buffer[1] == 0x4C && buffer[2] == 0x56,
                ".mpeg" or ".mpg" or ".vob" => buffer[0] == 0x00 && buffer[1] == 0x00 &&
                                              buffer[2] == 0x01 && (buffer[3] == 0xBA || buffer[3] == 0xB3),

                // ===== ЗАПРЕЩЁННЫЕ =====
                ".exe" or ".dll" or ".bat" or ".cmd" or ".scr" or
                ".com" or ".pif" or ".vbs" or ".js" or ".msi" => false,

                _ => true
            };

            if (!isValid)
            {
                Logger.LogWarning($"Magic numbers не совпали для {Path.GetFileName(filePath)} (расширение: {extension})");
            }

            return isValid;
        }
        catch (Exception ex)
        {
            Logger.LogError($"Ошибка проверки magic numbers: {filePath}", ex);
            return true;
        }
    }

    // Проверка ftyp box для MP4/MOV/AVIF/M4A
    private bool CheckFtypBox(byte[] buffer)
    {
        // ftyp box может быть на позиции 4 или 8
        if (buffer.Length >= 8 && buffer[4] == 0x66 && buffer[5] == 0x74 &&
            buffer[6] == 0x79 && buffer[7] == 0x70)
            return true;

        if (buffer.Length >= 12 && buffer[8] == 0x66 && buffer[9] == 0x74 &&
            buffer[10] == 0x79 && buffer[11] == 0x70)
            return true;

        return false;
    }

    private async Task ShowRejectionToast(List<string> reasons, string title = "⚠️ Некоторые файлы отклонены")
    {
        if (!reasons.Any()) return;

        var message = title + "\n\n";

        // Показываем максимум 5 причин, чтобы toast не был слишком длинным
        var shownReasons = reasons.Take(5).ToList();
        foreach (var reason in shownReasons)
        {
            message += $"• {reason}\n";
        }

        if (reasons.Count > 5)
        {
            message += $"\n...и ещё {reasons.Count - 5} файлов";
        }

        // Используем JS toast напрямую (не через ShowNotification)
        try
        {
            await JSRuntime.InvokeVoidAsync("showToast", message, "warning");
        }
        catch
        {
            // Fallback на обычное уведомление
            await ShowNotification(message, NotificationType.Warning);
        }
    }

    private string SanitizeFileName(string fileName)
    {
        fileName = Path.GetFileName(fileName);

        foreach (var c in Path.GetInvalidFileNameChars())
        {
            fileName = fileName.Replace(c, '_');
        }

        while (true)
        {
            var ext = Path.GetExtension(fileName);
            if (string.IsNullOrEmpty(ext)) break;

            var withoutExt = Path.GetFileNameWithoutExtension(fileName);
            var innerExt = Path.GetExtension(withoutExt);

            if (!string.IsNullOrEmpty(innerExt) && innerExt.Length >= 3 && innerExt.Length <= 5)
            {
                var innerExtClean = innerExt.TrimStart('.').ToLower();
                if (InputFormats.KindOf(innerExtClean) != null)
                {
                    fileName = withoutExt;
                    continue;
                }
            }
            break;
        }

        // Ограничиваем длину
        if (fileName.Length > 100)
        {
            var ext = Path.GetExtension(fileName);
            var nameWithoutExt = Path.GetFileNameWithoutExtension(fileName);
            fileName = nameWithoutExt.Substring(0, 100 - ext.Length) + ext;
        }

        return fileName.Trim();
    }


