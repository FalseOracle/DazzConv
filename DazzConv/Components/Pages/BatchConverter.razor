    private void OnAudioBitrateChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) AudioBitrate = v; }
    private void OnImageFormatChanged(ChangeEventArgs e) { ImageOutputFormat = e.Value?.ToString() ?? "png"; StateHasChanged(); }
    private void OnImageQualityChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) ImageQuality = v; }
    private void OnImageWidthChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) ImageWidth = v; }
    private void OnImageHeightChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) ImageHeight = v; }
    private void OnVideoFormatChanged(ChangeEventArgs e) { VideoOutputFormat = e.Value?.ToString() ?? "mp4"; StateHasChanged(); }
    private void OnVideoCodecChanged(ChangeEventArgs e)
    {
        VideoCodec = e.Value?.ToString() ?? "libx264";
        // Для MPEG-4 сбрасываем preset в medium
        if (VideoCodec == "mpeg4") VideoPreset = "medium";
        StateHasChanged();
    }
    private void OnVideoCrfChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) VideoCrf = Math.Max(0, Math.Min(51, v)); }
    private void OnVideoQScaleChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) VideoQScale = Math.Max(1, Math.Min(31, v)); }
    private void OnVideoPresetChanged(ChangeEventArgs e) { VideoPreset = e.Value?.ToString() ?? "medium"; }
    private void OnVideoResolutionChanged(ChangeEventArgs e) { VideoResolution = e.Value?.ToString() ?? ""; }
    private void OnVideoAudioBitrateChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) VideoAudioBitrate = v; }
    private void OnVideoAudioCodecChanged(ChangeEventArgs e) { VideoAudioCodec = e.Value?.ToString() ?? "aac"; }
